<style>
  @import "../../common/theme.css";

  .body {
    width: 100%;
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
  }
</style>

<script>
  import router from '@system.router';
  import device from '@system.device';

  export default {
    private: {
      listW: 320
    },

    onInit() {
      device.getInfo({
        success: (ret) => {
          const w = ret && ret.screenWidth;
          if (typeof w === 'number' && w > 0) this.listW = w - 24;
        },
        fail: () => {
          this.listW = 320;
        }
      });
    },

    goBack() {
      router.back();
    }
  };
</script>