<template>
  <div class="page">
    <div class="header">
      <div class="back" onclick="goBack">
        <text class="back-text">&lt;</text>
      </div>
      <text class="header-title">谁是卧底</text>
    </div>

    <!-- ① 设置人数 -->
    <div class="screen" if="{{ phase === 'setup' }}">
      <text class="step">4 ~ 8 人 · 同一块表传阅查看</text>
      <div class="countbox" style="width: {{ listW }}px;">
        <div class="cbtn" onclick="minus">
          <text class="ctext">－</text>
        </div>
        <text class="cnum">{{ playerCount }}</text>
        <div class="cbtn" onclick="plus">
          <text class="ctext">＋</text>
        </div>
      </div>
      <div class="list" style="width: {{ listW }}px;">
        <div class="card" onclick="startGame">
          <text class="card-text">开始发词</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="goRules">
          <text class="card-text">玩法说明</text>
          <text class="card-arrow">&gt;</text>
        </div>
      </div>
      <text class="hint">1 人拿到「卧底词」，其余人拿到「平民词」</text>
    </div>

    <!-- ② 依次传阅查看词语 -->
    <div class="screen" if="{{ phase === 'reveal' }}">
      <text class="step">{{ holderText }}</text>
      <text class="bigword" if="{{ revealed }}">{{ holderWord }}</text>
      <text class="cover" if="{{ revealed === false }}">词语已隐藏</text>
      <div class="list" style="width: {{ listW }}px;">
        <div class="card" onclick="peek" if="{{ revealed === false }}">
          <text class="card-text">点击查看我的词</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="nextHolder" if="{{ revealed }}">
          <text class="card-text">{{ nextLabel }}</text>
          <text class="card-arrow">&gt;</text>
        </div>
      </div>
      <text class="hint">看完交给下一位，别让人瞄到</text>
    </div>

    <!-- ③ 讨论 -->
    <div class="screen" if="{{ phase === 'discuss' }}">
      <text class="step">讨论开始 · 按顺序发言</text>
      <div class="doc-block" style="width: {{ listW }}px;">
        <text class="doc-text">发言顺序：{{ orderText }}</text>
      </div>
      <text class="answer" if="{{ showAnswer }}">{{ answerLine1 }}</text>
      <text class="answer-sm" if="{{ showAnswer }}">{{ answerLine2 }}</text>
      <div class="list" style="width: {{ listW }}px;">
        <div class="card" onclick="revealAnswer" if="{{ showAnswer === false }}">
          <text class="card-text">公布答案</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="startGame">
          <text class="card-text">重新发词</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="goBack">
          <text class="card-text">结束返回</text>
          <text class="card-arrow">&gt;</text>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  @import "../../common/theme.css";

  .screen {
    width: 100%;
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
  }

  .step {
    font-size: 19px;
    font-weight: bold;
    color: #ffffff;
    margin-top: 6px;
    margin-bottom: 8px;
  }

  .bigword {
    font-size: 46px;
    font-weight: bold;
    color: #ffffff;
    margin-top: 6px;
    margin-bottom: 12px;
  }

  .cover {
    font-size: 22px;
    font-weight: bold;
    color: #d8f5d8;
    margin-top: 10px;
    margin-bottom: 16px;
  }

  .countbox {
    height: 68px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(255, 255, 255, 0.94);
    border-radius: 14px;
    padding-left: 10px;
    padding-right: 10px;
    margin-bottom: 12px;
  }

  .cbtn {
    width: 64px;
    height: 52px;
    border-radius: 14px;
    background-color: #17331d;
    justify-content: center;
    align-items: center;
  }

  .ctext {
    font-size: 28px;
    font-weight: bold;
    color: #ffffff;
  }

  .cnum {
    font-size: 32px;
    font-weight: bold;
    color: #17331d;
  }

  .answer {
    font-size: 22px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .answer-sm {
    font-size: 15px;
    color: #eaffea;
    margin-bottom: 8px;
  }
</style>

<script>
  import router from '@system.router';
  import device from '@system.device';

  /** 词库：[平民词, 卧底词] */
  const PAIRS = [
    ['苹果', '梨'],
    ['牛奶', '豆浆'],
    ['可乐', '雪碧'],
    ['火锅', '麻辣烫'],
    ['蜘蛛侠', '蝙蝠侠'],
    ['包子', '饺子'],
    ['医生', '护士'],
    ['飞机', '火箭'],
    ['西瓜', '哈密瓜'],
    ['咖啡', '奶茶'],
    ['牙膏', '洗面奶'],
    ['程序员', '产品经理'],
    ['沙发', '床'],
    ['钢琴', '吉他'],
    ['地铁', '公交'],
    ['洗发水', '沐浴露'],
    ['蛋糕', '面包'],
    ['眼镜', '隐形眼镜'],
    ['微信', 'QQ'],
    ['篮球', '排球'],
    ['马拉松', '竞走'],
    ['口罩', '围巾'],
    ['外卖', '食堂'],
    ['班主任', '辅导员'],
    ['空调', '风扇'],
    ['麻将', '扑克'],
    ['雪人', '雪糕'],
    ['电饭煲', '电压力锅'],
    ['鼠标', '触控板'],
    ['粉笔', '马克笔']
  ];

  export default {
    private: {
      phase: 'setup', // setup | reveal | discuss
      playerCount: 6,
      listW: 320,

      pair: null,
      spyIndex: -1, // 0 基
      holder: 1, // 1 基
      holderText: '第 1 位玩家',
      holderWord: '',
      revealed: false,
      nextLabel: '下一位',

      order: [],
      orderText: '',

      showAnswer: false,
      answerLine1: '',
      answerLine2: ''
    },

    onInit() {
      device.getInfo({
        success: (ret) => {
          const w = ret && ret.screenWidth;
          if (typeof w === 'number' && w > 0) this.listW = w - 24;
        },
        fail: () => {
          this.listW = 320;
        }
      });
    },

    onBackPress() {
      // 发词 / 讨论进行中拦截系统右滑返回，防止误退
      return this.phase !== 'setup';
    },

    minus() {
      if (this.playerCount > 4) this.playerCount--;
    },

    plus() {
      if (this.playerCount < 8) this.playerCount++;
    },

    startGame() {
      const pick = PAIRS[Math.floor(Math.random() * PAIRS.length)];
      const count = this.playerCount;
      this.pair = pick;
      this.spyIndex = Math.floor(Math.random() * count);
      this.holder = 1;
      this.holderText = '第 1 位玩家';
      this.holderWord = '';
      this.revealed = false;
      this.nextLabel = count > 1 ? '下一位' : '开始讨论';
      this.showAnswer = false;

      const seq = [];
      for (let i = 1; i <= count; i++) seq.push(i);
      this.order = this.shuffle(seq);
      this.orderText = this.order.join(' → ');

      this.phase = 'reveal';
    },

    /** 查看当前持有者的词（只有点开这一瞬间才赋值，避免被旁人看到） */
    peek() {
      if (!this.pair) return;
      const isSpy = this.holder - 1 === this.spyIndex;
      this.holderWord = isSpy ? this.pair[1] : this.pair[0];
      this.revealed = true;
    },

    nextHolder() {
      if (this.holder >= this.playerCount) {
        this.phase = 'discuss';
        return;
      }
      this.holder++;
      this.holderText = '第 ' + this.holder + ' 位玩家';
      this.revealed = false;
      this.nextLabel = this.holder >= this.playerCount ? '开始讨论' : '下一位';
    },

    revealAnswer() {
      if (!this.pair) return;
      this.showAnswer = true;
      this.answerLine1 = '卧底是 ' + (this.spyIndex + 1) + ' 号';
      this.answerLine2 = '平民词「' + this.pair[0] + '」· 卧底词「' + this.pair[1] + '」';
    },

    goRules() {
      router.push({ uri: '/pages/rules' });
    },

    goBack() {
      router.back();
    },

    shuffle(arr) {
      const out = arr.slice();
      for (let i = out.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        const t = out[i];
        out[i] = out[j];
        out[j] = t;
      }
      return out;
    }
  };
</script>