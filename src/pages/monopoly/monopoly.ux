<template>
  <div class="page">
    <div class="header">
      <div class="back" onclick="onBack">
        <text class="back-text">&lt;</text>
      </div>
      <text class="header-title">大富翁</text>
    </div>

    <!-- 菜单 -->
    <div class="screen" if="{{ phase === 'menu' }}">
      <text class="step">选择人数（含你自己）</text>
      <div class="countbox" style="width: {{ listW }}px;">
        <div class="cbtn" onclick="minus">
          <text class="ctext">－</text>
        </div>
        <text class="cnum">{{ playerCount }} 人</text>
        <div class="cbtn" onclick="plus">
          <text class="ctext">＋</text>
        </div>
      </div>
      <div class="list" style="width: {{ listW }}px;">
        <div class="card" onclick="startAi">
          <text class="card-text">对战 AI（你 + {{ playerCount - 1 }} AI）</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="startHuman">
          <text class="card-text">同表多人（轮流操作）</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="goRules">
          <text class="card-text">玩法说明</text>
          <text class="card-arrow">&gt;</text>
        </div>
      </div>
      <text class="hint">掷骰走格 · 买地收租 · 升级翻倍租金</text>
      <text class="hint">破产出局，60 回合后比总资产</text>
    </div>

    <!-- 对局 -->
    <div class="screen" if="{{ phase === 'play' }}">
      <div class="boardwrap" style="width: {{ bs }}px; height: {{ bs }}px;">
        <div class="board" style="left: 0; top: 0; width: {{ bs }}px; height: {{ bs }}px;">
        <div
          class="cell {{ $item.cls }}"
          style="left: {{ $item.x }}px; top: {{ $item.y }}px; width: {{ cell }}px; height: {{ cell }}px;"
          for="{{ cells }}"
          tid="i"
        >
          <text class="celltext {{ $item.textCls }}">{{ $item.text }}</text>
        </div>
        <div
          class="token {{ $item.cls }}"
          style="left: {{ $item.x }}px; top: {{ $item.y }}px; width: {{ tk }}px; height: {{ tk }}px;"
          for="{{ tokens }}"
          tid="i"
        ></div>

        <!-- 中央信息卡 -->
        <div class="center" style="left: {{ cwx }}px; top: {{ cwy }}px; width: {{ cww }}px; height: {{ cwh }}px;">
          <text class="ctitle">{{ turnLine }}</text>
          <text class="cbig">{{ diceText }}</text>
          <text class="cevent">{{ eventLine }}</text>
          <text class="cmoney" for="{{ moneyList }}" tid="k">{{ $item.t }}</text>
        </div>
        </div>
      </div>

      <div class="ops">
        <div class="btn btn-main" onclick="roll" if="{{ step === 'roll' }}">
          <text class="bt bt-main">掷骰</text>
        </div>
        <div class="btn" onclick="doBuy" if="{{ step === 'buy' }}">
          <text class="bt">买地</text>
        </div>
        <div class="btn" onclick="skipBuy" if="{{ step === 'buy' }}">
          <text class="bt">不买</text>
        </div>
        <div class="btn" onclick="doUpgrade" if="{{ step === 'own' }}">
          <text class="bt">升级</text>
        </div>
        <div class="btn" onclick="nextTurn" if="{{ step === 'own' || step === 'done' || step === 'payed' }}">
          <text class="bt">结束回合</text>
        </div>
      </div>

      <text class="log">{{ logLine }}</text>

      <div class="overlay" if="{{ over }}">
        <text class="overtext">{{ overText }}</text>
        <div class="ops2">
          <div class="btn" onclick="restart">
            <text class="bt">再来一局</text>
          </div>
          <div class="btn" onclick="onBack">
            <text class="bt">返回</text>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  @import "../../common/theme.css";

  .screen {
    width: 100%;
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
  }

  .step {
    font-size: 17px;
    font-weight: bold;
    color: #ffffff;
    margin-top: 8px;
    margin-bottom: 10px;
  }

  .countbox {
    height: 60px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(255, 255, 255, 0.94);
    border-radius: 14px;
    padding-left: 10px;
    padding-right: 10px;
    margin-bottom: 12px;
  }

  .cbtn {
    width: 56px;
    height: 44px;
    border-radius: 12px;
    background-color: #17331d;
    justify-content: center;
    align-items: center;
  }

  .ctext {
    font-size: 24px;
    font-weight: bold;
    color: #ffffff;
  }

  .cnum {
    font-size: 26px;
    font-weight: bold;
    color: #17331d;
  }

  /* 棋盘：格子紧贴成环，中心为信息卡 */
  .boardwrap {
    position: relative;
    margin-top: 6px;
  }

  .board {
    position: absolute;
    background-color: #e9d3a6;
    border-radius: 12px;
  }

  .cell {
    position: absolute;
    border-radius: 5px;
    border-width: 1px;
    border-style: solid;
    border-color: rgba(138, 106, 58, 0.5);
    justify-content: center;
    align-items: center;
  }

  .celltext {
    font-size: 13px;
    font-weight: bold;
    color: #17331d;
  }

  .cell-start {
    background-color: #2f9e44;
  }
  .cell-prop {
    background-color: #fdf7ea;
  }
  .cell-chance {
    background-color: #f2c94c;
  }
  .cell-tax {
    background-color: #e56b5d;
  }
  .cell-text-start {
    color: #ffffff;
  }
  .cell-text-tax {
    color: #ffffff;
  }

  .token {
    position: absolute;
    border-radius: 50%;
    border-width: 2px;
    border-style: solid;
    border-color: #ffffff;
  }

  .token-0 {
    background-color: #d64545;
  }
  .token-1 {
    background-color: #2b6cb0;
  }
  .token-2 {
    background-color: #2f9e44;
  }
  .token-3 {
    background-color: #d9a520;
  }

  /* 中央信息卡 */
  .center {
    position: absolute;
    background-color: #f7efdd;
    border-radius: 10px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 6px;
  }

  .ctitle {
    font-size: 16px;
    font-weight: bold;
    color: #17331d;
    text-align: center;
    margin-bottom: 4px;
  }

  .cbig {
    font-size: 24px;
    font-weight: bold;
    color: #2b6cb0;
    text-align: center;
    margin-bottom: 4px;
  }

  .cevent {
    font-size: 14px;
    color: #2b3f31;
    text-align: center;
    margin-bottom: 4px;
  }

  .cmoney {
    font-size: 14px;
    font-weight: bold;
    color: #17331d;
    margin-bottom: 2px;
  }

  .ops {
    width: 100%;
    height: 64px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  .ops2 {
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .log {
    width: 100%;
    font-size: 14px;
    color: #eafffe;
    text-align: center;
  }
</style>

<script>
  import router from '@system.router';
  import device from '@system.device';
  import prompt from '@system.prompt';
  import {
    BOARD,
    CELL_COUNT,
    createGame,
    rollDice,
    move,
    settle,
    buyProp,
    upgradeProp,
    checkBankrupt,
    endTurn,
    aliveCount,
    roundWinner,
    ringPositions
  } from '../../common/monopoly';

  const HEADER_H = 52;
  const OPS_H = 46;
  const COLORS = ['token-0', 'token-1', 'token-2', 'token-3'];

  export default {
    private: {
      phase: 'menu',
      mode: 'ai', // ai | human
      playerCount: 3,
      listW: 320,

      game: null,
      step: 'roll',
      over: false,
      overText: '',

      bx: 8,
      by: 58,
      bs: 312,
      cell: 48,
      tk: 16,
      cwx: 60,
      cwy: 60,
      cww: 190,
      cwh: 190,
      opsY: 424,
      logY: 398,

      cells: [],
      tokens: [],
      moneyList: [],
      turnLine: '',
      diceText: '',
      eventLine: '',
      logLine: '',

      aiTimer: null
    },

    onInit() {
      device.getInfo({
        success: (ret) => {
          this.applyLayout((ret && ret.screenWidth) || 336, (ret && ret.screenHeight) || 480);
        },
        fail: () => {
          this.applyLayout(336, 480);
        }
      });
    },

    onHide() {
      this.clearAi();
    },

    onDestroy() {
      this.clearAi();
    },

    onBackPress() {
      return this.phase === 'play';
    },

    applyLayout(w, h) {
      const bs = Math.min(w - 16, 320);
      const bx = Math.floor((w - bs) / 2);
      const by = HEADER_H + 4;
      const sp = bs / 6; // 每边 6 格
      const cell = Math.floor(sp) - 2;
      const opsY = h - OPS_H - 10;

      this.bs = bs;
      this.bx = bx;
      this.by = by;
      this.cell = cell;
      this.tk = Math.max(10, Math.floor(cell / 3));
      this.opsY = opsY;
      this.logY = opsY - 24;
      // 中央信息卡
      this.cwx = Math.floor(sp) + 6;
      this.cwy = this.cwx;
      this.cww = bs - 2 * this.cwx;
      this.cwh = this.cww;
      this.listW = w - 24;
      if (this.game) this.renderBoard();
    },

    minus() {
      if (this.playerCount > 2) this.playerCount--;
    },

    plus() {
      if (this.playerCount < 4) this.playerCount++;
    },

    startAi() {
      this.mode = 'ai';
      this.startGame();
    },

    startHuman() {
      this.mode = 'human';
      this.startGame();
    },

    startGame() {
      this.clearAi();
      this.game = createGame(this.playerCount);
      this.over = false;
      this.step = 'roll';
      this.phase = 'play';
      this.diceText = '';
      this.renderBoard();
      this.refreshInfo('轮到 1 号掷骰');
      this.afterTurn();
    },

    restart() {
      this.startGame();
    },

    /* ---------------- 渲染 ---------------- */

    renderBoard() {
      const g = this.game;
      if (!g) return;
      const cell = this.cell;
      const inner = this.bs - cell;
      const pts = ringPositions(inner);
      const cells = [];
      for (let i = 0; i < CELL_COUNT; i++) {
        const c = BOARD[i];
        let text = String(c.price);
        if (c.t === 'chance') text = '机';
        if (c.t === 'tax') text = '税';
        if (c.t === 'start') text = '起';
        cells.push({
          i: i + 1,
          x: pts[i].x,
          y: pts[i].y,
          cls: 'cell-' + c.t,
          textCls: c.t === 'prop' ? '' : 'cell-text-' + c.t,
          text: text
        });
      }
      this.cells = cells;
      this.buildTokens();
    },

    buildTokens() {
      const g = this.game;
      if (!g) return;
      const cell = this.cell;
      const inner = this.bs - cell;
      const pts = ringPositions(inner);
      const count = g.players.length;
      const tokens = [];
      for (let p = 0; p < count; p++) {
        if (!g.players[p].alive) continue;
        const base = pts[g.players[p].pos];
        const off = (p - (count - 1) / 2) * Math.floor(cell / 4);
        tokens.push({
          i: p + 1,
          x: base.x + Math.floor(cell / 2) - Math.floor(this.tk / 2) + off,
          y: base.y + Math.floor(cell / 2) - Math.floor(this.tk / 2) + off,
          cls: COLORS[p % 4]
        });
      }
      this.tokens = tokens;
    },

    refreshInfo(event) {
      const g = this.game;
      if (!g) return;
      const p = g.players[g.current];
      const isAi = this.mode === 'ai' && g.current !== 0;
      this.turnLine = '轮到 ' + (g.current + 1) + '号' + (isAi ? '（AI）' : '') + ' · 第 ' + g.round + ' 回合';
      this.eventLine = event || '';
      this.logLine = g.log[g.log.length - 1] || '';
      const list = [];
      for (let i = 0; i < g.players.length; i++) {
        const q = g.players[i];
        list.push({
          k: i + 1,
          t: (i + 1) + '号 ¥' + Math.max(0, q.money) + (q.alive ? '' : ' 出局')
        });
      }
      this.moneyList = list;
      this.buildTokens();
      this.step = this.step || 'roll';
      this.renderHandless();
    },

    renderHandless() {
      // 触发视图更新（cells/tokens 已在上面赋值）
      this.cells = this.cells.slice();
    },

    /* ---------------- 人类回合 ---------------- */

    roll() {
      const g = this.game;
      if (!g || this.over) return;
      const d = rollDice();
      this.diceText = d.a + ' + ' + d.b;
      move(g, d.sum);
      const ev = settle(g);
      this.renderBoard();
      if (ev.type === 'buy') {
        this.step = 'buy';
        this.refreshInfo('要买下 ' + ev.name + ' 吗？¥' + ev.price + '（你 ¥' + g.players[0].money + '）');
        return;
      }
      if (ev.type === 'own') {
        const p = g.players[g.current];
        const e = p.props.find((q) => q.i === ev.cell);
        this.step = e && e.level < 2 ? 'own' : 'done';
        this.refreshInfo('你的地产（' + ev.name + '）' + (e && e.level < 2 ? ' · 可升级' : ' · 已满级'));
        return;
      }
      if (ev.type === 'rent') {
        this.step = 'payed';
        this.refreshInfo('付租 ¥' + ev.amount + ' 给 ' + (ev.owner + 1) + '号');
        return;
      }
      if (ev.type === 'tax') {
        this.step = 'payed';
        this.refreshInfo('缴税 ¥' + ev.amount);
        return;
      }
      if (ev.type === 'chance') {
        this.step = 'done';
        this.refreshInfo('机会：' + ev.card.text);
        return;
      }
      this.step = 'done';
      this.refreshInfo('落在 ' + (ev.name || ''));
    },

    doBuy() {
      const g = this.game;
      const ev = this.pendingCell;
      // 当前位置即待买格
      const pos = g.players[g.current].pos;
      if (g.players[g.current].money < BOARD[pos].price) {
        this.hint('买不起');
        return;
      }
      buyProp(g, pos);
      this.step = 'done';
      this.refreshInfo('买入 ' + BOARD[pos].name);
    },

    skipBuy() {
      this.step = 'done';
      this.refreshInfo('放弃购买');
    },

    doUpgrade() {
      const g = this.game;
      const pos = g.players[g.current].pos;
      const r = upgradeProp(g, pos);
      if (!r.ok) {
        this.hint(r.msg);
        return;
      }
      this.step = 'done';
      this.refreshInfo('升级成功，租金翻倍');
    },

    nextTurn() {
      const g = this.game;
      if (!g || this.over) return;
      checkBankrupt(g);
      const ac = aliveCount(g);
      if (ac.count <= 1) {
        this.finish('玩家 ' + (ac.last + 1) + ' 号获胜！');
        return;
      }
      endTurn(g);
      if (g.round > 60) {
        const rw = roundWinner(g);
        this.finish('60 回合到 · ' + (rw.player + 1) + ' 号总资产最高获胜！');
        return;
      }
      this.diceText = '';
      this.step = 'roll';
      this.renderBoard();
      this.refreshInfo('轮到 ' + (g.current + 1) + ' 号掷骰');
      this.afterTurn();
    },

    /* ---------------- AI 回合 ---------------- */

    afterTurn() {
      const g = this.game;
      if (!g || this.over) return;
      if (this.mode === 'ai' && g.current !== 0) this.scheduleAi();
    },

    scheduleAi() {
      this.clearAi();
      this.aiTimer = setTimeout(() => {
        this.aiTimer = null;
        const g = this.game;
        if (!g || this.over) return;
        if (this.mode !== 'ai' || g.current === 0) return;
        this.aiStep();
      }, 650);
    },

    aiStep() {
      const g = this.game;
      if (!g || this.over || g.current === 0) return;
      const pid = g.current;
      const d = rollDice();
      this.diceText = d.a + ' + ' + d.b;
      move(g, d.sum);
      const ev = settle(g);
      this.renderBoard();

      if (ev.type === 'buy') {
        const p = g.players[pid];
        if (p.money >= BOARD[ev.cell].price) {
          buyProp(g, ev.cell);
          this.refreshInfo((pid + 1) + '号(AI) 买入 ' + ev.name);
        } else {
          this.refreshInfo((pid + 1) + '号(AI) 放弃购买');
        }
      } else if (ev.type === 'own') {
        const p = g.players[pid];
        const e = p.props.find((q) => q.i === ev.cell);
        if (e && e.level < 2 && p.money >= BOARD[ev.cell].price * 3) {
          upgradeProp(g, ev.cell);
          this.refreshInfo((pid + 1) + '号(AI) 升级地产');
        } else {
          this.refreshInfo((pid + 1) + '号(AI) 回合结束');
        }
      } else if (ev.type === 'rent') {
        this.refreshInfo((pid + 1) + '号(AI) 付租 ¥' + ev.amount);
      } else if (ev.type === 'tax') {
        this.refreshInfo((pid + 1) + '号(AI) 缴税 ¥' + ev.amount);
      } else if (ev.type === 'chance') {
        this.refreshInfo((pid + 1) + '号(AI) 机会：' + ev.card.text);
      } else {
        this.refreshInfo((pid + 1) + '号(AI) 走格');
      }
      this.renderBoard();

      this.aiTimer = setTimeout(() => {
        this.aiTimer = null;
        const gg = this.game;
        if (!gg || this.over) return;
        checkBankrupt(gg);
        const ac = aliveCount(gg);
        if (ac.count <= 1) {
          this.finish('玩家 ' + (ac.last + 1) + ' 号获胜！');
          return;
        }
        endTurn(gg);
        if (gg.round > 60) {
          const rw = roundWinner(gg);
          this.finish('60 回合到 · ' + (rw.player + 1) + ' 号总资产最高获胜！');
          return;
        }
        this.diceText = '';
        this.step = 'roll';
        this.renderBoard();
        this.refreshInfo('轮到 ' + (gg.current + 1) + ' 号掷骰');
        this.afterTurn();
      }, 700);
    },

    clearAi() {
      if (this.aiTimer) {
        clearTimeout(this.aiTimer);
        this.aiTimer = null;
      }
    },

    finish(text) {
      this.over = true;
      this.overText = text;
      this.step = 'done';
      this.refreshInfo(text);
    },

    /* ---------------- 导航 ---------------- */

    onBack() {
      this.clearAi();
      if (this.phase === 'play') {
        this.phase = 'menu';
        this.over = false;
        return;
      }
      router.back();
    },

    goRules() {
      router.push({ uri: '/pages/rules' });
    },

    hint(msg) {
      prompt.showToast({ message: msg, duration: 1200 });
    }
  };
</script>