<template>
  <div class="page">
    <div class="header">
      <div class="back" onclick="onBack">
        <text class="back-text">&lt;</text>
      </div>
      <text class="header-title">大富翁</text>
    </div>

    <!-- 菜单 -->
    <div class="screen" if="{{ stage === 'menu' }}">
      <div class="grow"></div>
      <div class="list" style="width: {{ listW }}px;">
        <div class="card" onclick="toSetup">
          <text class="card-text">开始游戏</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="goRules">
          <text class="card-text">玩法说明</text>
          <text class="card-arrow">&gt;</text>
        </div>
      </div>
      <div class="grow"></div>
      <text class="hint">开局可设初始资金 / 真人 / 电脑 / 名字</text>
    </div>

    <!-- 开局设置 -->
    <div class="screen" if="{{ stage === 'setup' }}">
      <text class="info">开局设置</text>
      <div class="countbox" style="width: {{ listW }}px;">
        <div class="cbtn" onclick="moneyPrev">
          <text class="ctext">◀</text>
        </div>
        <text class="cnum">资金 ¥{{ money }}</text>
        <div class="cbtn" onclick="moneyNext">
          <text class="ctext">▶</text>
        </div>
      </div>
      <div class="countbox" style="width: {{ listW }}px;">
        <div class="cbtn" onclick="humanPrev">
          <text class="ctext">◀</text>
        </div>
        <text class="cnum">真人 {{ humans }} 人</text>
        <div class="cbtn" onclick="humanNext">
          <text class="ctext">▶</text>
        </div>
      </div>
      <div class="countbox" style="width: {{ listW }}px;">
        <div class="cbtn" onclick="aiPrev">
          <text class="ctext">◀</text>
        </div>
        <text class="cnum">电脑 {{ ai }} 人</text>
        <div class="cbtn" onclick="aiNext">
          <text class="ctext">▶</text>
        </div>
      </div>

      <scroll class="seats" scroll-y="true">
        <div class="seatrow" if="{{ has0 }}">
          <div class="{{ c0 }}" onclick="nm0L">
            <text class="ctext">◀</text>
          </div>
          <text class="seatname">{{ n0 }}{{ t0 }}</text>
          <div class="{{ c1 }}" onclick="nm0R">
            <text class="ctext">▶</text>
          </div>
        </div>
        <div class="seatrow" if="{{ has1 }}">
          <div class="{{ c0 }}" onclick="nm1L">
            <text class="ctext">◀</text>
          </div>
          <text class="seatname">{{ n1 }}{{ t1 }}</text>
          <div class="{{ c1 }}" onclick="nm1R">
            <text class="ctext">▶</text>
          </div>
        </div>
        <div class="seatrow" if="{{ has2 }}">
          <div class="{{ c0 }}" onclick="nm2L">
            <text class="ctext">◀</text>
          </div>
          <text class="seatname">{{ n2 }}{{ t2 }}</text>
          <div class="{{ c1 }}" onclick="nm2R">
            <text class="ctext">▶</text>
          </div>
        </div>
        <div class="seatrow" if="{{ has3 }}">
          <div class="{{ c0 }}" onclick="nm3L">
            <text class="ctext">◀</text>
          </div>
          <text class="seatname">{{ n3 }}{{ t3 }}</text>
          <div class="{{ c1 }}" onclick="nm3R">
            <text class="ctext">▶</text>
          </div>
        </div>
        <div class="seatrow" if="{{ has4 }}">
          <div class="{{ c0 }}" onclick="nm4L">
            <text class="ctext">◀</text>
          </div>
          <text class="seatname">{{ n4 }}{{ t4 }}</text>
          <div class="{{ c1 }}" onclick="nm4R">
            <text class="ctext">▶</text>
          </div>
        </div>
        <div class="seatrow" if="{{ has5 }}">
          <div class="{{ c0 }}" onclick="nm5L">
            <text class="ctext">◀</text>
          </div>
          <text class="seatname">{{ n5 }}{{ t5 }}</text>
          <div class="{{ c1 }}" onclick="nm5R">
            <text class="ctext">▶</text>
          </div>
        </div>
      </scroll>

      <div class="ops">
        <div class="btn btn-main" onclick="startGame">
          <text class="bt bt-main">开始</text>
        </div>
        <div class="btn" onclick="onBack">
          <text class="bt">返回</text>
        </div>
      </div>
    </div>

    <!-- 对局 -->
    <div class="screen" if="{{ stage === 'play' }}">
      <text class="sub">{{ logLine }}</text>
      <div class="boardwrap">
        <scroll class="tiles" scroll-y="true" style="height: {{ boardH }}px;">
          <div class="tgrid">
            <div class="tile {{ $item.cls }}" for="{{ cells }}" tid="i">
              <text class="tname">{{ $item.name }}</text>
              <text class="tsub">{{ $item.sub }}</text>
              <text class="tdot {{ $item.dotCls }}">{{ $item.dotText }}</text>
            </div>
          </div>
        </scroll>

        <div class="center" style="top: {{ cTop }}px;">
          <text class="crow {{ nowCls }}">{{ nowText }}</text>
          <text class="ccash">{{ cashText }}</text>
          <text class="cdice">{{ diceText }}</text>
          <text class="cevent">{{ eventLine }}</text>
        </div>
      </div>

      <div class="ops">
        <div class="btn btn-main" onclick="roll" if="{{ step === 'roll' }}">
          <text class="bt bt-main">掷骰</text>
        </div>
        <div class="btn" onclick="doBuy" if="{{ step === 'buy' }}">
          <text class="bt">买地</text>
        </div>
        <div class="btn" onclick="skipBuy" if="{{ step === 'buy' }}">
          <text class="bt">不买</text>
        </div>
        <div class="btn" onclick="doUpgrade" if="{{ step === 'own' }}">
          <text class="bt">升级</text>
        </div>
        <div class="btn btn-main" onclick="doGamble" if="{{ step === 'casino' }}">
          <text class="bt bt-main">下注 300</text>
        </div>
        <div class="btn" onclick="doNoGamble" if="{{ step === 'casino' }}">
          <text class="bt">不赌</text>
        </div>
        <div class="btn" onclick="nextTurn" if="{{ step !== 'roll' && isHuman }}">
          <text class="bt">结束</text>
        </div>
      </div>
    </div>

    <!-- 同表多人交接 -->
    <div class="overlay" if="{{ cover }}">
      <text class="overtext">{{ coverText }}</text>
      <div class="ops">
        <div class="btn btn-main" onclick="revealPanel">
          <text class="bt bt-main">继续</text>
        </div>
      </div>
    </div>

    <div class="overlay" if="{{ over }}">
      <text class="overtext">{{ overText }}</text>
      <div class="ops">
        <div class="btn btn-main" onclick="startGame">
          <text class="bt bt-main">再来一局</text>
        </div>
        <div class="btn" onclick="onBack">
          <text class="bt">返回</text>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  @import "../../common/theme.css";

  /* 8 种玩家颜色 */
  .pc-r { background-color: #d64545; }
  .pc-b { background-color: #2b6cb0; }
  .pc-o { background-color: #e07a2f; }
  .pc-g { background-color: #2f9e44; }
  .pc-p { background-color: #8e44ad; }
  .pc-c { background-color: #17a2b8; }
  .pc-y { background-color: #d9a520; }
  .pc-k { background-color: #e84393; }

  .seatrow {
    width: 100%;
    height: 58px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .seatname {
    flex-grow: 1;
    font-size: 20px;
    font-weight: bold;
    color: #ffffff;
    text-align: center;
  }

  .seats {
    width: 100%;
    flex-grow: 1;
  }

  /* 可滚动的地块网格 + 固定中央面板 */
  .boardwrap {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .tiles {
    width: 100%;
  }

  .tgrid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    padding-bottom: 6px;
  }

  .tile {
    width: 31%;
    height: 52px;
    border-radius: 8px;
    border-width: 1px;
    border-style: solid;
    border-color: rgba(255, 255, 255, 0.45);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 1%;
  }

  .t-start { background-color: #17331d; }
  .t-prop { background-color: rgba(255, 255, 255, 0.94); }
  .t-chance { background-color: #f2c94c; }
  .t-tax { background-color: #e56b5d; }
  .t-jail { background-color: #6b7280; }

  .tname {
    font-size: 15px;
    font-weight: bold;
    color: #17331d;
  }

  .tsub {
    font-size: 12px;
    color: #2b3f31;
  }

  .tdot {
    font-size: 12px;
    font-weight: bold;
  }

  .dot-w { color: #ffffff; }
  .dot-d { color: #17331d; }

  .center {
    position: absolute;
    left: 12%;
    width: 76%;
    background-color: #ffffff;
    border-radius: 12px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 8px;
  }

  .crow {
    font-size: 15px;
    font-weight: bold;
    color: #ffffff;
    text-align: center;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 12px;
  }

  .ccash {
    font-size: 22px;
    font-weight: bold;
    color: #17331d;
    margin-top: 4px;
  }

  .cdice {
    font-size: 16px;
    font-weight: bold;
    color: #2b6cb0;
    margin-top: 2px;
  }

  .cevent {
    font-size: 13px;
    color: #2b3f31;
    text-align: center;
    margin-top: 2px;
  }
</style>

<script>
  import router from '@system.router';
  import device from '@system.device';
  import prompt from '@system.prompt';
  import {
    BOARD,
    CELL_COUNT,
    MONEY_OPTIONS,
    MAX_ROUNDS,
    createGame,
    rollDice,
    move,
    settle,
    buyProp,
    upgradeProp,
    checkBankrupt,
    casinoPlay,
    endTurn,
    aliveCount,
    roundWinner,
    wealthOf
  } from '../../common/monopoly';
  import { NAME_POOL, COLOR_CLASSES, cycleName } from '../../common/setup';

  const MAX_SEATS = 6;

  export default {
    private: {
      stage: 'menu', // menu | setup | play
      listW: 320,

      // 设置
      moneyIdx: 1,
      money: 5000,
      humans: 1,
      ai: 2,
      n0: '大卫', n1: '安娜', n2: '李雷', n3: '韩梅梅', n4: '麦克', n5: '小美',
      t0: '', t1: '', t2: '', t3: '', t4: '', t5: '',
      has0: true, has1: true, has2: true, has3: false, has4: false, has5: false,
      c0: 'cbtn pc-r', c1: 'cbtn pc-r',
      seatNames: [],

      // 对局
      game: null,
      seats: [],
      viewer: 0,
      cover: false,
      coverText: '',
      isHuman: true,
      step: 'roll',
      over: false,
      overText: '',

      cells: [],
      nowText: '',
      nowCls: 'crow pc-r',
      cashText: '',
      diceText: '',
      eventLine: '',
      logLine: '',
      boardH: 300,
      cTop: 90,
      aiTimer: null
    },

    onInit() {
      device.getInfo({
        success: (ret) => {
          const w = (ret && ret.screenWidth) || 336;
          const h = (ret && ret.screenHeight) || 480;
          this.applyLayout(w, h);
        },
        fail: () => {
          this.applyLayout(336, 480);
        }
      });
      this.money = MONEY_OPTIONS[this.moneyIdx];
      this.syncSeats();
    },

    onHide() {
      this.clearAi();
    },

    onDestroy() {
      this.clearAi();
    },

    onBackPress() {
      return this.stage === 'play' || this.stage === 'setup';
    },

    applyLayout(w, h) {
      this.listW = w - 24;
      this.boardH = h - 54 - 30 - 64 - 12;
      this.cTop = Math.floor(this.boardH / 2) - 60;
    },

    /* ---------------- 开局设置 ---------------- */

    syncSeats() {
      const total = this.humans + this.ai;
      const names = [];
      for (let i = 0; i < MAX_SEATS; i++) {
        const on = i < total;
        this['has' + i] = on;
        if (!on) continue;
        const nm = this['n' + i];
        const isAi = i >= this.humans;
        this['t' + i] = (isAi ? '（电脑）' : '') + ' ' + COLOR_CLASSES[i % 8].replace('pc-', '');
        names.push({ name: nm, ai: isAi, color: COLOR_CLASSES[i % 8] });
      }
      this.seatNames = names;
      this.c0 = 'cbtn ' + COLOR_CLASSES[0];
      this.c1 = 'cbtn ' + COLOR_CLASSES[1];
    },

    moneyPrev() {
      this.moneyIdx = (this.moneyIdx - 1 + MONEY_OPTIONS.length) % MONEY_OPTIONS.length;
      this.money = MONEY_OPTIONS[this.moneyIdx];
    },

    moneyNext() {
      this.moneyIdx = (this.moneyIdx + 1) % MONEY_OPTIONS.length;
      this.money = MONEY_OPTIONS[this.moneyIdx];
    },

    humanPrev() {
      if (this.humans > 1) this.humans--;
      else this.humans = 4;
      if (this.humans + this.ai > MAX_SEATS) this.ai = MAX_SEATS - this.humans;
      if (this.humans + this.ai < 2) this.ai = Math.max(0, 2 - this.humans);
      this.syncSeats();
    },

    humanNext() {
      if (this.humans < 4) this.humans++;
      else this.humans = 1;
      if (this.humans + this.ai > MAX_SEATS) this.ai = MAX_SEATS - this.humans;
      if (this.humans + this.ai < 2) this.ai = Math.max(0, 2 - this.humans);
      this.syncSeats();
    },

    aiPrev() {
      if (this.ai > 0) this.ai--;
      else this.ai = Math.min(4, MAX_SEATS - this.humans);
      if (this.humans + this.ai < 2) this.ai = Math.max(0, 2 - this.humans);
      this.syncSeats();
    },

    aiNext() {
      if (this.humans + this.ai < MAX_SEATS) this.ai++;
      else this.ai = 0;
      if (this.humans + this.ai < 2) this.ai = Math.max(0, 2 - this.humans);
      this.syncSeats();
    },

    cycleAt(i, dir) {
      const cur = this['n' + i];
      let next = cycleName(cur, dir);
      // 避免与同房其它座位重名
      let guard = 0;
      const used = [];
      for (let k = 0; k < MAX_SEATS; k++) {
        if (k !== i && this['has' + k]) used.push(this['n' + k]);
      }
      while (used.indexOf(next) >= 0 && guard++ < NAME_POOL.length) {
        next = cycleName(next, dir);
      }
      this['n' + i] = next;
      this.syncSeats();
    },

    nm0L() {
      this.cycleAt(0, -1);
    },
    nm0R() {
      this.cycleAt(0, 1);
    },
    nm1L() {
      this.cycleAt(1, -1);
    },
    nm1R() {
      this.cycleAt(1, 1);
    },
    nm2L() {
      this.cycleAt(2, -1);
    },
    nm2R() {
      this.cycleAt(2, 1);
    },
    nm3L() {
      this.cycleAt(3, -1);
    },
    nm3R() {
      this.cycleAt(3, 1);
    },
    nm4L() {
      this.cycleAt(4, -1);
    },
    nm4R() {
      this.cycleAt(4, 1);
    },
    nm5L() {
      this.cycleAt(5, -1);
    },
    nm5R() {
      this.cycleAt(5, 1);
    },

    toSetup() {
      this.stage = 'setup';
      this.syncSeats();
    },

    /* ---------------- 开局 ---------------- */

    startGame() {
      this.clearAi();
      const total = this.humans + this.ai;
      this.seats = [];
      for (let i = 0; i < total; i++) {
        this.seats.push({
          name: this['n' + i],
          color: COLOR_CLASSES[i % 8],
          isAi: i >= this.humans
        });
      }
      this.game = createGame(total, this.money);
      this.over = false;
      this.step = 'roll';
      this.viewer = 0;
      this.diceText = '';
      this.stage = 'play';
      this.renderBoard();
      this.refreshInfo('');
      this.afterTurn();
    },

    restart() {
      this.startGame();
    },

    /* ---------------- 渲染 ---------------- */

    renderBoard() {
      const g = this.game;
      if (!g) return;
      const cells = [];
      for (let i = 0; i < CELL_COUNT; i++) {
        const c = BOARD[i];
        const owner = g.players.findIndex((q) => q.props.some((e) => e.i === i));
        const here = [];
        for (let p = 0; p < g.players.length; p++) {
          if (g.players[p].alive && g.players[p].pos === i) here.push(p + 1);
        }
        let sub = '';
        if (c.t === 'prop') sub = '¥' + c.price + (owner >= 0 ? ' · ' + this.seats[owner].name : '');
        else if (c.t === 'tax') sub = '缴 ¥' + c.amount;
        else if (c.t === 'chance') sub = '抽卡';
        else sub = c.t === 'jail' ? '暂停一轮' : '领 ¥400';
        cells.push({
          i: i + 1,
          name: c.name,
          sub: sub,
          cls: 'tile t-' + c.t,
          dotText: here.length ? '● ' + here.join('/') + '号' : '',
          dotCls: c.t === 'prop' || c.t === 'chance' ? 'tdot dot-d' : 'tdot dot-w'
        });
      }
      this.cells = cells;
    },

    refreshInfo(event) {
      const g = this.game;
      if (!g) return;
      const p = g.players[g.current];
      const seat = this.seats[g.current];
      this.nowText = '轮到 ' + seat.name + '（' + (g.current + 1) + '号' + (seat.isAi ? '·电脑' : '') + '）';
      this.nowCls = 'crow ' + seat.color;
      this.cashText = '¥' + Math.max(0, p.money) + ' · 第' + g.round + '/' + MAX_ROUNDS + '回合';
      this.eventLine = event || '';
      this.logLine = g.log[g.log.length - 1] || '';
      this.isHuman = !seat.isAi;
      this.renderBoard();
    },

    /* ---------------- 回合 ---------------- */

    roll() {
      const g = this.game;
      if (!g || this.over || this.cover) return;
      const d = rollDice();
      this.diceText = '骰 ' + d.a + ' + ' + d.b;
      move(g, d.sum);
      const ev = settle(g);
      this.renderBoard();
      const seat = this.seats[g.current];
      if (ev.type === 'buy') {
        this.step = 'buy';
        this.refreshInfo('要买下「' + ev.name + '」吗？¥' + ev.price);
        return;
      }
      if (ev.type === 'own') {
        const e = g.players[g.current].props.find((q) => q.i === ev.cell);
        this.step = e && e.level < 2 ? 'own' : 'done';
        this.refreshInfo('自己的「' + ev.name + '」' + (e && e.level < 2 ? '，可升级' : '· 已满级'));
        return;
      }
      if (ev.type === 'rent') {
        this.step = 'done';
        this.refreshInfo('付租 ¥' + ev.amount + ' 给 ' + this.seats[ev.owner].name);
        return;
      }
      if (ev.type === 'tax') {
        this.step = 'done';
        this.refreshInfo('缴税 ¥' + ev.amount);
        return;
      }
      if (ev.type === 'casino') {
        this.step = 'casino';
        this.refreshInfo('赌场！下注 ¥' + ev.bet + ' 拼一把？');
        return;
      }
      if (ev.type === 'cash') {
        this.step = 'done';
        this.refreshInfo('捡到钱 +¥' + ev.amount);
        return;
      }
      if (ev.type === 'airport') {
        this.step = 'done';
        this.refreshInfo('机场：花 ¥' + ev.fee + ' 飞到「' + ev.toName + '」' + this.innerText(ev));
        return;
      }
      if (ev.type === 'road') {
        this.step = 'done';
        this.refreshInfo('汽车站：搭车前进 ' + ev.step + ' 格到「' + ev.toName + '」' + this.innerText(ev));
        return;
      }
      if (ev.type === 'jail') {
        this.step = 'done';
        this.refreshInfo('进了监狱，暂停一轮');
        return;
      }
      if (ev.type === 'chance') {
        this.step = 'done';
        this.refreshInfo('机会：' + ev.card.text);
        return;
      }
      this.step = 'done';
      this.refreshInfo('落在「' + (ev.name || '') + '」');
      return;
    },

    doBuy() {
      const g = this.game;
      const pos = g.players[g.current].pos;
      if (g.players[g.current].money < BOARD[pos].price) {
        this.hint('买不起');
        return;
      }
      buyProp(g, pos);
      this.step = 'done';
      this.refreshInfo('买入「' + BOARD[pos].name + '」');
    },

    skipBuy() {
      this.step = 'done';
      this.refreshInfo('放弃购买');
    },

    doGamble() {
      const g = this.game;
      const r = casinoPlay(g, true);
      if (!r.ok) {
        this.hint(r.msg);
        return;
      }
      this.step = 'done';
      this.refreshInfo(r.win ? '赌赢了！+' + r.amount : '赌输了 -' + r.amount);
      this.renderBoard();
    },

    doNoGamble() {
      casinoPlay(this.game, false);
      this.step = 'done';
      this.refreshInfo('没敢下注，走人');
    },

    /** 机场/汽车站再次落点的文字 */
    innerText(ev) {
      const in2 = ev.inner;
      if (!in2) return '';
      if (in2.type === 'buy') return ' → 可买「' + in2.name + '」';
      if (in2.type === 'own') return ' → 自己的「' + in2.name + '」';
      if (in2.type === 'rent') return ' → 付租 ¥' + in2.amount;
      if (in2.type === 'tax') return ' → 缴税 ¥' + in2.amount;
      if (in2.type === 'cash') return ' → 又捡到 ¥' + in2.amount;
      if (in2.type === 'casino') return ' → 又到赌场！';
      if (in2.type === 'jail') return ' → 进监狱了';
      if (in2.type === 'chance') return ' → 机会：' + in2.card.text;
      if (in2.type === 'road') return ' → 又在汽车站';
      if (in2.type === 'airport') return ' → 又到机场';
      return '';
    },

    doUpgrade() {
      const g = this.game;
      const r = upgradeProp(g, g.players[g.current].pos);
      if (!r.ok) {
        this.hint(r.msg);
        return;
      }
      this.step = 'done';
      this.refreshInfo('升级成功，租金翻倍');
    },

    nextTurn() {
      const g = this.game;
      if (!g || this.over) return;
      checkBankrupt(g);
      const ac = aliveCount(g);
      if (ac.count <= 1) {
        this.finish(this.seats[ac.last].name + ' 获胜！');
        return;
      }
      if (g.round > MAX_ROUNDS) {
        const rw = roundWinner(g);
        this.finish('60 回合到 · ' + this.seats[rw.player].name + ' 总资产最高获胜！');
        return;
      }
      endTurn(g);
      this.diceText = '';
      this.step = 'roll';
      this.afterTurn();
    },

    afterTurn() {
      const g = this.game;
      if (!g || this.over) return;
      const seat = this.seats[g.current];
      if (seat.isAi) {
        this.refreshInfo(this.seatName(g.current) + '（电脑）思考中…');
        this.scheduleAi();
        return;
      }
      // 真人：同表多人时交接
      this.viewer = g.current;
      this.cover = true;
      this.coverText = '轮到 ' + seat.name + '（' + (g.current + 1) + '号）· 把表交给 TA';
      this.refreshInfo('轮到 ' + seat.name + '，点「继续」开始');
    },

    revealPanel() {
      this.cover = false;
      this.step = 'roll';
      this.refreshInfo('轮到 ' + this.seats[this.game.current].name + '，掷骰');
    },

    seatName(i) {
      return this.seats[i] ? this.seats[i].name : i + 1 + '号';
    },

    /* ---------------- AI ---------------- */

    scheduleAi() {
      this.clearAi();
      this.aiTimer = setTimeout(() => {
        this.aiTimer = null;
        const g = this.game;
        if (!g || this.over) return;
        if (!this.seats[g.current].isAi) return;
        const pid = g.current;
        const d = rollDice();
        this.diceText = '骰 ' + d.a + ' + ' + d.b;
        move(g, d.sum);
        const ev = settle(g);
        this.renderBoard();
        const nm = this.seatName(pid);
        if (ev.type === 'buy') {
          if (g.players[pid].money >= BOARD[ev.cell].price) {
            buyProp(g, ev.cell);
            this.refreshInfo(nm + ' 买入「' + ev.name + '」');
          } else {
            this.refreshInfo(nm + ' 放弃购买');
          }
        } else if (ev.type === 'own') {
          const e = g.players[pid].props.find((q) => q.i === ev.cell);
          if (e && e.level < 2 && g.players[pid].money >= BOARD[ev.cell].price * 3) {
            upgradeProp(g, ev.cell);
            this.refreshInfo(nm + ' 升级「' + ev.name + '」');
          } else {
            this.refreshInfo(nm + ' 回合结束');
          }
        } else if (ev.type === 'rent') {
          this.refreshInfo(nm + ' 付租 ¥' + ev.amount + ' 给 ' + this.seatName(ev.owner));
        } else if (ev.type === 'tax') {
          this.refreshInfo(nm + ' 缴税 ¥' + ev.amount);
        } else if (ev.type === 'casino') {
          const gp = g.players[pid];
          let txt = nm + ' 没下注';
          if (gp.money >= ev.bet * 3) {
            const r = casinoPlay(g, true);
            txt = nm + (r.win ? ' 赌赢 +' + r.amount : ' 赌输 -' + r.amount);
          }
          this.refreshInfo(txt);
        } else if (ev.type === 'cash') {
          this.refreshInfo(nm + ' 捡到钱 +' + ev.amount);
        } else if (ev.type === 'airport') {
          this.refreshInfo(nm + ' 从机场飞到「' + ev.toName + '」' + this.innerText(ev));
        } else if (ev.type === 'road') {
          this.refreshInfo(nm + ' 搭车前进到「' + ev.toName + '」' + this.innerText(ev));
        } else if (ev.type === 'jail') {
          this.refreshInfo(nm + ' 进了监狱');
        } else if (ev.type === 'chance') {
          this.refreshInfo(nm + ' 机会：' + ev.card.text);
        } else {
          this.refreshInfo(nm + ' 落在「' + (ev.name || '') + '」');
        }
        this.renderBoard();

        this.aiTimer = setTimeout(() => {
          this.aiTimer = null;
          const gg = this.game;
          if (!gg || this.over) return;
          checkBankrupt(gg);
          const ac = aliveCount(gg);
          if (ac.count <= 1) {
            this.finish(this.seats[ac.last].name + ' 获胜！');
            return;
          }
          if (gg.round > MAX_ROUNDS) {
            const rw = roundWinner(gg);
            this.finish('60 回合到 · ' + this.seats[rw.player].name + ' 总资产最高获胜！');
            return;
          }
          endTurn(gg);
          this.diceText = '';
          this.step = 'roll';
          this.afterTurn();
        }, 700);
      }, 650);
    },

    clearAi() {
      if (this.aiTimer) {
        clearTimeout(this.aiTimer);
        this.aiTimer = null;
      }
    },

    finish(text) {
      this.over = true;
      this.overText = text;
      this.cover = false;
      this.refreshInfo(text);
    },

    onBack() {
      this.clearAi();
      if (this.stage === 'play') {
        this.stage = 'setup';
        this.over = false;
        this.cover = false;
        return;
      }
      if (this.stage === 'setup') {
        this.stage = 'menu';
        return;
      }
      router.back();
    },

    goRules() {
      router.push({ uri: '/pages/rules' });
    },

    hint(msg) {
      prompt.showToast({ message: msg, duration: 1200 });
    }
  };
</script>