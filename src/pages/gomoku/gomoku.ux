<template>
  <div class="page">
    <!-- ① 模式选择 -->
    <div class="screen" if="{{ phase === 'menu' }}">
      <div class="header">
        <div class="back" onclick="goBack">
          <text class="back-text">&lt;</text>
        </div>
        <text class="header-title">五子棋</text>
      </div>

      <div class="list" style="width: {{ listW }}px;">
        <div class="card" onclick="startAi">
          <text class="card-text">单人 · 挑战 AI</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="startPvp">
          <text class="card-text">双人 · 同表对战</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="cycleLevel">
          <text class="card-text">AI 难度 · {{ levelName }}</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="goBack">
          <text class="card-text">返回菜单</text>
          <text class="card-arrow">&gt;</text>
        </div>
      </div>

      <text class="hint">11 × 11 棋盘 · 先连成五子者胜</text>
      <text class="hint">棋盘默认放大，按住拖动可平移</text>
      <text class="hint">点一下瞄准（出现准星），再点同一点落子</text>
      <text class="hint">双人模式：两人轮流在同一块表上操作</text>
    </div>

    <!-- ② 对局 -->
    <div class="screen" if="{{ phase === 'play' }}">
      <div class="header">
        <div class="back" onclick="goMenu">
          <text class="back-text">&lt;</text>
        </div>
        <text class="header-title">{{ title }}</text>
      </div>

      <div class="status">
        <text class="status-text">{{ statusText }}</text>
      </div>

      <div class="aimbar">
        <text class="aim-text">{{ aimText }}</text>
      </div>

      <div
        class="win"
        style="left: {{ wx }}px; top: {{ wy }}px; width: {{ ww }}px; height: {{ wh }}px;"
        @touchstart="onTouchStart"
        @touchmove="onTouchMove"
        @touchend="onTouchEnd"
      >
        <div
          class="vline"
          style="left: {{ $item.x }}px; width: 2px; height: {{ wh }}px;"
          for="{{ vlines }}"
          tid="i"
        ></div>
        <div
          class="hline"
          style="top: {{ $item.y }}px; width: {{ ww }}px; height: 2px;"
          for="{{ hlines }}"
          tid="i"
        ></div>
        <div
          class="stone {{ $item.cls }}"
          style="left: {{ $item.x }}px; top: {{ $item.y }}px; width: {{ $item.d }}px; height: {{ $item.d }}px;"
          for="{{ stones }}"
          tid="i"
        >
          <div class="lastmark" if="{{ $item.last }}"></div>
        </div>
        <div
          class="aim {{ aimCls }}"
          if="{{ hasAim }}"
          style="left: {{ aimX }}px; top: {{ aimY }}px; width: {{ aimD }}px; height: {{ aimD }}px;"
        >
          <div class="aimdot"></div>
        </div>
      </div>

      <div class="pad" style="top: {{ padY }}px;">
        <div class="dbtn" onclick="nudgeLeft">
          <text class="dtext">左</text>
        </div>
        <div class="dbtn" onclick="nudgeUp">
          <text class="dtext">上</text>
        </div>
        <div class="dbtn dbtn-main" onclick="placeAtAim">
          <text class="dtext dtext-main">落子</text>
        </div>
        <div class="dbtn" onclick="nudgeDown">
          <text class="dtext">下</text>
        </div>
        <div class="dbtn" onclick="nudgeRight">
          <text class="dtext">右</text>
        </div>
      </div>

      <div class="pad2" style="top: {{ pad2Y }}px;">
        <div class="sbtn" onclick="undo">
          <text class="stext">悔棋</text>
        </div>
        <div class="sbtn" onclick="restart">
          <text class="stext">重开</text>
        </div>
        <div class="sbtn" onclick="zoomCycle">
          <text class="stext">缩放 {{ zoomName }}</text>
        </div>
        <div class="sbtn" onclick="goMenu">
          <text class="stext">菜单</text>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  @import "../../common/theme.css";

  .screen {
    width: 100%;
    height: 100%;
    flex-direction: column;
  }

  .status {
    width: 100%;
    height: 24px;
    justify-content: center;
    align-items: center;
  }

  .status-text {
    font-size: 17px;
    font-weight: bold;
    color: #ffffff;
  }

  .aimbar {
    width: 100%;
    height: 22px;
    justify-content: center;
    align-items: center;
  }

  .aim-text {
    font-size: 14px;
    color: #eaffea;
  }

  /* 棋盘视口：底色浅木色，网格线画在上面，超出视口的格子不渲染（省性能） */
  .win {
    position: absolute;
    background-color: #e9d3a6;
    border-radius: 6px;
  }

  .vline {
    position: absolute;
    top: 0;
    background-color: #8a6a3a;
  }

  .hline {
    position: absolute;
    left: 0;
    background-color: #8a6a3a;
  }

  .stone {
    position: absolute;
    border-radius: 50%;
    justify-content: center;
    align-items: center;
  }

  .stone-b {
    background-color: #14181c;
  }

  .stone-w {
    background-color: #f7f7f7;
  }

  .lastmark {
    width: 26%;
    height: 26%;
    border-radius: 50%;
    background-color: #e8422f;
  }

  /* 瞄准准星：半透明圆 + 中心点 */
  .aim {
    position: absolute;
    border-radius: 50%;
    background-color: rgba(23, 51, 29, 0.28);
    justify-content: center;
    align-items: center;
  }

  /* 瞄到已经有子的位置 → 红色警告 */
  .aim-hit {
    background-color: rgba(232, 66, 47, 0.45);
  }

  .aimdot {
    width: 22%;
    height: 22%;
    border-radius: 50%;
    background-color: #ffffff;
  }

  .pad {
    position: absolute;
    left: 0;
    width: 100%;
    height: 34px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  .pad2 {
    position: absolute;
    left: 0;
    width: 100%;
    height: 34px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  .dbtn {
    width: 60px;
    height: 34px;
    border-radius: 17px;
    background-color: rgba(255, 255, 255, 0.9);
    justify-content: center;
    align-items: center;
    margin-left: 3px;
    margin-right: 3px;
  }

  .dbtn-main {
    width: 68px;
    background-color: #17331d;
  }

  .dtext {
    font-size: 16px;
    font-weight: bold;
    color: #17331d;
  }

  .dtext-main {
    color: #ffffff;
  }

  .sbtn {
    width: 76px;
    height: 34px;
    border-radius: 15px;
    background-color: rgba(255, 255, 255, 0.75);
    justify-content: center;
    align-items: center;
    margin-left: 3px;
    margin-right: 3px;
  }

  .stext {
    font-size: 15px;
    font-weight: bold;
    color: #17331d;
  }
</style>

<script>
  import router from '@system.router';
  import device from '@system.device';
  import prompt from '@system.prompt';
  import vibrator from '@system.vibrator';
  import {
    BLACK,
    WHITE,
    createBoard,
    isWin,
    isFull,
    opponentOf,
    chooseMove,
    LEVEL_LABELS,
    LEVEL_ORDER
  } from '../../common/gomoku-ai';

  const HEADER_H = 46;
  const STATUS_H = 26;
  const AIM_H = 24;
  const PAD_H = 36;
  const ZOOM_COLS = [5, 6, 8]; // 视口横向可见格数：越大格子越小
  const ZOOM_NAMES = ['大', '中', '小'];

  function clamp(v, lo, hi) {
    if (v < lo) return lo;
    if (v > hi) return hi;
    return v;
  }

  export default {
    private: {
      phase: 'menu',
      mode: 'ai',
      level: 'normal',
      levelName: '普通',

      boardN: 11,
      board: [],
      history: [],
      turn: BLACK,
      winner: 0,
      lastIdx: -1,

      // 视口与缩放
      scrW: 336,
      scrH: 480,
      zoomIdx: 1,
      zoomName: '中',
      cs: 54, // 一格边长（px）
      wx: 4,
      wy: 84,
      ww: 328,
      wh: 314,
      px: 0, // 平移（px）
      py: 0,
      padY: 402,
      pad2Y: 436,
      listW: 320,

      // 渲染列表
      vlines: [],
      hlines: [],
      stones: [],

      // 瞄准
      aim: null,
      hasAim: false,
      aimX: 0,
      aimY: 0,
      aimD: 54,
      aimCls: 'aim',
      aimText: '拖动可平移棋盘 · 点一下瞄准，再点一下落子',

      // 手势
      drag: false,
      downX: 0,
      downY: 0,
      lastX: 0,
      lastY: 0,

      title: '五子棋',
      statusText: '',
      aiTimer: null
    },

    onInit() {
      const app = this.$app && this.$app.$def && this.$app.$def.data;
      this.boardN = (app && app.boardN) || 11;
      this.resetState();
      this.applyLayout(336, 480, true);
      device.getInfo({
        success: (ret) => {
          const w = (ret && ret.screenWidth) || 336;
          const h = (ret && ret.screenHeight) || 480;
          this.applyLayout(w, h, false);
        },
        fail: () => {
          this.applyLayout(336, 480, false);
        }
      });
    },

    onHide() {
      this.clearAi();
      this.clearRenderTimer();
    },

    onDestroy() {
      this.clearAi();
      this.clearRenderTimer();
    },

    /* ---------------- 布局 ---------------- */

    applyLayout(w, h, silent) {
      this.scrW = w;
      this.scrH = h;

      const wx = 4;
      const ww = w - 8;
      const wy = HEADER_H + STATUS_H + AIM_H + 2;
      const rows = 2 * PAD_H + 6;
      const wh = Math.max(140, h - wy - rows - 6);

      const cols = ZOOM_COLS[this.zoomIdx];
      const cs = Math.max(26, Math.floor(ww / cols));

      this.wx = wx;
      this.ww = ww;
      this.wy = wy;
      this.wh = wh;
      this.cs = cs;
      this.zoomName = ZOOM_NAMES[this.zoomIdx];
      this.aimD = cs;

      // 竖向居中（胶囊屏剩余空间多）
      const slack = h - (wy + wh + rows + 6);
      let shift = 0;
      if (slack > 20) shift = Math.floor((slack - 20) / 2);
      this.padY = wy + wh + 4 + shift;
      this.pad2Y = this.padY + PAD_H;

      this.listW = w - 24;
      this.clampPan();
      this.render();
      if (!silent) this.refresh();
    },

    maxPanX() {
      return Math.max(0, (this.boardN - 1) * this.cs + 8 - this.ww);
    },

    maxPanY() {
      return Math.max(0, (this.boardN - 1) * this.cs + 8 - this.wh);
    },

    clampPan() {
      this.px = clamp(this.px, 0, this.maxPanX());
      this.py = clamp(this.py, 0, this.maxPanY());
    },

    centerOn(r, c) {
      this.px = clamp(c * this.cs + this.cs / 2 - this.ww / 2, 0, this.maxPanX());
      this.py = clamp(r * this.cs + this.cs / 2 - this.wh / 2, 0, this.maxPanY());
    },

    ensureVisible(r, c) {
      const x = c * this.cs;
      const y = r * this.cs;
      const pad = this.cs + 6;
      if (x < this.px + pad) this.px = x - pad;
      else if (x > this.px + this.ww - pad) this.px = x - this.ww + pad;
      if (y < this.py + pad) this.py = y - pad;
      else if (y > this.py + this.wh - pad) this.py = y - this.wh + pad;
      this.clampPan();
    },

    /* ---------------- 渲染（只画可见范围，省性能） ---------------- */

    render() {
      const n = this.boardN;
      const cs = this.cs;
      const px = this.px;
      const py = this.py;
      const d = Math.max(12, cs - 6);

      const c0 = Math.max(0, Math.floor(px / cs) - 1);
      const c1 = Math.min(n - 1, Math.ceil((px + this.ww) / cs) + 1);
      const r0 = Math.max(0, Math.floor(py / cs) - 1);
      const r1 = Math.min(n - 1, Math.ceil((py + this.wh) / cs) + 1);

      const vlines = [];
      for (let c = c0; c <= c1; c++) {
        vlines.push({ i: c * 2 + 1, x: c * cs - px });
      }
      const hlines = [];
      for (let r = r0; r <= r1; r++) {
        hlines.push({ i: r * 2 + 1, y: r * cs - py });
      }

      const stones = [];
      for (let r = r0; r <= r1; r++) {
        for (let c = c0; c <= c1; c++) {
          const idx = r * n + c;
          const v = this.board[idx];
          if (v === 0) continue;
          stones.push({
            i: idx + 1,
            x: c * cs - px + 1 - d / 2,
            y: r * cs - py + 1 - d / 2,
            d: d,
            cls: v === BLACK ? 'stone-b' : 'stone-w',
            last: idx === this.lastIdx
          });
        }
      }

      this.vlines = vlines;
      this.hlines = hlines;
      this.stones = stones;

      if (this.aim) {
        const a = this.aim;
        const occ = this.board[a.r * n + a.c] !== 0;
        this.hasAim = true;
        this.aimX = a.c * cs - px + 1 - cs / 2;
        this.aimY = a.r * cs - py + 1 - cs / 2;
        this.aimD = cs;
        this.aimCls = occ ? 'aim aim-hit' : 'aim';
      } else {
        this.hasAim = false;
      }
      this.updateAimText();
    },

    updateAimText() {
      if (!this.aim) {
        this.aimText = '拖动可平移棋盘 · 点一下瞄准，再点一下落子';
        return;
      }
      const n = this.boardN;
      const occ = this.board[this.aim.r * n + this.aim.c] !== 0;
      const t =
        '瞄准 ' + (this.aim.r + 1) + '行' + (this.aim.c + 1) + '列' + (occ ? ' · 已有子' : ' · 再点一次落子');
      if (this.aimText !== t) this.aimText = t;
    },

    /* ---------------- 状态 ---------------- */

    resetState() {
      const n = this.boardN;
      this.board = createBoard(n);
      this.history = [];
      this.turn = BLACK;
      this.winner = 0;
      this.lastIdx = -1;
      this.aim = null;
      this.centerOn(Math.floor(n / 2), Math.floor(n / 2));
      this.render();
    },

    refresh() {
      this.title = this.mode === 'ai' ? '五子棋 · 单人' : '五子棋 · 双人';
      if (this.winner === BLACK) this.statusText = '黑棋胜！';
      else if (this.winner === WHITE)
        this.statusText = this.mode === 'ai' ? 'AI 胜，再来一局？' : '白棋胜！';
      else if (this.winner === -1) this.statusText = '平局，棋盘已满';
      else if (this.mode === 'ai')
        this.statusText = this.turn === WHITE ? 'AI 思考中…' : '轮到你 · 执黑';
      else this.statusText = this.turn === BLACK ? '轮到 黑方 落子' : '轮到 白方 落子';
      this.render();
    },

    canPlay() {
      if (this.winner !== 0) return false;
      if (this.mode === 'ai' && this.turn !== BLACK) return false;
      return true;
    },

    /* ---------------- 流程 ---------------- */

    startAi() {
      this.mode = 'ai';
      this.phase = 'play';
      this.resetState();
      this.refresh();
    },

    startPvp() {
      this.mode = 'pvp';
      this.phase = 'play';
      this.resetState();
      this.refresh();
    },

    cycleLevel() {
      const cur = LEVEL_ORDER.indexOf(this.level);
      const next = LEVEL_ORDER[(cur + 1) % LEVEL_ORDER.length];
      this.level = next;
      this.levelName = LEVEL_LABELS[next];
    },

    zoomCycle() {
      this.zoomIdx = (this.zoomIdx + 1) % ZOOM_COLS.length;
      this.applyLayout(this.scrW, this.scrH, true);
      const a = this.aim || { r: Math.floor(this.boardN / 2), c: Math.floor(this.boardN / 2) };
      this.centerOn(a.r, a.c);
      this.render();
      this.hint('缩放：' + this.zoomName);
    },

    goMenu() {
      this.clearAi();
      this.phase = 'menu';
    },

    goBack() {
      this.clearAi();
      router.back();
    },

    restart() {
      this.clearAi();
      this.resetState();
      this.refresh();
      this.hint('已重开');
    },

    undo() {
      this.clearAi();
      if (!this.history.length) {
        this.hint('还没有落子');
        return;
      }
      this.history.pop();
      if (this.mode === 'ai' && this.history.length && this.history[this.history.length - 1].p === WHITE) {
        this.history.pop();
      }
      this.rebuildFromHistory();
      if (this.mode === 'ai' && this.winner === 0 && this.turn === WHITE) {
        this.scheduleAi();
      }
    },

    rebuildFromHistory() {
      const n = this.boardN;
      this.board = createBoard(n);
      this.winner = 0;
      this.lastIdx = -1;
      let turn = BLACK;
      for (let k = 0; k < this.history.length; k++) {
        const m = this.history[k];
        this.board[m.i] = m.p;
        this.lastIdx = m.i;
        turn = opponentOf(m.p);
        if (isWin(this.board, n, Math.floor(m.i / n), m.i % n, m.p)) this.winner = m.p;
      }
      this.turn = turn;
      if (this.lastIdx >= 0) {
        const r = Math.floor(this.lastIdx / n);
        const c = this.lastIdx % n;
        this.aim = { r: r, c: c };
        this.ensureVisible(r, c);
      } else {
        this.aim = null;
        this.centerOn(Math.floor(n / 2), Math.floor(n / 2));
      }
      this.refresh();
    },

    /* ---------------- 落子 ---------------- */

    commit(r, c) {
      const n = this.boardN;
      const i = r * n + c;
      if (this.board[i] !== 0 || this.winner !== 0) return false;
      const player = this.turn;
      this.board[i] = player;
      this.lastIdx = i;
      this.history.push({ i: i, p: player });

      if (isWin(this.board, n, r, c, player)) {
        this.winner = player;
        this.buzz(true);
      } else if (isFull(this.board)) {
        this.winner = -1;
      } else {
        this.turn = opponentOf(player);
        this.buzz(false);
      }
      this.aim = { r: r, c: c };
      this.ensureVisible(r, c);
      this.refresh();
      return true;
    },

    tryPlace(r, c) {
      const n = this.boardN;
      if (this.board[r * n + c] !== 0) {
        this.hint('这里已经有子了');
        return;
      }
      if (!this.commit(r, c)) return;
      if (this.mode === 'ai' && this.winner === 0 && this.turn === WHITE) {
        this.scheduleAi();
      }
    },

    placeAtAim() {
      if (!this.canPlay()) return;
      if (!this.aim) {
        const m = Math.floor(this.boardN / 2);
        this.aim = { r: m, c: m };
      }
      this.tryPlace(this.aim.r, this.aim.c);
    },

    onBackPress() {
      // 对局中拦截系统返回（右滑返回手势同样走返回管线），防误退
      return this.phase === 'play';
    },

    renderThrottled() {
      const now = Date.now();
      if (!this.__lastRender || now - this.__lastRender >= 30) {
        this.__lastRender = now;
        this.render();
        return;
      }
      if (this.__renderTimer) return;
      const wait = 30 - (now - this.__lastRender);
      this.__renderTimer = setTimeout(() => {
        this.__renderTimer = null;
        this.__lastRender = Date.now();
        this.render();
      }, wait);
    },

    clearRenderTimer() {
      if (this.__renderTimer) {
        clearTimeout(this.__renderTimer);
        this.__renderTimer = null;
      }
    },

    /* ---------------- 手势：拖动平移 + 点按瞄准 ---------------- */

    onTouchStart(evt) {
      const p = this.touchPoint(evt);
      if (!p) return;
      this.drag = false;
      this.downX = p.x;
      this.downY = p.y;
      this.lastX = p.x;
      this.lastY = p.y;
    },

    onTouchMove(evt) {
      const p = this.touchPoint(evt);
      if (!p) return;
      const dx = p.x - this.lastX;
      const dy = p.y - this.lastY;
      this.lastX = p.x;
      this.lastY = p.y;
      if (!this.drag) {
        if (Math.abs(p.x - this.downX) + Math.abs(p.y - this.downY) <= 10) return;
        this.drag = true;
      }
      this.px -= dx;
      this.py -= dy;
      this.clampPan();
      this.renderThrottled();
    },

    onTouchEnd(evt) {
      if (this.drag) {
        this.drag = false;
        this.render();
        return;
      }
      const p = this.touchPoint(evt);
      if (!p) return;
      this.handleTap(p.x, p.y);
    },

    handleTap(x, y) {
      let hit = this.hitCell(x, y, false);
      if (!hit) hit = this.hitCell(x, y, true); // 兼容坐标参照系差异
      if (!hit) return;
      const same = this.aim && this.aim.r === hit.r && this.aim.c === hit.c;
      this.aim = { r: hit.r, c: hit.c };
      this.ensureVisible(hit.r, hit.c);
      if (same) {
        if (this.canPlay()) this.tryPlace(hit.r, hit.c);
        return;
      }
      this.render();
    },

    hitCell(x, y, local) {
      const lx = local ? x : x - this.wx;
      const ly = local ? y : y - this.wy;
      if (
        !local &&
        (lx < -this.cs * 2 || ly < -this.cs * 2 || lx > this.ww + this.cs * 2 || ly > this.wh + this.cs * 2)
      ) {
        return null;
      }
      const c = Math.round((lx + this.px - 1) / this.cs);
      const r = Math.round((ly + this.py - 1) / this.cs);
      if (r < 0 || c < 0 || r >= this.boardN || c >= this.boardN) return null;
      return { r: r, c: c };
    },

    touchPoint(evt) {
      const list = evt && (evt.changedTouches || evt.touches);
      const t = list && list[0];
      if (!t) return null;
      const x = t.clientX != null ? t.clientX : t.pageX != null ? t.pageX : t.screenX;
      const y = t.clientY != null ? t.clientY : t.pageY != null ? t.pageY : t.screenY;
      if (x == null || y == null) return null;
      return { x: x, y: y };
    },

    /* ---------------- 方向键微调准星 ---------------- */

    moveAim(dr, dc) {
      const n = this.boardN;
      if (!this.aim) {
        const m = Math.floor(n / 2);
        this.aim = { r: m, c: m };
      } else {
        this.aim = {
          r: clamp(this.aim.r + dr, 0, n - 1),
          c: clamp(this.aim.c + dc, 0, n - 1)
        };
      }
      this.ensureVisible(this.aim.r, this.aim.c);
      this.render();
    },

    nudgeLeft() {
      this.moveAim(0, -1);
    },
    nudgeRight() {
      this.moveAim(0, 1);
    },
    nudgeUp() {
      this.moveAim(-1, 0);
    },
    nudgeDown() {
      this.moveAim(1, 0);
    },

    /* ---------------- AI ---------------- */

    scheduleAi() {
      this.clearAi();
      this.aiTimer = setTimeout(() => {
        this.aiTimer = null;
        if (this.mode !== 'ai' || this.winner !== 0 || this.turn !== WHITE) return;
        const n = this.boardN;
        const idx = chooseMove(this.board, n, WHITE, this.level);
        if (idx < 0) {
          this.winner = -1;
          this.refresh();
          return;
        }
        const r = Math.floor(idx / n);
        const c = idx % n;
        this.commit(r, c);
        this.ensureVisible(r, c);
        this.render();
      }, 320);
    },

    clearAi() {
      if (this.aiTimer) {
        clearTimeout(this.aiTimer);
        this.aiTimer = null;
      }
    },

    /* ---------------- 杂项 ---------------- */

    buzz(strong) {
      try {
        if (vibrator && typeof vibrator.vibrate === 'function') {
          vibrator.vibrate({ mode: strong ? 'long' : 'short' });
        }
      } catch (e) {
        console.log('vibrate failed: ' + e);
      }
    },

    hint(msg) {
      prompt.showToast({ message: msg, duration: 1200 });
    }
  };
</script>