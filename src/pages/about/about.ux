<template>
  <div class="page">
    <div class="header">
      <div class="back" onclick="goBack">
        <text class="back-text">&lt;</text>
      </div>
      <text class="header-title">关于</text>
    </div>

    <scroll class="body" scroll-y="true">
      <div class="doc" style="width: {{ listW }}px;">
        <div class="doc-block">
          <text class="doc-title">环上桌游</text>
          <text class="doc-text">版本 {{ version }}（{{ buildInfo }}）</text>
          <text class="doc-text">腕上桌游合集：把聚会类桌游塞进手表，人多没带牌也能开局。</text>
        </div>

        <div class="doc-block">
          <text class="doc-title">已完成</text>
          <text class="doc-text">五子棋：单人（三档难度 AI）/ 双人同表对战</text>
          <text class="doc-text">UNO：2 ~ 4 人对局（你 + 1~3 个 AI）</text>
          <text class="doc-text">谁是卧底：4 ~ 8 人传阅发词</text>
          <text class="doc-text">规则 / 关于</text>
        </div>

        <div class="doc-block">
          <text class="doc-title">未开发</text>
          <text class="doc-text">大富翁 · 狼人杀 · 扑克牌类 · 三国杀</text>
          <text class="doc-text">菜单里为灰色卡片，点击会提示「开发中」。</text>
        </div>

        <div class="doc-block">
          <text class="doc-title">技术信息</text>
          <text class="doc-text">Xiaomi Vela JS 快应用 · 多尺寸穿戴屏自适应</text>
          <text class="doc-text">局内进度只存在本机，无网络请求、无账号、无遥测。</text>
        </div>
      </div>
    </scroll>
  </div>
</template>

<style>
  @import "../../common/theme.css";

  .body {
    width: 100%;
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
  }
</style>

<script>
  import router from '@system.router';
  import device from '@system.device';

  export default {
    private: {
      listW: 320,
      version: '0.1.0',
      buildInfo: 'Vela 快应用'
    },

    onInit() {
      const app = this.$app && this.$app.$def && this.$app.$def.data;
      if (app && app.version) this.version = app.version;
      device.getInfo({
        success: (ret) => {
          const w = ret && ret.screenWidth;
          if (typeof w === 'number' && w > 0) this.listW = w - 24;
        },
        fail: () => {
          this.listW = 320;
        }
      });
    },

    goBack() {
      router.back();
    }
  };
</script>