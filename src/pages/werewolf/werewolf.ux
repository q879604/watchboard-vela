<template>
  <div class="page">
    <div class="header">
      <div class="back" onclick="onBack">
        <text class="back-text">&lt;</text>
      </div>
      <text class="header-title">狼人杀</text>
    </div>

    <div class="screen" if="{{ stage === 'menu' }}">
      <div class="grow"></div>
      <div class="countbox" style="width: {{ listW }}px;">
        <div class="cbtn" onclick="minus">
          <text class="ctext">－</text>
        </div>
        <text class="cnum">{{ playerCount }} 人</text>
        <div class="cbtn" onclick="plus">
          <text class="ctext">＋</text>
        </div>
      </div>
      <div class="list" style="width: {{ listW }}px;">
        <div class="card" onclick="startGame">
          <text class="card-text">开始游戏（{{ playerCount }} 人）</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="goRules">
          <text class="card-text">玩法说明</text>
          <text class="card-arrow">&gt;</text>
        </div>
      </div>
      <div class="grow"></div>
      <text class="hint">5 ~ 8 人 · 传阅看身份 · 主持人操作夜晚</text>
    </div>

    <div class="screen" if="{{ stage === 'roles' }}">
      <div class="grow"></div>
      <text class="info">{{ holderText }}</text>
      <text class="bigword" if="{{ revealed }}">{{ holderRole }}</text>
      <text class="cover" if="{{ revealed === false }}">身份已隐藏</text>
      <div class="list" style="width: {{ listW }}px;">
        <div class="card" onclick="peekRole" if="{{ revealed === false }}">
          <text class="card-text">点击查看我的身份</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="nextHolder" if="{{ revealed }}">
          <text class="card-text">{{ nextLabel }}</text>
          <text class="card-arrow">&gt;</text>
        </div>
      </div>
      <div class="grow"></div>
      <text class="hint">看完交给下一位，别让人看到</text>
    </div>

    <div class="screen" if="{{ stage === 'night' || stage === 'day' }}">
      <text class="info">{{ nightTitle || dayTitle }}</text>
      <text class="sub">{{ nightInfo || dayInfo }}</text>

      <div class="grow"></div>

      <div class="slots">
        <div class="srow">
          <div class="{{ c0 }}" onclick="tgt0">
            <text class="{{ c0c }}">{{ c0t }}</text>
          </div>
          <div class="{{ c1 }}" onclick="tgt1">
            <text class="{{ c1c }}">{{ c1t }}</text>
          </div>
          <div class="{{ c2 }}" onclick="tgt2">
            <text class="{{ c2c }}">{{ c2t }}</text>
          </div>
          <div class="{{ c3 }}" onclick="tgt3">
            <text class="{{ c3c }}">{{ c3t }}</text>
          </div>
        </div>
        <div class="srow">
          <div class="{{ c4 }}" onclick="tgt4">
            <text class="{{ c4c }}">{{ c4t }}</text>
          </div>
          <div class="{{ c5 }}" onclick="tgt5">
            <text class="{{ c5c }}">{{ c5t }}</text>
          </div>
          <div class="{{ c6 }}" onclick="tgt6">
            <text class="{{ c6c }}">{{ c6t }}</text>
          </div>
          <div class="{{ c7 }}" onclick="tgt7">
            <text class="{{ c7c }}">{{ c7t }}</text>
          </div>
        </div>
      </div>

      <div class="ops">
        <div class="btn btn-main" onclick="confirmAction" if="{{ stage === 'night' && (nightStep === 'wolf' || nightStep === 'seer') && !seerDone }}">
          <text class="bt bt-main">确认</text>
        </div>
        <div class="btn" onclick="nextNightStep" if="{{ stage === 'night' && nightStep === 'seer' && seerDone }}">
          <text class="bt">下一步</text>
        </div>
        <div class="btn" onclick="witchSave" if="{{ stage === 'night' && nightStep === 'witch' }}">
          <text class="bt">解药</text>
        </div>
        <div class="btn" onclick="witchPoison" if="{{ stage === 'night' && nightStep === 'witch' }}">
          <text class="bt">毒药</text>
        </div>
        <div class="btn" onclick="witchSkip" if="{{ stage === 'night' && nightStep === 'witch' }}">
          <text class="bt">跳过</text>
        </div>
        <div class="btn btn-main" onclick="confirmVote" if="{{ stage === 'day' && voting }}">
          <text class="bt bt-main">投给他</text>
        </div>
        <div class="btn btn-main" onclick="goNight" if="{{ stage === 'day' && voting === false }}">
          <text class="bt bt-main">进入夜晚</text>
        </div>
      </div>
      <text class="hint">{{ voteHint }}</text>
    </div>

    <div class="overlay" if="{{ over }}">
      <text class="overtext">{{ overText }}</text>
      <div class="ops">
        <div class="btn btn-main" onclick="startGame">
          <text class="bt bt-main">再来一局</text>
        </div>
        <div class="btn" onclick="onBack">
          <text class="bt">返回</text>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  @import "../../common/theme.css";

  .bigword {
    font-size: 46px;
    font-weight: bold;
    color: #ffffff;
    margin-top: 12px;
    margin-bottom: 18px;
  }

  .cover {
    font-size: 24px;
    font-weight: bold;
    color: #d8f5d8;
    margin-top: 14px;
    margin-bottom: 20px;
  }
</style>

<script>
  import router from '@system.router';
  import device from '@system.device';
  import prompt from '@system.prompt';
  import {
    ROLE_LABELS,
    createGame,
    aliveList,
    nightWolf,
    nightSeer,
    nightWitch,
    resolveNight,
    resolveVote,
    checkEnd,
    wolfIdxOf,
    seerIdxOf
  } from '../../common/werewolf';
  import { defaultNames } from '../../common/setup';

  export default {
    private: {
      stage: 'menu',
      game: null,
      playerCount: 6,
      listW: 320,

      holder: 1,
      holderText: '第 1 位玩家',
      revealed: false,
      holderRole: '',
      nextLabel: '下一位',

      nightStep: 'wolf',
      nightTitle: '',
      nightInfo: '',
      seerDone: false,
      pick: -1,

      dayTitle: '',
      dayInfo: '',
      voting: false,
      voter: -1,
      voteList: [],
      votes: [],
      voteHint: '',

      over: false,
      overText: '',
      names: [],

      c0: 'chip chip-empty', c0t: '', c0c: 'chiptext-dim',
      c1: 'chip chip-empty', c1t: '', c1c: 'chiptext-dim',
      c2: 'chip chip-empty', c2t: '', c2c: 'chiptext-dim',
      c3: 'chip chip-empty', c3t: '', c3c: 'chiptext-dim',
      c4: 'chip chip-empty', c4t: '', c4c: 'chiptext-dim',
      c5: 'chip chip-empty', c5t: '', c5c: 'chiptext-dim',
      c6: 'chip chip-empty', c6t: '', c6c: 'chiptext-dim',
      c7: 'chip chip-empty', c7t: '', c7c: 'chiptext-dim',
      ids: [-1, -1, -1, -1, -1, -1, -1, -1]
    },

    onInit() {
      device.getInfo({
        success: (ret) => {
          const w = ret && ret.screenWidth;
          if (typeof w === 'number' && w > 0) this.listW = w - 24;
        },
        fail: () => {
          this.listW = 320;
        }
      });
    },

    onBackPress() {
      return this.stage === 'roles' || this.stage === 'night' || this.stage === 'day';
    },

    minus() {
      if (this.playerCount > 5) this.playerCount--;
    },

    plus() {
      if (this.playerCount < 8) this.playerCount++;
    },

    startGame() {
      this.game = createGame(this.playerCount);
      this.names = defaultNames(this.playerCount);
      this.over = false;
      this.holder = 1;
      this.holderText = '第 1 位玩家（' + this.nm(0) + '）';
      this.revealed = false;
      this.holderRole = '';
      this.nextLabel = this.playerCount > 1 ? '下一位' : '进入夜晚';
      this.stage = 'roles';
      this.renderSlots();
    },

    nm(i) {
      return this.names[i] || (i + 1) + '号';
    },

    peekRole() {
      const g = this.game;
      this.holderRole = ROLE_LABELS[g.players[this.holder - 1].role];
      this.revealed = true;
    },

    nextHolder() {
      if (this.holder >= this.playerCount) {
        this.stage = 'night';
        this.nightStep = 'wolf';
        this.pick = -1;
        this.seerDone = false;
        this.renderSlots();
        return;
      }
      this.holder++;
      this.holderText = '第 ' + this.holder + ' 位玩家（' + this.nm(this.holder - 1) + '）';
      this.revealed = false;
      this.nextLabel = this.holder >= this.playerCount ? '进入夜晚' : '下一位';
    },

    /* ---------------- 玩家格 ---------------- */

    renderSlots() {
      const g = this.game;
      if (!g) return;
      const ids = [-1, -1, -1, -1, -1, -1, -1, -1];
      for (let k = 0; k < 8; k++) {
        if (k < this.playerCount) {
          const p = g.players[k];
          const sel = this.pick === k;
          ids[k] = k;
          this['c' + k] = !p.alive ? 'chip chip-dead' : sel ? 'chip chip-sel' : 'chip';
          this['c' + k + 't'] = this.nm(k) + (p.alive ? ' ♥' + p.hp : ' 亡');
          this['c' + k + 'c'] = !p.alive ? 'chiptext-dim' : 'chiptext';
        } else {
          ids[k] = -1;
          this['c' + k] = 'chip chip-empty';
          this['c' + k + 't'] = '';
          this['c' + k + 'c'] = 'chiptext-dim';
        }
      }
      this.ids = ids;
      this.refreshTitles();
    },

    tapSlot(k) {
      const g = this.game;
      const id = this.ids[k];
      if (!g || id == null || id < 0) return;
      const p = g.players[id];
      if (!p.alive) return;
      if (this.stage === 'night') {
        if (this.nightStep === 'wolf' && id === wolfIdxOf(g)) return;
        if (this.nightStep === 'seer' && id === seerIdxOf(g)) return;
        if (this.nightStep === 'seer' && this.seerDone) return;
      } else if (this.stage === 'day') {
        if (!this.voting) return;
        if (id === this.voter) return;
      }
      this.pick = id;
      this.renderSlots();
    },

    tgt0() {
      this.tapSlot(0);
    },
    tgt1() {
      this.tapSlot(1);
    },
    tgt2() {
      this.tapSlot(2);
    },
    tgt3() {
      this.tapSlot(3);
    },
    tgt4() {
      this.tapSlot(4);
    },
    tgt5() {
      this.tapSlot(5);
    },
    tgt6() {
      this.tapSlot(6);
    },
    tgt7() {
      this.tapSlot(7);
    },

    refreshTitles() {
      const g = this.game;
      if (!g) return;
      if (this.stage === 'night') {
        this.dayTitle = '';
        if (this.nightStep === 'wolf') {
          this.nightTitle = '夜晚 · 狼人行动';
          this.nightInfo = '点选要刀的玩家，再点「确认」';
        } else if (this.nightStep === 'seer') {
          this.nightTitle = '夜晚 · 预言家行动';
          this.nightInfo = this.seerDone ? g.seerResult : '点选要查验的玩家，再点「确认」';
        } else {
          this.nightTitle = '夜晚 · 女巫行动';
          const canSave = g.witchHasSave && g.wolfTarget >= 0;
          this.nightInfo =
            (canSave ? '今晚有人被杀' : '今晚无人被杀 / 解药已用') +
            (g.witchHasPoison ? ' · 毒药需先点人' : '');
        }
      } else if (this.stage === 'day') {
        this.nightTitle = '';
        this.dayTitle = '白天 · 第 ' + g.round + ' 轮';
        this.voteHint = this.voting ? this.nm(this.voter) + ' 投票（不能投自己）' : '点「进入夜晚」继续';
      } else {
        this.voteHint = '';
      }
    },

    /* ---------------- 夜晚 ---------------- */

    confirmAction() {
      const g = this.game;
      if (this.pick < 0) {
        this.hint('先点选一个玩家');
        return;
      }
      if (this.nightStep === 'wolf') {
        const r = nightWolf(g, this.pick);
        if (!r.ok) {
          this.hint(r.msg);
          return;
        }
        this.pick = -1;
        this.nightStep = 'seer';
        this.renderSlots();
      } else if (this.nightStep === 'seer') {
        const r = nightSeer(g, this.pick);
        if (!r.ok) {
          this.hint(r.msg);
          return;
        }
        this.seerDone = true;
        this.pick = -1;
        this.renderSlots();
      }
    },

    nextNightStep() {
      this.seerDone = false;
      this.nightStep = 'witch';
      this.renderSlots();
    },

    witchSave() {
      const r = nightWitch(this.game, 'save');
      if (!r.ok) {
        this.hint(r.msg);
        return;
      }
      this.dawn();
    },

    witchPoison() {
      const g = this.game;
      if (this.pick < 0) {
        this.hint('先点要毒的玩家');
        return;
      }
      const r = nightWitch(g, 'poison', this.pick);
      if (!r.ok) {
        this.hint(r.msg);
        return;
      }
      this.dawn();
    },

    witchSkip() {
      nightWitch(this.game, 'skip');
      this.dawn();
    },

    dawn() {
      const g = this.game;
      const deaths = resolveNight(g);
      this.dayInfo =
        deaths.length === 0
          ? '昨晚是平安夜'
          : '昨晚 ' + deaths.map((d) => d + 1).join('、') + ' 号死亡';
      const end = checkEnd(g);
      if (end) {
        this.finish(end);
        return;
      }
      this.stage = 'day';
      this.votes = [];
      this.voteList = aliveList(g);
      this.voter = this.voteList.length ? this.voteList[0] : -1;
      this.voting = this.voter >= 0;
      this.pick = -1;
      this.renderSlots();
    },

    /* ---------------- 白天投票 ---------------- */

    confirmVote() {
      const g = this.game;
      if (this.pick < 0) {
        this.hint('先点投谁');
        return;
      }
      this.votes.push({ from: this.voter, to: this.pick });
      this.pick = -1;
      const idx = this.voteList.indexOf(this.voter);
      if (idx >= 0 && idx < this.voteList.length - 1) {
        this.voter = this.voteList[idx + 1];
        this.renderSlots();
        return;
      }
      const dead = resolveVote(g, this.votes);
      this.voting = false;
      this.dayInfo =
        dead >= 0
          ? (this.dayInfo || '') + ' · ' + (dead + 1) + ' 号被投出局'
          : (this.dayInfo || '') + ' · 平票，无人出局';
      const end = checkEnd(g);
      if (end) {
        this.finish(end);
        return;
      }
      this.renderSlots();
    },

    goNight() {
      this.stage = 'night';
      this.nightStep = 'wolf';
      this.pick = -1;
      this.seerDone = false;
      this.renderSlots();
    },

    finish(end) {
      this.over = true;
      this.overText = end === 'wolf' ? '狼人阵营获胜！' : '好人阵营获胜！';
    },

    onBack() {
      if (this.stage !== 'menu') {
        this.stage = 'menu';
        this.over = false;
        return;
      }
      router.back();
    },

    goRules() {
      router.push({ uri: '/pages/rules' });
    },

    hint(msg) {
      prompt.showToast({ message: msg, duration: 1200 });
    }
  };
</script>