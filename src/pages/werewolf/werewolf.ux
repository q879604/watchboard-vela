<template>
  <div class="page">
    <div class="header">
      <div class="back" onclick="onBack">
        <text class="back-text">&lt;</text>
      </div>
      <text class="header-title">狼人杀</text>
    </div>

    <!-- 菜单 -->
    <div class="screen" if="{{ stage === 'menu' }}">
      <div class="countbox" style="width: {{ listW }}px;">
        <div class="cbtn" onclick="minus">
          <text class="ctext">－</text>
        </div>
        <text class="cnum">{{ playerCount }} 人</text>
        <div class="cbtn" onclick="plus">
          <text class="ctext">＋</text>
        </div>
      </div>
      <div class="list" style="width: {{ listW }}px;">
        <div class="card" onclick="startGame">
          <text class="card-text">开始游戏（{{ playerCount }} 人）</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="goRules">
          <text class="card-text">玩法说明</text>
          <text class="card-arrow">&gt;</text>
        </div>
      </div>
      <text class="hint">5 ~ 8 人：狼人 1~2 · 预言家 · 女巫 · 其余平民</text>
      <text class="hint">依次传阅看身份，夜晚由主持人操作</text>
    </div>

    <!-- 身份传阅 -->
    <div class="screen" if="{{ stage === 'roles' }}">
      <text class="step">{{ holderText }}</text>
      <text class="bigword" if="{{ revealed }}">{{ holderRole }}</text>
      <text class="cover" if="{{ revealed === false }}">身份已隐藏</text>
      <div class="list" style="width: {{ listW }}px;">
        <div class="card" onclick="peekRole" if="{{ revealed === false }}">
          <text class="card-text">点击查看我的身份</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="nextHolder" if="{{ revealed }}">
          <text class="card-text">{{ nextLabel }}</text>
          <text class="card-arrow">&gt;</text>
        </div>
      </div>
      <text class="hint">看完交给下一位，不要让别人看到</text>
    </div>

    <!-- 夜晚 / 白天 共用玩家格子 -->
    <div class="screen" if="{{ stage === 'night' || stage === 'day' }}">
      <text class="step">{{ nightTitle || dayTitle }}</text>
      <text class="info">{{ nightInfo || dayInfo }}</text>

      <div class="chipwrap">
        <div class="chip {{ c0cls }}" style="left: {{ q0x }}px; top: {{ q0y }}px; width: {{ cw2 }}px; height: {{ ch2 }}px;" onclick="tgt0" if="{{ has0 }}">
          <text class="chiptext {{ c0tcls }}">{{ c0t }}</text>
        </div>
        <div class="chip {{ c1cls }}" style="left: {{ q1x }}px; top: {{ q1y }}px; width: {{ cw2 }}px; height: {{ ch2 }}px;" onclick="tgt1" if="{{ has1 }}">
          <text class="chiptext {{ c1tcls }}">{{ c1t }}</text>
        </div>
        <div class="chip {{ c2cls }}" style="left: {{ q2x }}px; top: {{ q2y }}px; width: {{ cw2 }}px; height: {{ ch2 }}px;" onclick="tgt2" if="{{ has2 }}">
          <text class="chiptext {{ c2tcls }}">{{ c2t }}</text>
        </div>
        <div class="chip {{ c3cls }}" style="left: {{ q3x }}px; top: {{ q3y }}px; width: {{ cw2 }}px; height: {{ ch2 }}px;" onclick="tgt3" if="{{ has3 }}">
          <text class="chiptext {{ c3tcls }}">{{ c3t }}</text>
        </div>
        <div class="chip {{ c4cls }}" style="left: {{ q4x }}px; top: {{ q4y }}px; width: {{ cw2 }}px; height: {{ ch2 }}px;" onclick="tgt4" if="{{ has4 }}">
          <text class="chiptext {{ c4tcls }}">{{ c4t }}</text>
        </div>
        <div class="chip {{ c5cls }}" style="left: {{ q5x }}px; top: {{ q5y }}px; width: {{ cw2 }}px; height: {{ ch2 }}px;" onclick="tgt5" if="{{ has5 }}">
          <text class="chiptext {{ c5tcls }}">{{ c5t }}</text>
        </div>
        <div class="chip {{ c6cls }}" style="left: {{ q6x }}px; top: {{ q6y }}px; width: {{ cw2 }}px; height: {{ ch2 }}px;" onclick="tgt6" if="{{ has6 }}">
          <text class="chiptext {{ c6tcls }}">{{ c6t }}</text>
        </div>
        <div class="chip {{ c7cls }}" style="left: {{ q7x }}px; top: {{ q7y }}px; width: {{ cw2 }}px; height: {{ ch2 }}px;" onclick="tgt7" if="{{ has7 }}">
          <text class="chiptext {{ c7tcls }}">{{ c7t }}</text>
        </div>
      </div>

      <div class="ops" style="top: {{ opsY }}px;">
        <div class="btn btn-main" onclick="confirmAction" if="{{ stage === 'night' && (nightStep === 'wolf' || nightStep === 'seer') && !seerDone }}">
          <text class="bt bt-main">确认</text>
        </div>
        <div class="btn" onclick="nextNightStep" if="{{ stage === 'night' && nightStep === 'seer' && seerDone }}">
          <text class="bt">下一步</text>
        </div>
        <div class="btn" onclick="witchSave" if="{{ stage === 'night' && nightStep === 'witch' }}">
          <text class="bt">解药</text>
        </div>
        <div class="btn" onclick="witchPoison" if="{{ stage === 'night' && nightStep === 'witch' }}">
          <text class="bt">毒药</text>
        </div>
        <div class="btn" onclick="witchSkip" if="{{ stage === 'night' && nightStep === 'witch' }}">
          <text class="bt">跳过</text>
        </div>
        <div class="btn btn-main" onclick="confirmVote" if="{{ stage === 'day' && voting }}">
          <text class="bt bt-main">投给他</text>
        </div>
        <div class="btn btn-main" onclick="goNight" if="{{ stage === 'day' && voting === false }}">
          <text class="bt bt-main">进入夜晚</text>
        </div>
      </div>
      <text class="hint">{{ voteHint }}</text>
    </div>

    <!-- 结算 -->
    <div class="overlay" if="{{ over }}">
      <text class="overtext">{{ overText }}</text>
      <div class="ops2">
        <div class="btn" onclick="startGame">
          <text class="bt">再来一局</text>
        </div>
        <div class="btn" onclick="onBack">
          <text class="bt">返回</text>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  @import "../../common/theme.css";

  .screen {
    width: 100%;
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
  }

  .step {
    font-size: 19px;
    font-weight: bold;
    color: #ffffff;
    margin-top: 8px;
    margin-bottom: 4px;
  }

  .info {
    font-size: 16px;
    color: #eaffea;
    margin-bottom: 8px;
  }

  .bigword {
    font-size: 44px;
    font-weight: bold;
    color: #ffffff;
    margin-top: 12px;
    margin-bottom: 18px;
  }

  .cover {
    font-size: 24px;
    font-weight: bold;
    color: #d8f5d8;
    margin-top: 14px;
    margin-bottom: 20px;
  }

  .countbox {
    height: 60px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(255, 255, 255, 0.94);
    border-radius: 14px;
    padding-left: 10px;
    padding-right: 10px;
    margin-bottom: 12px;
  }

  .cbtn {
    width: 56px;
    height: 44px;
    border-radius: 12px;
    background-color: #17331d;
    justify-content: center;
    align-items: center;
  }

  .ctext {
    font-size: 24px;
    font-weight: bold;
    color: #ffffff;
  }

  .cnum {
    font-size: 26px;
    font-weight: bold;
    color: #17331d;
  }

  .chipwrap {
    position: relative;
    width: 100%;
    height: 150px;
  }

  .chip {
    position: absolute;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.94);
    justify-content: center;
    align-items: center;
  }

  .chip-sel {
    background-color: #2f9e44;
  }

  .chip-dead {
    background-color: rgba(255, 255, 255, 0.35);
  }

  .chiptext {
    font-size: 17px;
    font-weight: bold;
    color: #17331d;
  }

  .chip-seltext {
    color: #ffffff;
  }

  .chip-deadtext {
    color: #5d6b60;
  }
</style>

<script>
  import router from '@system.router';
  import device from '@system.device';
  import prompt from '@system.prompt';
  import {
    ROLE_LABELS,
    createGame,
    aliveList,
    nightWolf,
    nightSeer,
    nightWitch,
    resolveNight,
    resolveVote,
    checkEnd,
    wolfIdxOf,
    seerIdxOf
  } from '../../common/werewolf';

  const TCOLS = 4;
  const OPS_H = 46;

  export default {
    private: {
      stage: 'menu', // menu | roles | night | day | over
      game: null,
      playerCount: 6,
      listW: 320,

      holder: 1,
      holderText: '第 1 位玩家',
      revealed: false,
      holderRole: '',
      nextLabel: '下一位',

      nightStep: 'wolf',
      nightTitle: '',
      nightInfo: '',
      seerDone: false,
      pick: -1,

      dayTitle: '',
      dayInfo: '',
      voting: false,
      voter: -1,
      voteList: [],
      votes: [],
      voteHint: '',

      over: false,
      overText: '',

      cw2: 74,
      ch2: 56,
      q0x: 0, q0y: 0, q1x: 0, q1y: 0, q2x: 0, q2y: 0, q3x: 0, q3y: 0,
      q4x: 0, q4y: 0, q5x: 0, q5y: 0, q6x: 0, q6y: 0, q7x: 0, q7y: 0,
      c0t: '', c1t: '', c2t: '', c3t: '', c4t: '', c5t: '', c6t: '', c7t: '',
      c0cls: 'chip', c1cls: 'chip', c2cls: 'chip', c3cls: 'chip',
      c4cls: 'chip', c5cls: 'chip', c6cls: 'chip', c7cls: 'chip',
      c0tcls: '', c1tcls: '', c2tcls: '', c3tcls: '', c4tcls: '', c5tcls: '', c6tcls: '', c7tcls: '',
      has0: false, has1: false, has2: false, has3: false,
      has4: false, has5: false, has6: false, has7: false,
      slotIds: [-1, -1, -1, -1, -1, -1, -1, -1],
      opsY: 420
    },

    onInit() {
      device.getInfo({
        success: (ret) => {
          this.applyLayout((ret && ret.screenWidth) || 336, (ret && ret.screenHeight) || 480);
        },
        fail: () => {
          this.applyLayout(336, 480);
        }
      });
    },

    onBackPress() {
      return this.stage === 'roles' || this.stage === 'night' || this.stage === 'day';
    },

    applyLayout(w, h) {
      const cw2 = Math.floor((w - 60) / TCOLS);
      const ch2 = Math.max(48, Math.floor(cw2 * 0.7));
      const gw2 = TCOLS * cw2 + (TCOLS - 1) * 8;
      const gx2 = Math.floor((w - gw2) / 2);
      const gy2 = 150;
      this.cw2 = cw2;
      this.ch2 = ch2;
      for (let i = 0; i < 8; i++) {
        this['q' + i + 'x'] = gx2 + (i % TCOLS) * (cw2 + 8);
        this['q' + i + 'y'] = gy2 + Math.floor(i / TCOLS) * (ch2 + 8);
      }
      this.opsY = h - OPS_H - 34;
      this.listW = w - 24;
      if (this.game) this.renderSlots();
    },

    /* ---------------- 菜单 / 传阅 ---------------- */

    startGame() {
      this.game = createGame(this.playerCount);
      this.over = false;
      this.holder = 1;
      this.holderText = '第 1 位玩家';
      this.revealed = false;
      this.holderRole = '';
      this.nextLabel = this.playerCount > 1 ? '下一位' : '进入夜晚';
      this.stage = 'roles';
      this.renderSlots();
    },

    minus() {
      if (this.playerCount > 5) this.playerCount--;
    },

    plus() {
      if (this.playerCount < 8) this.playerCount++;
    },

    peekRole() {
      const g = this.game;
      this.holderRole = ROLE_LABELS[g.players[this.holder - 1].role];
      this.revealed = true;
    },

    nextHolder() {
      if (this.holder >= this.playerCount) {
        this.stage = 'night';
        this.nightStep = 'wolf';
        this.pick = -1;
        this.seerDone = false;
        this.renderSlots();
        return;
      }
      this.holder++;
      this.holderText = '第 ' + this.holder + ' 位玩家';
      this.revealed = false;
      this.nextLabel = this.holder >= this.playerCount ? '进入夜晚' : '下一位';
    },

    /* ---------------- 玩家格子（原生点击） ---------------- */

    renderSlots() {
      const g = this.game;
      if (!g) return;
      const ids = [-1, -1, -1, -1, -1, -1, -1, -1];
      for (let i = 0; i < this.playerCount && i < 8; i++) {
        const p = g.players[i];
        let cls = 'chip';
        if (!p.alive) cls = 'chip chip-dead';
        if (this.pick === i) cls = 'chip chip-sel';
        const isSel = this.pick === i;
        ids[i] = i;
        this['c' + i + 't'] = (i + 1) + '号' + (p.alive ? ' ♥' + p.hp : ' 出局');
        this['c' + i + 'cls'] = cls;
        this['c' + i + 'tcls'] = isSel ? 'chip-seltext' : p.alive ? '' : 'chip-deadtext';
        this['has' + i] = true;
      }
      for (let i = this.playerCount; i < 8; i++) {
        this['has' + i] = false;
      }
      this.slotIds = ids;
      this.refreshTitles();
    },

    tapSlot(k) {
      const g = this.game;
      if (!g) return;
      const id = this.slotIds[k];
      if (id == null || id < 0) return;
      const p = g.players[id];
      if (!p.alive) return;
      if (this.stage === 'night') {
        if (this.nightStep === 'wolf' && id === wolfIdxOf(g)) return;
        if (this.nightStep === 'seer' && id === seerIdxOf(g)) return;
        if (this.nightStep === 'seer' && this.seerDone) return;
      } else if (this.stage === 'day') {
        if (!this.voting) return;
        if (id === this.voter) return;
      }
      this.pick = id;
      this.renderSlots();
    },

    tgt0() {
      this.tapSlot(0);
    },
    tgt1() {
      this.tapSlot(1);
    },
    tgt2() {
      this.tapSlot(2);
    },
    tgt3() {
      this.tapSlot(3);
    },
    tgt4() {
      this.tapSlot(4);
    },
    tgt5() {
      this.tapSlot(5);
    },
    tgt6() {
      this.tapSlot(6);
    },
    tgt7() {
      this.tapSlot(7);
    },

    refreshTitles() {
      const g = this.game;
      if (!g) return;
      if (this.stage === 'night') {
        this.dayTitle = '';
        if (this.nightStep === 'wolf') {
          this.nightTitle = '夜晚 · 狼人行动';
          this.nightInfo = '点选要刀的玩家（不能选狼人自己）';
        } else if (this.nightStep === 'seer') {
          this.nightTitle = '夜晚 · 预言家行动';
          this.nightInfo = this.seerDone ? g.seerResult : '点选要查验的玩家';
        } else {
          this.nightTitle = '夜晚 · 女巫行动';
          const canSave = g.witchHasSave && g.wolfTarget >= 0;
          this.nightInfo =
            (canSave ? '今晚有人被杀，可用解药' : '今晚无人被杀 / 解药已用') +
            (g.witchHasPoison ? ' · 可用毒药（先点人再点毒药）' : '');
        }
      } else if (this.stage === 'day') {
        this.nightTitle = '';
        this.dayTitle = '白天 · 第 ' + g.round + ' 轮';
        this.voteHint = this.voting ? (this.voter + 1) + '号 投票（不能投自己）' : '投票完成，点「进入夜晚」';
      } else {
        this.voteHint = '';
      }
    },

    /* ---------------- 夜晚 ---------------- */

    confirmAction() {
      const g = this.game;
      if (this.pick < 0) {
        this.hint('先点选一个玩家');
        return;
      }
      if (this.nightStep === 'wolf') {
        const r = nightWolf(g, this.pick);
        if (!r.ok) {
          this.hint(r.msg);
          return;
        }
        this.pick = -1;
        this.nightStep = 'seer';
        this.renderSlots();
      } else if (this.nightStep === 'seer') {
        const r = nightSeer(g, this.pick);
        if (!r.ok) {
          this.hint(r.msg);
          return;
        }
        this.seerDone = true;
        this.pick = -1;
        this.renderSlots();
      }
    },

    nextNightStep() {
      this.seerDone = false;
      this.nightStep = 'witch';
      this.renderSlots();
    },

    witchSave() {
      const g = this.game;
      const r = nightWitch(g, 'save');
      if (!r.ok) {
        this.hint(r.msg);
        return;
      }
      this.nightInfo = '解药已使用';
      this.dawn();
    },

    witchPoison() {
      const g = this.game;
      if (this.pick < 0) {
        this.hint('先点要毒的玩家');
        return;
      }
      const r = nightWitch(g, 'poison', this.pick);
      if (!r.ok) {
        this.hint(r.msg);
        return;
      }
      this.dawn();
    },

    witchSkip() {
      nightWitch(this.game, 'skip');
      this.dawn();
    },

    dawn() {
      const g = this.game;
      const deaths = resolveNight(g);
      if (deaths.length === 0) this.dayInfo = '昨晚是平安夜';
      else this.dayInfo = '昨晚 ' + deaths.map((d) => d + 1).join('、') + ' 号死亡';
      const end = checkEnd(g);
      if (end) {
        this.finish(end);
        return;
      }
      this.stage = 'day';
      this.votes = [];
      this.voteList = aliveList(g);
      this.voter = this.voteList.length ? this.voteList[0] : -1;
      this.voting = this.voter >= 0;
      this.pick = -1;
      this.renderSlots();
    },

    /* ---------------- 白天投票 ---------------- */

    confirmVote() {
      const g = this.game;
      if (this.pick < 0) {
        this.hint('先点投谁');
        return;
      }
      this.votes.push({ from: this.voter, to: this.pick });
      this.pick = -1;
      const idx = this.voteList.indexOf(this.voter);
      if (idx >= 0 && idx < this.voteList.length - 1) {
        this.voter = this.voteList[idx + 1];
        this.renderSlots();
        return;
      }
      const dead = resolveVote(g, this.votes);
      this.voting = false;
      if (dead >= 0) this.dayInfo = (this.dayInfo || '') + ' · ' + (dead + 1) + ' 号 被投票出局';
      else this.dayInfo = (this.dayInfo || '') + ' · 平票，无人出局';
      const end = checkEnd(g);
      if (end) {
        this.finish(end);
        return;
      }
      this.renderSlots();
    },

    goNight() {
      this.stage = 'night';
      this.nightStep = 'wolf';
      this.pick = -1;
      this.seerDone = false;
      this.renderSlots();
    },

    finish(end) {
      this.over = true;
      this.overText = end === 'wolf' ? '狼人阵营获胜！' : '好人阵营获胜！';
    },

    onBack() {
      if (this.stage !== 'menu') {
        this.stage = 'menu';
        this.over = false;
        return;
      }
      router.back();
    },

    goRules() {
      router.push({ uri: '/pages/rules' });
    },

    hint(msg) {
      prompt.showToast({ message: msg, duration: 1200 });
    }
  };
</script>