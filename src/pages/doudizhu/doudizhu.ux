<template>
  <div class="page">
    <div class="header">
      <div class="back" onclick="onBack">
        <text class="back-text">&lt;</text>
      </div>
      <text class="header-title">斗地主</text>
    </div>

    <div class="screen" if="{{ stage === 'menu' }}">
      <div class="grow"></div>
      <div class="list" style="width: {{ listW }}px;">
        <div class="card" onclick="startAi">
          <text class="card-text">对战 AI（你 + 2 AI）</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="startHotseat">
          <text class="card-text">同表多人（3 人轮流）</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="goRules">
          <text class="card-text">玩法说明</text>
          <text class="card-arrow">&gt;</text>
        </div>
      </div>
      <div class="grow"></div>
      <text class="hint">同表多人：三家轮流，把表递给下一位</text>
    </div>

    <div class="screen" if="{{ stage === 'play' }}">
      <text class="nowchip {{ nowCls }}">{{ nowName }}</text>
      <text class="info">{{ topLine }}</text>
      <text class="sub">{{ hist }}</text>
      <text class="sub">{{ botLine }}</text>
      <text class="sub">{{ pendingText }}</text>

      <div class="grow"></div>

      <div class="hand">
        <div class="hrow">
          <div class="{{ s0 }}" onclick="pick0">
            <text class="{{ s0c }}">{{ s0t }}</text>
          </div>
          <div class="{{ s1 }}" onclick="pick1">
            <text class="{{ s1c }}">{{ s1t }}</text>
          </div>
          <div class="{{ s2 }}" onclick="pick2">
            <text class="{{ s2c }}">{{ s2t }}</text>
          </div>
          <div class="{{ s3 }}" onclick="pick3">
            <text class="{{ s3c }}">{{ s3t }}</text>
          </div>
          <div class="{{ s4 }}" onclick="pick4">
            <text class="{{ s4c }}">{{ s4t }}</text>
          </div>
          <div class="{{ s5 }}" onclick="pick5">
            <text class="{{ s5c }}">{{ s5t }}</text>
          </div>
        </div>
        <div class="hrow">
          <div class="{{ s6 }}" onclick="pick6">
            <text class="{{ s6c }}">{{ s6t }}</text>
          </div>
          <div class="{{ s7 }}" onclick="pick7">
            <text class="{{ s7c }}">{{ s7t }}</text>
          </div>
          <div class="{{ s8 }}" onclick="pick8">
            <text class="{{ s8c }}">{{ s8t }}</text>
          </div>
          <div class="{{ s9 }}" onclick="pick9">
            <text class="{{ s9c }}">{{ s9t }}</text>
          </div>
          <div class="{{ s10 }}" onclick="pick10">
            <text class="{{ s10c }}">{{ s10t }}</text>
          </div>
          <div class="{{ s11 }}" onclick="pick11">
            <text class="{{ s11c }}">{{ s11t }}</text>
          </div>
        </div>
      </div>

      <div class="ops">
        <div class="btn btn-main" onclick="doPlay">
          <text class="bt bt-main">出牌</text>
        </div>
        <div class="btn" onclick="doPass" if="{{ hasPending }}">
          <text class="bt">不出</text>
        </div>
        <div class="btn btn-s" onclick="pagePrev" if="{{ pagerOn }}">
          <text class="bt">上页</text>
        </div>
        <div class="btn btn-s" onclick="pageNext" if="{{ pagerOn }}">
          <text class="bt">下页</text>
        </div>
      </div>
    </div>

    <!-- 同表多人：交接遮罩 -->
    <div class="overlay" if="{{ cover }}">
      <text class="overtext">{{ coverText }}</text>
      <div class="ops">
        <div class="btn btn-main" onclick="revealHand">
          <text class="bt bt-main">查看手牌</text>
        </div>
      </div>
    </div>

    <div class="overlay" if="{{ over }}">
      <text class="overtext">{{ overText }}</text>
      <div class="ops">
        <div class="btn btn-main" onclick="restart">
          <text class="bt bt-main">再来一局</text>
        </div>
        <div class="btn" onclick="onBack">
          <text class="bt">返回</text>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  @import "../../common/theme.css";
</style>

<script>
  import router from '@system.router';
  import device from '@system.device';
  import prompt from '@system.prompt';
  import { deal, cardText, parsePlay, beats, findPlay } from '../../common/doudizhu';
  import { defaultNames, colorOf } from '../../common/setup';

  const SLOTS = 12;

  const TYPE_NAME = {
    single: '单张',
    pair: '对子',
    triple: '三张',
    triple1: '三带一',
    triple2: '三带二',
    straight: '顺子',
    pairrun: '连对',
    bomb: '炸弹',
    rocket: '火箭'
  };

  export default {
    private: {
      stage: 'menu',
      mode: 'ai', // ai | hotseat
      listW: 320,

      hands: [],
      bottom: [],
      landlord: -1,
      cur: 0,
      viewer: 0,
      cover: false,
      coverText: '',
      pending: null,
      passStreak: 0,
      hasPending: false,
      over: false,
      overText: '',

      sel: [],
      page: 0,
      pagerOn: false,
      names: [],
      colors: [],
      nowName: '',
      nowCls: 'nowchip pc-r',
      hist: '',
      topLine: '',
      botLine: '',
      pendingText: '',

      s0: 'tile tile-dim', s0t: '', s0c: 'tiletext-dim',
      s1: 'tile tile-dim', s1t: '', s1c: 'tiletext-dim',
      s2: 'tile tile-dim', s2t: '', s2c: 'tiletext-dim',
      s3: 'tile tile-dim', s3t: '', s3c: 'tiletext-dim',
      s4: 'tile tile-dim', s4t: '', s4c: 'tiletext-dim',
      s5: 'tile tile-dim', s5t: '', s5c: 'tiletext-dim',
      s6: 'tile tile-dim', s6t: '', s6c: 'tiletext-dim',
      s7: 'tile tile-dim', s7t: '', s7c: 'tiletext-dim',
      s8: 'tile tile-dim', s8t: '', s8c: 'tiletext-dim',
      s9: 'tile tile-dim', s9t: '', s9c: 'tiletext-dim',
      s10: 'tile tile-dim', s10t: '', s10c: 'tiletext-dim',
      s11: 'tile tile-dim', s11t: '', s11c: 'tiletext-dim',

      aiTimer: null
    },

    onInit() {
      device.getInfo({
        success: (ret) => {
          const w = ret && ret.screenWidth;
          if (typeof w === 'number' && w > 0) this.listW = w - 24;
        },
        fail: () => {
          this.listW = 320;
        }
      });
    },

    onHide() {
      this.clearAi();
    },

    onDestroy() {
      this.clearAi();
    },

    onBackPress() {
      return this.stage === 'play';
    },

    startAi() {
      this.startGame('ai');
    },

    startHotseat() {
      this.startGame('hotseat');
    },

    startGame(mode) {
      this.clearAi();
      this.mode = mode || this.mode;
      const d = deal();
      this.hands = [d.hands[0].slice(), d.hands[1].slice(), d.hands[2].slice()];
      this.names = defaultNames(3);
      this.colors = [colorOf(0), colorOf(1), colorOf(2)];
      this.bottom = d.bottom.slice();
      this.landlord = d.landlord;
      this.hands[d.landlord] = this.hands[d.landlord].concat(d.bottom);
      this.cur = d.landlord;
      this.pending = null;
      this.passStreak = 0;
      this.over = false;
      this.sel = [];
      this.page = 0;
      this.viewer = d.landlord;
      this.cover = this.mode === 'hotseat';
      this.coverText = '轮到 ' + (d.landlord + 1) + '号' + (d.landlord === this.landlord ? '（地主）' : '') + ' · 请把表交给 TA';
      this.stage = 'play';
      this.renderAll();
      if (this.mode === 'ai' && this.cur !== 0) this.scheduleAi();
    },

    restart() {
      this.startGame(this.mode);
    },

    revealHand() {
      this.cover = false;
      this.sel = [];
      this.page = 0;
      this.renderHand();
    },

    renderAll() {
      const v = this.viewer;
      this.topLine =
        (this.mode === 'hotseat' ? '' : '你是 1 号') +
        (this.mode === 'hotseat'
          ? (v + 1) + '号' + (v === this.landlord ? '（地主）' : '（农民）')
          : this.landlord === 0 ? '（地主）' : '（农民）') +
        ' · 底牌 ' + this.bottom.map((x) => cardText(x)).join(' ');
      this.botLine =
        this.mode === 'hotseat'
          ? '三家手牌：' + this.hands[0].length + ' / ' + this.hands[1].length + ' / ' + this.hands[2].length
          : 'AI2 剩 ' + this.hands[1].length + ' 张 · AI3 剩 ' + this.hands[2].length + ' 张';
      this.hasPending = !!this.pending;
      this.pendingText = this.pending
        ? this.nm(this.pending.owner) + ' 出了 ' + TYPE_NAME[this.pending.type] +
          '（' + this.pending.cards.map((c) => cardText(c).slice(1)).join(' ') + '）'
        : '新一轮 · 由 ' + this.nm(this.cur) + ' 领出';
      this.nowName = this.nm(this.cur);
      this.nowCls = 'nowchip ' + (this.colors[this.cur] || 'pc-r');
      this.hist = (this.pending ? '上一手：' + TYPE_NAME[this.pending.type] : '') ;
      this.renderHand();
    },

    nm(i) {
      return this.names[i] || (i + 1) + '号';
    },

    renderHand() {
      const hand = this.hands[this.viewer] || [];
      const start = this.page * SLOTS;
      for (let k = 0; k < SLOTS; k++) {
        const idx = start + k;
        const has = idx < hand.length;
        const sel = this.sel.indexOf(idx) >= 0;
        this['s' + k] = !has ? 'tile tile-dim' : sel ? 'tile tile-sel' : 'tile';
        this['s' + k + 't'] = has ? cardText(hand[idx]).slice(1) : '';
        this['s' + k + 'c'] = !has
          ? 'tiletext-dim'
          : hand[idx].suit === 1 || hand[idx].suit === 3
            ? 'tiletext-red'
            : 'tiletext';
      }
      this.pagerOn = hand.length > SLOTS;
    },

    toggleSlot(k) {
      if (this.cover || this.over) return;
      const hand = this.hands[this.viewer];
      const idx = this.page * SLOTS + k;
      if (idx >= hand.length) return;
      const pos = this.sel.indexOf(idx);
      if (pos >= 0) this.sel.splice(pos, 1);
      else this.sel.push(idx);
      this.renderHand();
    },

    pick0() {
      this.toggleSlot(0);
    },
    pick1() {
      this.toggleSlot(1);
    },
    pick2() {
      this.toggleSlot(2);
    },
    pick3() {
      this.toggleSlot(3);
    },
    pick4() {
      this.toggleSlot(4);
    },
    pick5() {
      this.toggleSlot(5);
    },
    pick6() {
      this.toggleSlot(6);
    },
    pick7() {
      this.toggleSlot(7);
    },
    pick8() {
      this.toggleSlot(8);
    },
    pick9() {
      this.toggleSlot(9);
    },
    pick10() {
      this.toggleSlot(10);
    },
    pick11() {
      this.toggleSlot(11);
    },

    pagePrev() {
      const n = Math.max(1, Math.ceil((this.hands[this.viewer] || []).length / SLOTS));
      this.page = (this.page - 1 + n) % n;
      this.sel = [];
      this.renderHand();
    },

    pageNext() {
      const n = Math.max(1, Math.ceil((this.hands[this.viewer] || []).length / SLOTS));
      this.page = (this.page + 1) % n;
      this.sel = [];
      this.renderHand();
    },

    doPlay() {
      if (this.cover || this.over) return;
      if (!this.sel.length) {
        this.hint('先点选要出的牌（可多选）');
        return;
      }
      const hand = this.hands[this.viewer];
      const cards = this.sel.map((i) => hand[i]);
      const parsed = parsePlay(cards);
      if (!parsed.ok) {
        this.hint('牌型不合法');
        return;
      }
      if (!beats(parsed, this.pending)) {
        this.hint('压不过上一手');
        return;
      }
      parsed.owner = this.viewer;
      parsed.cards = cards;
      this.sel.slice().sort((a, b) => b - a).forEach((i) => hand.splice(i, 1));
      this.pending = parsed;
      this.passStreak = 0;
      this.sel = [];
      this.page = 0;
      if (hand.length === 0) {
        this.finish((this.viewer + 1) + '号 出完了！（' + (this.viewer === this.landlord ? '地主' : '农民') + '赢）');
        return;
      }
      this.nextTurn();
    },

    doPass() {
      if (this.cover || this.over || !this.pending) return;
      this.sel = [];
      this.passStreak++;
      if (this.passStreak >= 2) {
        this.pending = null;
        this.passStreak = 0;
      }
      this.nextTurn();
    },

    nextTurn() {
      this.cur = (this.cur + 1) % 3;
      if (this.mode === 'hotseat') {
        this.viewer = this.cur;
        this.sel = [];
        this.page = 0;
        this.cover = true;
        this.coverText =
          '轮到 ' + (this.cur + 1) + '号' + (this.cur === this.landlord ? '（地主）' : '（农民）') + ' · 请把表交给 TA';
        this.renderAll();
        return;
      }
      this.renderAll();
      if (this.cur !== 0) this.scheduleAi();
    },

    scheduleAi() {
      this.clearAi();
      this.aiTimer = setTimeout(() => {
        this.aiTimer = null;
        if (this.over || this.cur === 0 || this.mode !== 'ai') return;
        const hand = this.hands[this.cur];
        const r = findPlay(hand, this.pending);
        if (r.pass) {
          this.passStreak++;
          if (this.passStreak >= 2) {
            this.pending = null;
            this.passStreak = 0;
          }
          this.nextTurn();
          return;
        }
        const cards = r.idx.map((i) => hand[i]);
        const parsed = parsePlay(cards);
        parsed.owner = this.cur;
        parsed.cards = cards;
        r.idx.slice().sort((a, b) => b - a).forEach((i) => hand.splice(i, 1));
        this.pending = parsed;
        this.passStreak = 0;
        if (hand.length === 0) {
          this.finish(this.landlord === this.cur ? '地主赢了！' : '农民赢了！');
          return;
        }
        this.nextTurn();
      }, 620);
    },

    clearAi() {
      if (this.aiTimer) {
        clearTimeout(this.aiTimer);
        this.aiTimer = null;
      }
    },

    finish(text) {
      this.over = true;
      this.overText = text;
      this.cover = false;
      this.renderAll();
    },

    onBack() {
      this.clearAi();
      if (this.stage === 'play') {
        this.stage = 'menu';
        this.over = false;
        this.cover = false;
        return;
      }
      router.back();
    },

    goRules() {
      router.push({ uri: '/pages/rules' });
    },

    hint(msg) {
      prompt.showToast({ message: msg, duration: 1200 });
    }
  };
</script>