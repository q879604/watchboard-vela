<template>
  <div class="page">
    <div class="header">
      <div class="back" onclick="onBack">
        <text class="back-text">&lt;</text>
      </div>
      <text class="header-title">斗地主</text>
    </div>

    <div class="screen" if="{{ stage === 'menu' }}">
      <div class="grow"></div>
      <div class="list" style="width: {{ listW }}px;">
        <div class="card" onclick="startGame">
          <text class="card-text">开始对局（你 + 2 AI）</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="goRules">
          <text class="card-text">玩法说明</text>
          <text class="card-arrow">&gt;</text>
        </div>
      </div>
      <div class="grow"></div>
      <text class="hint">你是 1 号位 · 地主随机</text>
    </div>

    <div class="screen" if="{{ stage === 'play' }}">
      <text class="info">{{ topLine }}</text>
      <text class="sub">{{ botLine }}</text>
      <text class="sub">{{ pendingText }}</text>

      <div class="grow"></div>

      <div class="hand">
        <div class="hrow">
          <div class="{{ s0 }}" onclick="pick0">
            <text class="{{ s0c }}">{{ s0t }}</text>
          </div>
          <div class="{{ s1 }}" onclick="pick1">
            <text class="{{ s1c }}">{{ s1t }}</text>
          </div>
          <div class="{{ s2 }}" onclick="pick2">
            <text class="{{ s2c }}">{{ s2t }}</text>
          </div>
          <div class="{{ s3 }}" onclick="pick3">
            <text class="{{ s3c }}">{{ s3t }}</text>
          </div>
          <div class="{{ s4 }}" onclick="pick4">
            <text class="{{ s4c }}">{{ s4t }}</text>
          </div>
          <div class="{{ s5 }}" onclick="pick5">
            <text class="{{ s5c }}">{{ s5t }}</text>
          </div>
        </div>
        <div class="hrow">
          <div class="{{ s6 }}" onclick="pick6">
            <text class="{{ s6c }}">{{ s6t }}</text>
          </div>
          <div class="{{ s7 }}" onclick="pick7">
            <text class="{{ s7c }}">{{ s7t }}</text>
          </div>
          <div class="{{ s8 }}" onclick="pick8">
            <text class="{{ s8c }}">{{ s8t }}</text>
          </div>
          <div class="{{ s9 }}" onclick="pick9">
            <text class="{{ s9c }}">{{ s9t }}</text>
          </div>
          <div class="{{ s10 }}" onclick="pick10">
            <text class="{{ s10c }}">{{ s10t }}</text>
          </div>
          <div class="{{ s11 }}" onclick="pick11">
            <text class="{{ s11c }}">{{ s11t }}</text>
          </div>
        </div>
      </div>

      <div class="ops">
        <div class="btn btn-main" onclick="doPlay" if="{{ myTurn }}">
          <text class="bt bt-main">出牌</text>
        </div>
        <div class="btn" onclick="doPass" if="{{ myTurn && hasPending }}">
          <text class="bt">不出</text>
        </div>
        <div class="btn btn-s" onclick="pagePrev" if="{{ pagerOn }}">
          <text class="bt">◀</text>
        </div>
        <div class="btn btn-s" onclick="pageNext" if="{{ pagerOn }}">
          <text class="bt">▶</text>
        </div>
        <div class="btn btn-main" onclick="goNext" if="{{ myTurn === false }}">
          <text class="bt bt-main">下一步</text>
        </div>
      </div>
    </div>

    <div class="overlay" if="{{ over }}">
      <text class="overtext">{{ overText }}</text>
      <div class="ops">
        <div class="btn btn-main" onclick="startGame">
          <text class="bt bt-main">再来一局</text>
        </div>
        <div class="btn" onclick="onBack">
          <text class="bt">返回</text>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  @import "../../common/theme.css";
</style>

<script>
  import router from '@system.router';
  import device from '@system.device';
  import prompt from '@system.prompt';
  import { deal, cardText, parsePlay, beats, findPlay } from '../../common/doudizhu';

  const SLOTS = 12;

  const TYPE_NAME = {
    single: '单张',
    pair: '对子',
    triple: '三张',
    triple1: '三带一',
    triple2: '三带二',
    straight: '顺子',
    pairrun: '连对',
    bomb: '炸弹',
    rocket: '火箭'
  };

  export default {
    private: {
      stage: 'menu',
      listW: 320,

      game: null,
      hands: [],
      bottom: [],
      landlord: -1,
      cur: 0,
      pending: null,
      passStreak: 0,
      myTurn: false,
      hasPending: false,
      over: false,
      overText: '',

      sel: [],
      page: 0,
      pagerOn: false,
      topLine: '',
      botLine: '',
      pendingText: '',

      s0: 'tile tile-dim', s0t: '', s0c: 'tiletext-dim',
      s1: 'tile tile-dim', s1t: '', s1c: 'tiletext-dim',
      s2: 'tile tile-dim', s2t: '', s2c: 'tiletext-dim',
      s3: 'tile tile-dim', s3t: '', s3c: 'tiletext-dim',
      s4: 'tile tile-dim', s4t: '', s4c: 'tiletext-dim',
      s5: 'tile tile-dim', s5t: '', s5c: 'tiletext-dim',
      s6: 'tile tile-dim', s6t: '', s6c: 'tiletext-dim',
      s7: 'tile tile-dim', s7t: '', s7c: 'tiletext-dim',
      s8: 'tile tile-dim', s8t: '', s8c: 'tiletext-dim',
      s9: 'tile tile-dim', s9t: '', s9c: 'tiletext-dim',
      s10: 'tile tile-dim', s10t: '', s10c: 'tiletext-dim',
      s11: 'tile tile-dim', s11t: '', s11c: 'tiletext-dim',

      aiTimer: null
    },

    onInit() {
      device.getInfo({
        success: (ret) => {
          const w = ret && ret.screenWidth;
          if (typeof w === 'number' && w > 0) this.listW = w - 24;
        },
        fail: () => {
          this.listW = 320;
        }
      });
    },

    onHide() {
      this.clearAi();
    },

    onDestroy() {
      this.clearAi();
    },

    onBackPress() {
      return this.stage === 'play';
    },

    startGame() {
      this.clearAi();
      const d = deal();
      this.hands = [d.hands[0].slice(), d.hands[1].slice(), d.hands[2].slice()];
      this.bottom = d.bottom.slice();
      this.landlord = d.landlord;
      this.hands[d.landlord] = this.hands[d.landlord].concat(d.bottom);
      this.cur = d.landlord;
      this.pending = null;
      this.passStreak = 0;
      this.over = false;
      this.sel = [];
      this.page = 0;
      this.stage = 'play';
      this.renderAll();
      if (this.cur !== 0) this.scheduleAi();
    },

    renderAll() {
      const g = this;
      this.topLine =
        '你是 1 号' + (this.landlord === 0 ? '（地主）' : '（农民）') +
        ' · 底牌 ' + this.bottom.map((x) => cardText(x)).join(' ');
      this.botLine =
        'AI2 剩 ' + this.hands[1].length + ' 张 · AI3 剩 ' + this.hands[2].length +
        ' 张 · ' + (this.cur === 0 ? '轮到你' : this.cur + 1 + '号出牌中');
      this.hasPending = !!this.pending;
      if (this.pending) {
        this.pendingText =
          (this.pending.owner + 1) + '号 出了 ' + TYPE_NAME[this.pending.type] +
          '（' + this.pending.cards.map((c) => cardText(c).slice(1)).join(' ') + '）';
      } else {
        this.pendingText = '新一轮 · 由 ' + (this.cur + 1) + '号 领出';
      }
      this.myTurn = this.cur === 0 && !this.over;
      this.renderHand();
    },

    renderHand() {
      const hand = this.hands[0] || [];
      const start = this.page * SLOTS;
      for (let k = 0; k < SLOTS; k++) {
        const idx = start + k;
        const has = idx < hand.length;
        const sel = this.sel.indexOf(idx) >= 0;
        this['s' + k] = !has ? 'tile tile-dim' : sel ? 'tile tile-sel' : 'tile';
        this['s' + k + 't'] = has ? cardText(hand[idx]).slice(1) : '';
        this['s' + k + 'c'] = !has
          ? 'tiletext-dim'
          : hand[idx].suit === 1 || hand[idx].suit === 3
            ? 'tiletext-red'
            : 'tiletext';
      }
      this.pagerOn = hand.length > SLOTS;
    },

    toggleSlot(k) {
      if (!this.myTurn) {
        this.hint('还没轮到你');
        return;
      }
      const hand = this.hands[0];
      const idx = this.page * SLOTS + k;
      if (idx >= hand.length) return;
      const pos = this.sel.indexOf(idx);
      if (pos >= 0) this.sel.splice(pos, 1);
      else this.sel.push(idx);
      this.renderHand();
    },

    pick0() {
      this.toggleSlot(0);
    },
    pick1() {
      this.toggleSlot(1);
    },
    pick2() {
      this.toggleSlot(2);
    },
    pick3() {
      this.toggleSlot(3);
    },
    pick4() {
      this.toggleSlot(4);
    },
    pick5() {
      this.toggleSlot(5);
    },
    pick6() {
      this.toggleSlot(6);
    },
    pick7() {
      this.toggleSlot(7);
    },
    pick8() {
      this.toggleSlot(8);
    },
    pick9() {
      this.toggleSlot(9);
    },
    pick10() {
      this.toggleSlot(10);
    },
    pick11() {
      this.toggleSlot(11);
    },

    pagePrev() {
      const n = Math.max(1, Math.ceil(this.hands[0].length / SLOTS));
      this.page = (this.page - 1 + n) % n;
      this.sel = [];
      this.renderHand();
    },

    pageNext() {
      const n = Math.max(1, Math.ceil(this.hands[0].length / SLOTS));
      this.page = (this.page + 1) % n;
      this.sel = [];
      this.renderHand();
    },

    doPlay() {
      if (!this.myTurn) return;
      if (!this.sel.length) {
        this.hint('先点选要出的牌（可多选）');
        return;
      }
      const cards = this.sel.map((i) => this.hands[0][i]);
      const parsed = parsePlay(cards);
      if (!parsed.ok) {
        this.hint('牌型不合法');
        return;
      }
      if (!beats(parsed, this.pending)) {
        this.hint('压不过上一手');
        return;
      }
      const owner = this.cur;
      this.sel.slice().sort((a, b) => b - a).forEach((i) => this.hands[0].splice(i, 1));
      parsed.owner = owner;
      parsed.cards = cards;
      this.pending = parsed;
      this.passStreak = 0;
      this.sel = [];
      this.page = 0;
      if (this.hands[0].length === 0) {
        this.finish(this.landlord === 0 ? '你赢了！' : '农民赢了！');
        return;
      }
      this.nextTurn();
    },

    doPass() {
      if (!this.myTurn || !this.pending) return;
      this.sel = [];
      this.passStreak++;
      if (this.passStreak >= 2) {
        this.pending = null;
        this.passStreak = 0;
      }
      this.nextTurn();
    },

    nextTurn() {
      this.cur = (this.cur + 1) % 3;
      this.renderAll();
      if (this.cur !== 0) this.scheduleAi();
    },

    goNext() {
      this.clearAi();
      if (!this.over && this.cur !== 0) this.scheduleAi();
    },

    scheduleAi() {
      this.clearAi();
      this.aiTimer = setTimeout(() => {
        this.aiTimer = null;
        if (this.over || this.cur === 0) return;
        const hand = this.hands[this.cur];
        const r = findPlay(hand, this.pending);
        if (r.pass) {
          this.passStreak++;
          if (this.passStreak >= 2) {
            this.pending = null;
            this.passStreak = 0;
          }
          this.nextTurn();
          return;
        }
        const cards = r.idx.map((i) => hand[i]);
        const parsed = parsePlay(cards);
        parsed.owner = this.cur;
        parsed.cards = cards;
        r.idx.slice().sort((a, b) => b - a).forEach((i) => hand.splice(i, 1));
        this.pending = parsed;
        this.passStreak = 0;
        if (hand.length === 0) {
          this.finish(this.landlord === this.cur ? '地主赢了！' : '农民赢了！');
          return;
        }
        this.nextTurn();
      }, 620);
    },

    clearAi() {
      if (this.aiTimer) {
        clearTimeout(this.aiTimer);
        this.aiTimer = null;
      }
    },

    finish(text) {
      this.over = true;
      this.overText = text;
      this.myTurn = false;
      this.renderAll();
    },

    onBack() {
      this.clearAi();
      if (this.stage === 'play') {
        this.stage = 'menu';
        this.over = false;
        return;
      }
      router.back();
    },

    goRules() {
      router.push({ uri: '/pages/rules' });
    },

    hint(msg) {
      prompt.showToast({ message: msg, duration: 1200 });
    }
  };
</script>