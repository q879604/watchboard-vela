<template>
  <div class="page">
    <div class="header">
      <div class="back" onclick="onBack">
        <text class="back-text">&lt;</text>
      </div>
      <text class="header-title">{{ title }}</text>
    </div>

    <!-- 选人数 -->
    <div class="screen" if="{{ stage === 'menu' }}">
      <text class="step">2 ~ 8 人身份局 · 你坐 1 号位</text>
      <div class="countbox" style="width: {{ listW }}px;">
        <div class="cbtn" onclick="minus">
          <text class="ctext">－</text>
        </div>
        <text class="cnum">{{ playerCount }} 人</text>
        <div class="cbtn" onclick="plus">
          <text class="ctext">＋</text>
        </div>
      </div>
      <div class="list" style="width: {{ listW }}px;">
        <div class="card" onclick="startGame">
          <text class="card-text">开始游戏</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="goRules">
          <text class="card-text">玩法说明</text>
          <text class="card-arrow">&gt;</text>
        </div>
      </div>
      <text class="hint">身份按人数自动配比（主公+忠臣+反贼+内奸）</text>
    </div>

    <!-- 对局 -->
    <div class="screen" if="{{ stage === 'play' }}">
      <text class="info">{{ infoLine }}</text>
      <text class="event">{{ eventLine }}</text>

      <div class="hand" style="left: {{ hx }}px; top: {{ hy }}px; width: {{ hw }}px; height: {{ hh }}px;">
        <div
          class="tile {{ $item.selCls }}"
          style="left: {{ $item.x }}px; top: {{ $item.y }}px; width: {{ cw }}px; height: {{ ch }}px;"
          for="{{ handTiles }}"
          tid="i"
        >
          <text class="tiletext {{ $item.selTextCls }}">{{ $item.text }}</text>
        </div>

        <div class="hit" style="left: {{ c0x }}px; top: {{ c0y }}px; width: {{ cw }}px; height: {{ ch }}px;" onclick="pick0"></div>
        <div class="hit" style="left: {{ c1x }}px; top: {{ c1y }}px; width: {{ cw }}px; height: {{ ch }}px;" onclick="pick1"></div>
        <div class="hit" style="left: {{ c2x }}px; top: {{ c2y }}px; width: {{ cw }}px; height: {{ ch }}px;" onclick="pick2"></div>
        <div class="hit" style="left: {{ c3x }}px; top: {{ c3y }}px; width: {{ cw }}px; height: {{ ch }}px;" onclick="pick3"></div>
        <div class="hit" style="left: {{ c4x }}px; top: {{ c4y }}px; width: {{ cw }}px; height: {{ ch }}px;" onclick="pick4"></div>
        <div class="hit" style="left: {{ c5x }}px; top: {{ c5y }}px; width: {{ cw }}px; height: {{ ch }}px;" onclick="pick5"></div>
        <div class="hit" style="left: {{ c6x }}px; top: {{ c6y }}px; width: {{ cw }}px; height: {{ ch }}px;" onclick="pick6"></div>
        <div class="hit" style="left: {{ c7x }}px; top: {{ c7y }}px; width: {{ cw }}px; height: {{ ch }}px;" onclick="pick7"></div>
        <div class="hit" style="left: {{ c8x }}px; top: {{ c8y }}px; width: {{ cw }}px; height: {{ ch }}px;" onclick="pick8"></div>
        <div class="hit" style="left: {{ c9x }}px; top: {{ c9y }}px; width: {{ cw }}px; height: {{ ch }}px;" onclick="pick9"></div>
        <div class="hit" style="left: {{ c10x }}px; top: {{ c10y }}px; width: {{ cw }}px; height: {{ ch }}px;" onclick="pick10"></div>
        <div class="hit" style="left: {{ c11x }}px; top: {{ c11y }}px; width: {{ cw }}px; height: {{ ch }}px;" onclick="pick11"></div>
      </div>

      <div class="ops" style="top: {{ opsY }}px;">
        <div class="btn btn-main" onclick="doPlay" if="{{ myTurn && pendingNone }}">
          <text class="bt bt-main">出牌</text>
        </div>
        <div class="btn" onclick="endPlay" if="{{ myTurn && pendingNone }}">
          <text class="bt">结束出牌</text>
        </div>
        <div class="btn btn-main" onclick="aiStep" if="{{ myTurn === false && pendingNone }}">
          <text class="bt bt-main">下一步</text>
        </div>
      </div>

      <!-- 选目标（原生点击，8 格） -->
      <div class="overlay" if="{{ pickTarget }}">
        <text class="overtext">{{ pickText }}</text>
        <div class="chipwrap">
          <div class="chip {{ chip0cls }}" style="left: {{ q0x }}px; top: {{ q0y }}px; width: {{ cw2 }}px; height: {{ ch2 }}px;" onclick="tgt0">
            <text class="chiptext {{ chip0tcls }}">{{ chip0t }}</text>
          </div>
          <div class="chip {{ chip1cls }}" style="left: {{ q1x }}px; top: {{ q1y }}px; width: {{ cw2 }}px; height: {{ ch2 }}px;" onclick="tgt1">
            <text class="chiptext {{ chip1tcls }}">{{ chip1t }}</text>
          </div>
          <div class="chip {{ chip2cls }}" style="left: {{ q2x }}px; top: {{ q2y }}px; width: {{ cw2 }}px; height: {{ ch2 }}px;" onclick="tgt2">
            <text class="chiptext {{ chip2tcls }}">{{ chip2t }}</text>
          </div>
          <div class="chip {{ chip3cls }}" style="left: {{ q3x }}px; top: {{ q3y }}px; width: {{ cw2 }}px; height: {{ ch2 }}px;" onclick="tgt3">
            <text class="chiptext {{ chip3tcls }}">{{ chip3t }}</text>
          </div>
          <div class="chip {{ chip4cls }}" style="left: {{ q4x }}px; top: {{ q4y }}px; width: {{ cw2 }}px; height: {{ ch2 }}px;" onclick="tgt4">
            <text class="chiptext {{ chip4tcls }}">{{ chip4t }}</text>
          </div>
          <div class="chip {{ chip5cls }}" style="left: {{ q5x }}px; top: {{ q5y }}px; width: {{ cw2 }}px; height: {{ ch2 }}px;" onclick="tgt5">
            <text class="chiptext {{ chip5tcls }}">{{ chip5t }}</text>
          </div>
          <div class="chip {{ chip6cls }}" style="left: {{ q6x }}px; top: {{ q6y }}px; width: {{ cw2 }}px; height: {{ ch2 }}px;" onclick="tgt6">
            <text class="chiptext {{ chip6tcls }}">{{ chip6t }}</text>
          </div>
          <div class="chip {{ chip7cls }}" style="left: {{ q7x }}px; top: {{ q7y }}px; width: {{ cw2 }}px; height: {{ ch2 }}px;" onclick="tgt7">
            <text class="chiptext {{ chip7tcls }}">{{ chip7t }}</text>
          </div>
        </div>
        <div class="ops3">
          <div class="btn" onclick="cancelTarget">
            <text class="bt">取消</text>
          </div>
        </div>
      </div>

      <!-- 响应挂起 -->
      <div class="overlay" if="{{ resp }}">
        <text class="overtext">{{ respText }}</text>
        <div class="ops2">
          <div class="btn btn-main" onclick="respYes">
            <text class="bt bt-main">{{ respYesText }}</text>
          </div>
          <div class="btn" onclick="respNo">
            <text class="bt">{{ respNoText }}</text>
          </div>
        </div>
      </div>

      <div class="overlay" if="{{ over }}">
        <text class="overtext">{{ overText }}</text>
        <div class="ops2">
          <div class="btn" onclick="startGame">
            <text class="bt">再来一局</text>
          </div>
          <div class="btn" onclick="onBack">
            <text class="bt">返回</text>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  @import "../../common/theme.css";

  .screen {
    width: 100%;
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
  }

  .step {
    font-size: 17px;
    font-weight: bold;
    color: #ffffff;
    margin-top: 8px;
    margin-bottom: 10px;
  }

  .info {
    width: 100%;
    font-size: 16px;
    font-weight: bold;
    color: #ffffff;
    text-align: center;
    margin-top: 6px;
  }

  .event {
    width: 100%;
    font-size: 14px;
    color: #eaffea;
    text-align: center;
    margin-top: 3px;
  }

  .countbox {
    height: 60px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(255, 255, 255, 0.94);
    border-radius: 14px;
    padding-left: 10px;
    padding-right: 10px;
    margin-bottom: 12px;
  }

  .cbtn {
    width: 56px;
    height: 44px;
    border-radius: 12px;
    background-color: #17331d;
    justify-content: center;
    align-items: center;
  }

  .ctext {
    font-size: 24px;
    font-weight: bold;
    color: #ffffff;
  }

  .cnum {
    font-size: 26px;
    font-weight: bold;
    color: #17331d;
  }

  .hand {
    position: absolute;
  }

  .tile {
    position: absolute;
    border-radius: 7px;
    background-color: #ffffff;
    justify-content: center;
    align-items: center;
  }

  .tile-sel {
    background-color: #17331d;
  }

  .tiletext {
    font-size: 17px;
    font-weight: bold;
    color: #17331d;
  }

  .tiletext-sel {
    color: #ffffff;
  }

  .hit {
    position: absolute;
    background-color: rgba(0, 0, 0, 0.001);
  }

  .ops {
    position: absolute;
    left: 0;
    width: 100%;
    height: 46px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  .ops2 {
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .ops3 {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: 16px;
  }

  .chipwrap {
    position: relative;
    width: 100%;
    height: 150px;
  }

  .chip {
    position: absolute;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.94);
    justify-content: center;
    align-items: center;
  }

  .chip-sel {
    background-color: #2f9e44;
  }

  .chiptext {
    font-size: 17px;
    font-weight: bold;
    color: #17331d;
  }

  .chip-seltext {
    color: #ffffff;
  }
</style>

<script>
  import router from '@system.router';
  import device from '@system.device';
  import prompt from '@system.prompt';
  import {
    ROLE_NAME,
    CARD_NAME,
    createGame,
    aliveList,
    playCard,
    respond,
    aiTakeTurn,
    endTurn
  } from '../../common/sgs';

  const COLS = 6;
  const ROWS = 2;
  const GAP = 4;
  const OPS_H = 46;
  const TCOLS = 4;

  export default {
    private: {
      stage: 'menu',
      title: '三国杀',
      playerCount: 5,
      listW: 320,

      game: null,
      sel: [],
      page: 0,
      handTiles: [],
      infoLine: '',
      eventLine: '',

      myTurn: false,
      pendingNone: true,
      resp: false,
      respText: '',
      respYesText: '',
      respNoText: '',

      pickTarget: false,
      pickText: '',
      pickCardIdx: -1,
      targetPick: -1,

      over: false,
      overText: '',

      hx: 8,
      hy: 300,
      hw: 320,
      hh: 142,
      cw: 50,
      ch: 67,
      opsY: 430,

      cw2: 74,
      ch2: 56,
      q0x: 0, q0y: 0, q1x: 0, q1y: 0, q2x: 0, q2y: 0, q3x: 0, q3y: 0,
      q4x: 0, q4y: 0, q5x: 0, q5y: 0, q6x: 0, q6y: 0, q7x: 0, q7y: 0,
      chip0t: '', chip1t: '', chip2t: '', chip3t: '', chip4t: '', chip5t: '', chip6t: '', chip7t: '',
      chip0cls: 'chip', chip1cls: 'chip', chip2cls: 'chip', chip3cls: 'chip',
      chip4cls: 'chip', chip5cls: 'chip', chip6cls: 'chip', chip7cls: 'chip',
      chip0tcls: '', chip1tcls: '', chip2tcls: '', chip3tcls: '',
      chip4tcls: '', chip5tcls: '', chip6tcls: '', chip7tcls: '',
      chipIds: [-1, -1, -1, -1, -1, -1, -1, -1],

      c0x: 0, c0y: 0, c1x: 0, c1y: 0, c2x: 0, c2y: 0, c3x: 0, c3y: 0,
      c4x: 0, c4y: 0, c5x: 0, c5y: 0, c6x: 0, c6y: 0, c7x: 0, c7y: 0,
      c8x: 0, c8y: 0, c9x: 0, c9y: 0, c10x: 0, c10y: 0, c11x: 0, c11y: 0,

      aiTimer: null
    },

    onInit() {
      device.getInfo({
        success: (ret) => {
          this.applyLayout((ret && ret.screenWidth) || 336, (ret && ret.screenHeight) || 480);
        },
        fail: () => {
          this.applyLayout(336, 480);
        }
      });
    },

    onHide() {
      this.clearAi();
    },

    onDestroy() {
      this.clearAi();
    },

    onBackPress() {
      return this.stage === 'play';
    },

    applyLayout(w, h) {
      const cw = Math.floor((w - 16 - (COLS - 1) * GAP) / COLS);
      const ch = Math.floor(cw * 1.34);
      const hw = COLS * cw + (COLS - 1) * GAP;
      const hx = Math.floor((w - hw) / 2);
      const hh = ROWS * ch + (ROWS - 1) * GAP;
      const opsY = h - OPS_H - 10;
      const hy = opsY - hh - 12;

      this.cw = cw;
      this.ch = ch;
      this.hw = hw;
      this.hx = hx;
      this.hy = hy;
      this.hh = hh;
      this.opsY = opsY;
      this.listW = w - 24;

      const xs = [];
      const ys = [];
      for (let c = 0; c < COLS; c++) xs.push(hx + c * (cw + GAP));
      for (let r = 0; r < ROWS; r++) ys.push(hy + r * (ch + GAP));
      for (let i = 0; i < COLS * ROWS; i++) {
        this['c' + i + 'x'] = xs[i % COLS];
        this['c' + i + 'y'] = ys[Math.floor(i / COLS)];
      }

      // 目标选择 8 格（4 列 × 2 行）
      const cw2 = Math.floor((w - 60) / TCOLS);
      const ch2 = Math.max(48, Math.floor(cw2 * 0.7));
      const gw2 = TCOLS * cw2 + (TCOLS - 1) * 8;
      const gx2 = Math.floor((w - gw2) / 2);
      const gy2 = Math.floor(h / 2) - ch2 - 10;
      this.cw2 = cw2;
      this.ch2 = ch2;
      for (let i = 0; i < 8; i++) {
        this['q' + i + 'x'] = gx2 + (i % TCOLS) * (cw2 + 8);
        this['q' + i + 'y'] = gy2 + Math.floor(i / TCOLS) * (ch2 + 8);
      }
      if (this.game) this.renderHand();
    },

    minus() {
      if (this.playerCount > 2) this.playerCount--;
    },

    plus() {
      if (this.playerCount < 8) this.playerCount++;
    },

    startGame() {
      this.clearAi();
      this.game = createGame(this.playerCount);
      this.sel = [];
      this.page = 0;
      this.over = false;
      this.resp = false;
      this.pickTarget = false;
      this.stage = 'play';
      this.title = '三国杀 · ' + this.playerCount + ' 人';
      this.renderAll();
      this.afterTurn();
    },

    renderAll() {
      const g = this.game;
      if (!g) return;
      const p = g.players[0];
      this.infoLine =
        '你：' + ROLE_NAME[p.role] + ' HP' + p.hp + ' · 手牌' + p.hand.length +
        ' · 现在 ' + (g.current + 1) + '号';
      this.eventLine = g.events[g.events.length - 1] || '';
      this.myTurn = g.current === 0 && g.players[0].alive && !g.winner;
      this.pendingNone = !g.pending;
      this.renderHand();
    },

    renderHand() {
      const g = this.game;
      if (!g) {
        this.handTiles = [];
        return;
      }
      const hand = g.players[0].hand;
      const per = COLS * ROWS;
      const start = this.page * per;
      const tiles = [];
      for (let k = 0; k < per; k++) {
        const idx = start + k;
        if (idx >= hand.length) break;
        const isSel = this.sel.indexOf(idx) >= 0;
        tiles.push({
          i: idx + 1,
          x: (k % COLS) * (this.cw + GAP),
          y: Math.floor(k / COLS) * (this.ch + GAP),
          text: CARD_NAME[hand[idx].t],
          selCls: isSel ? 'tile-sel' : '',
          selTextCls: isSel ? 'tiletext-sel' : ''
        });
      }
      this.handTiles = tiles;
    },

    selectSlot(k) {
      const g = this.game;
      if (!g || !this.myTurn || g.pending) return;
      const idx = this.page * (COLS * ROWS) + k;
      if (idx >= g.players[0].hand.length) return;
      this.sel = [idx];
      this.renderHand();
    },

    pick0() {
      this.selectSlot(0);
    },
    pick1() {
      this.selectSlot(1);
    },
    pick2() {
      this.selectSlot(2);
    },
    pick3() {
      this.selectSlot(3);
    },
    pick4() {
      this.selectSlot(4);
    },
    pick5() {
      this.selectSlot(5);
    },
    pick6() {
      this.selectSlot(6);
    },
    pick7() {
      this.selectSlot(7);
    },
    pick8() {
      this.selectSlot(8);
    },
    pick9() {
      this.selectSlot(9);
    },
    pick10() {
      this.selectSlot(10);
    },
    pick11() {
      this.selectSlot(11);
    },

    doPlay() {
      const g = this.game;
      if (!g || !this.myTurn || g.pending) return;
      if (!this.sel.length) {
        this.hint('先点一张牌');
        return;
      }
      const idx = this.sel[0];
      const card = g.players[0].hand[idx];
      if (card.t === 'sha' || card.t === 'juedou' || card.t === 'chai' || card.t === 'shun') {
        this.pickCardIdx = idx;
        this.pickText = '「' + CARD_NAME[card.t] + '」选目标';
        this.targetPick = -1;
        this.buildTargets();
        this.pickTarget = true;
        return;
      }
      this.commitPlay(idx, -1);
    },

    commitPlay(idx, target) {
      const g = this.game;
      const r = playCard(g, 0, idx, target);
      if (!r.ok) {
        this.hint(r.msg);
        return;
      }
      this.sel = [];
      this.page = 0;
      this.pickTarget = false;
      this.renderAll();
      this.afterTurn();
    },

    endPlay() {
      const g = this.game;
      if (!g || !this.myTurn || g.pending) return;
      this.sel = [];
      endTurn(g);
      this.renderAll();
      this.afterTurn();
    },

    /* ---------------- 目标选择 ---------------- */

    buildTargets() {
      const g = this.game;
      const alive = aliveList(g).filter((x) => x !== 0);
      const ids = [-1, -1, -1, -1, -1, -1, -1, -1];
      for (let k = 0; k < alive.length && k < 8; k++) {
        const id = alive[k];
        ids[k] = id;
        const p = g.players[id];
        this['chip' + k + 't'] = (id + 1) + '号 HP' + p.hp;
        this['chip' + k + 'cls'] = this.targetPick === id ? 'chip chip-sel' : 'chip';
        this['chip' + k + 'tcls'] = this.targetPick === id ? 'chip-seltext' : '';
      }
      for (let k = alive.length; k < 8; k++) {
        this['chip' + k + 't'] = '';
        this['chip' + k + 'cls'] = 'chip';
        this['chip' + k + 'tcls'] = '';
      }
      this.chipIds = ids;
    },

    tapTargetSlot(k) {
      const id = this.chipIds[k];
      if (id == null || id < 0) return;
      this.targetPick = id;
      this.buildTargets();
      // 选好即出（少一步确认）
      this.commitPlay(this.pickCardIdx, this.targetPick);
    },

    tgt0() {
      this.tapTargetSlot(0);
    },
    tgt1() {
      this.tapTargetSlot(1);
    },
    tgt2() {
      this.tapTargetSlot(2);
    },
    tgt3() {
      this.tapTargetSlot(3);
    },
    tgt4() {
      this.tapTargetSlot(4);
    },
    tgt5() {
      this.tapTargetSlot(5);
    },
    tgt6() {
      this.tapTargetSlot(6);
    },
    tgt7() {
      this.tapTargetSlot(7);
    },

    cancelTarget() {
      this.pickTarget = false;
      this.pickCardIdx = -1;
    },

    /* ---------------- 响应 ---------------- */

    afterTurn() {
      const g = this.game;
      if (!g) return;
      if (g.pending) {
        this.showResp();
        return;
      }
      if (g.winner) {
        this.finish();
        return;
      }
      if (g.current === 0) {
        this.renderAll();
        return;
      }
      this.scheduleAi();
    },

    showResp() {
      const g = this.game;
      const pend = g.pending;
      if (!pend) {
        this.resp = false;
        return;
      }
      this.resp = true;
      if (pend.type === 'shan') {
        this.respText = '有人对你出杀！';
        this.respYesText = '出闪';
        this.respNoText = '掉血';
      } else if (pend.type === 'tao') {
        this.respText = '你濒死了！';
        this.respYesText = '吃桃';
        this.respNoText = '不救';
      } else {
        this.respText = '决斗中！出杀吗？';
        this.respYesText = '出杀';
        this.respNoText = '认输';
      }
      this.renderAll();
    },

    respYes() {
      respond(this.game, true);
      this.resp = false;
      this.renderAll();
      this.afterTurn();
    },

    respNo() {
      respond(this.game, false);
      this.resp = false;
      this.renderAll();
      this.afterTurn();
    },

    /* ---------------- AI ---------------- */

    scheduleAi() {
      this.clearAi();
      this.aiTimer = setTimeout(() => {
        this.aiTimer = null;
        const g = this.game;
        if (!g || g.winner) return;
        if (g.pending) {
          this.showResp();
          return;
        }
        if (g.current === 0) {
          this.renderAll();
          return;
        }
        aiTakeTurn(g, g.current);
        this.renderAll();
        if (g.winner) {
          this.finish();
          return;
        }
        if (g.pending) {
          this.showResp();
          return;
        }
        if (g.current !== 0) this.scheduleAi();
      }, 620);
    },

    aiStep() {
      this.clearAi();
      this.scheduleAi();
    },

    clearAi() {
      if (this.aiTimer) {
        clearTimeout(this.aiTimer);
        this.aiTimer = null;
      }
    },

    finish() {
      const g = this.game;
      this.over = true;
      if (g.winner === 'fan') this.overText = '反贼阵营获胜！';
      else if (g.winner === 'nei') this.overText = '内奸获胜！';
      else this.overText = '主公 / 忠臣阵营获胜！';
      this.resp = false;
      this.renderAll();
    },

    onBack() {
      this.clearAi();
      if (this.stage === 'play') {
        this.stage = 'menu';
        this.over = false;
        return;
      }
      router.back();
    },

    goRules() {
      router.push({ uri: '/pages/rules' });
    },

    hint(msg) {
      prompt.showToast({ message: msg, duration: 1200 });
    }
  };
</script>