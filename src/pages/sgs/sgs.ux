<template>
  <div class="page">
    <div class="header">
      <div class="back" onclick="onBack">
        <text class="back-text">&lt;</text>
      </div>
      <text class="header-title">{{ title }}</text>
    </div>

    <!-- 菜单 -->
    <div class="screen" if="{{ stage === 'menu' }}">
      <div class="grow"></div>
      <text class="info">2 ~ 8 人身份局 · 你坐 1 号位</text>
      <div class="countbox" style="width: {{ listW }}px;">
        <div class="cbtn" onclick="minus">
          <text class="ctext">－</text>
        </div>
        <text class="cnum">{{ playerCount }} 人</text>
        <div class="cbtn" onclick="plus">
          <text class="ctext">＋</text>
        </div>
      </div>
      <div class="list" style="width: {{ listW }}px;">
        <div class="card" onclick="startGame">
          <text class="card-text">开始游戏</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="goRules">
          <text class="card-text">玩法说明</text>
          <text class="card-arrow">&gt;</text>
        </div>
      </div>
      <div class="grow"></div>
      <text class="hint">主公+忠臣+反贼+内奸，按人数自动配比</text>
    </div>

    <!-- 对局 -->
    <div class="screen" if="{{ stage === 'play' }}">
      <text class="info">{{ infoLine }}</text>
      <text class="sub">{{ eventLine }}</text>
      <div class="grow"></div>

      <div class="hand">
        <div class="hrow">
          <div class="{{ s0 }}" onclick="pick0">
            <text class="{{ s0c }}">{{ s0t }}</text>
          </div>
          <div class="{{ s1 }}" onclick="pick1">
            <text class="{{ s1c }}">{{ s1t }}</text>
          </div>
          <div class="{{ s2 }}" onclick="pick2">
            <text class="{{ s2c }}">{{ s2t }}</text>
          </div>
          <div class="{{ s3 }}" onclick="pick3">
            <text class="{{ s3c }}">{{ s3t }}</text>
          </div>
          <div class="{{ s4 }}" onclick="pick4">
            <text class="{{ s4c }}">{{ s4t }}</text>
          </div>
          <div class="{{ s5 }}" onclick="pick5">
            <text class="{{ s5c }}">{{ s5t }}</text>
          </div>
        </div>
        <div class="hrow">
          <div class="{{ s6 }}" onclick="pick6">
            <text class="{{ s6c }}">{{ s6t }}</text>
          </div>
          <div class="{{ s7 }}" onclick="pick7">
            <text class="{{ s7c }}">{{ s7t }}</text>
          </div>
          <div class="{{ s8 }}" onclick="pick8">
            <text class="{{ s8c }}">{{ s8t }}</text>
          </div>
          <div class="{{ s9 }}" onclick="pick9">
            <text class="{{ s9c }}">{{ s9t }}</text>
          </div>
          <div class="{{ s10 }}" onclick="pick10">
            <text class="{{ s10c }}">{{ s10t }}</text>
          </div>
          <div class="{{ s11 }}" onclick="pick11">
            <text class="{{ s11c }}">{{ s11t }}</text>
          </div>
        </div>
      </div>

      <div class="ops">
        <div class="btn btn-main" onclick="doPlay" if="{{ myTurn && pendingNone }}">
          <text class="bt bt-main">出牌</text>
        </div>
        <div class="btn" onclick="endPlay" if="{{ myTurn && pendingNone }}">
          <text class="bt">结束</text>
        </div>
        <div class="btn" onclick="pagePrev" if="{{ pagerOn }}">
          <text class="bt">◀</text>
        </div>
        <div class="btn" onclick="pageNext" if="{{ pagerOn }}">
          <text class="bt">▶</text>
        </div>
        <div class="btn btn-main" onclick="aiStep" if="{{ myTurn === false && pendingNone }}">
          <text class="bt bt-main">下一步</text>
        </div>
      </div>
    </div>

    <!-- 选目标（2 行 × 4 格） -->
    <div class="overlay" if="{{ pickTarget }}">
      <text class="overtext">{{ pickText }}</text>
      <div class="slots">
        <div class="srow">
          <div class="{{ t0 }}" onclick="tgt0">
            <text class="{{ t0c }}">{{ t0t }}</text>
          </div>
          <div class="{{ t1 }}" onclick="tgt1">
            <text class="{{ t1c }}">{{ t1t }}</text>
          </div>
          <div class="{{ t2 }}" onclick="tgt2">
            <text class="{{ t2c }}">{{ t2t }}</text>
          </div>
          <div class="{{ t3 }}" onclick="tgt3">
            <text class="{{ t3c }}">{{ t3t }}</text>
          </div>
        </div>
        <div class="srow">
          <div class="{{ t4 }}" onclick="tgt4">
            <text class="{{ t4c }}">{{ t4t }}</text>
          </div>
          <div class="{{ t5 }}" onclick="tgt5">
            <text class="{{ t5c }}">{{ t5t }}</text>
          </div>
          <div class="{{ t6 }}" onclick="tgt6">
            <text class="{{ t6c }}">{{ t6t }}</text>
          </div>
          <div class="{{ t7 }}" onclick="tgt7">
            <text class="{{ t7c }}">{{ t7t }}</text>
          </div>
        </div>
      </div>
      <div class="ops">
        <div class="btn" onclick="cancelTarget">
          <text class="bt">取消</text>
        </div>
      </div>
    </div>

    <!-- 响应 -->
    <div class="overlay" if="{{ resp }}">
      <text class="overtext">{{ respText }}</text>
      <div class="ops">
        <div class="btn btn-main" onclick="respYes">
          <text class="bt bt-main">{{ respYesText }}</text>
        </div>
        <div class="btn" onclick="respNo">
          <text class="bt">{{ respNoText }}</text>
        </div>
      </div>
    </div>

    <!-- 结算 -->
    <div class="overlay" if="{{ over }}">
      <text class="overtext">{{ overText }}</text>
      <div class="ops">
        <div class="btn btn-main" onclick="startGame">
          <text class="bt bt-main">再来一局</text>
        </div>
        <div class="btn" onclick="onBack">
          <text class="bt">返回</text>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  @import "../../common/theme.css";
</style>

<script>
  import router from '@system.router';
  import device from '@system.device';
  import prompt from '@system.prompt';
  import {
    ROLE_NAME,
    CARD_NAME,
    createGame,
    aliveList,
    playCard,
    respond,
    aiTakeTurn,
    endTurn
  } from '../../common/sgs';

  const SLOTS = 12;

  export default {
    private: {
      stage: 'menu',
      title: '三国杀',
      playerCount: 5,
      listW: 320,

      game: null,
      sel: [],
      page: 0,
      pagerOn: false,

      infoLine: '',
      eventLine: '',
      myTurn: false,
      pendingNone: true,

      resp: false,
      respText: '',
      respYesText: '',
      respNoText: '',

      pickTarget: false,
      pickText: '',
      pickCardIdx: -1,

      over: false,
      overText: '',

      // 12 个手牌槽（类名 / 文本 / 文本类名）
      s0: 'tile tile-dim', s0t: '', s0c: 'tiletext-dim',
      s1: 'tile tile-dim', s1t: '', s1c: 'tiletext-dim',
      s2: 'tile tile-dim', s2t: '', s2c: 'tiletext-dim',
      s3: 'tile tile-dim', s3t: '', s3c: 'tiletext-dim',
      s4: 'tile tile-dim', s4t: '', s4c: 'tiletext-dim',
      s5: 'tile tile-dim', s5t: '', s5c: 'tiletext-dim',
      s6: 'tile tile-dim', s6t: '', s6c: 'tiletext-dim',
      s7: 'tile tile-dim', s7t: '', s7c: 'tiletext-dim',
      s8: 'tile tile-dim', s8t: '', s8c: 'tiletext-dim',
      s9: 'tile tile-dim', s9t: '', s9c: 'tiletext-dim',
      s10: 'tile tile-dim', s10t: '', s10c: 'tiletext-dim',
      s11: 'tile tile-dim', s11t: '', s11c: 'tiletext-dim',

      // 8 个目标槽
      t0: 'chip chip-empty', t0t: '', t0c: 'chiptext-dim',
      t1: 'chip chip-empty', t1t: '', t1c: 'chiptext-dim',
      t2: 'chip chip-empty', t2t: '', t2c: 'chiptext-dim',
      t3: 'chip chip-empty', t3t: '', t3c: 'chiptext-dim',
      t4: 'chip chip-empty', t4t: '', t4c: 'chiptext-dim',
      t5: 'chip chip-empty', t5t: '', t5c: 'chiptext-dim',
      t6: 'chip chip-empty', t6t: '', t6c: 'chiptext-dim',
      t7: 'chip chip-empty', t7t: '', t7c: 'chiptext-dim',
      tIds: [-1, -1, -1, -1, -1, -1, -1, -1],

      aiTimer: null
    },

    onInit() {
      device.getInfo({
        success: (ret) => {
          const w = ret && ret.screenWidth;
          if (typeof w === 'number' && w > 0) this.listW = w - 24;
        },
        fail: () => {
          this.listW = 320;
        }
      });
    },

    onHide() {
      this.clearAi();
    },

    onDestroy() {
      this.clearAi();
    },

    onBackPress() {
      return this.stage === 'play';
    },

    minus() {
      if (this.playerCount > 2) this.playerCount--;
    },

    plus() {
      if (this.playerCount < 8) this.playerCount++;
    },

    startGame() {
      this.clearAi();
      this.game = createGame(this.playerCount);
      this.sel = [];
      this.page = 0;
      this.over = false;
      this.resp = false;
      this.pickTarget = false;
      this.stage = 'play';
      this.title = '三国杀 · ' + this.playerCount + ' 人';
      this.renderAll();
      this.afterTurn();
    },

    /* ---------------- 渲染 ---------------- */

    renderAll() {
      const g = this.game;
      if (!g) return;
      const p = g.players[0];
      this.infoLine = '你：' + ROLE_NAME[p.role] + ' · HP ' + p.hp + ' · 手牌 ' + p.hand.length;
      this.eventLine = (g.current + 1) + '号回合 · ' + (g.events[g.events.length - 1] || '');
      this.myTurn = g.current === 0 && g.players[0].alive && !g.winner;
      this.pendingNone = !g.pending;
      this.renderHand();
    },

    renderHand() {
      const g = this.game;
      if (!g) return;
      const hand = g.players[0].hand;
      const start = this.page * SLOTS;
      for (let k = 0; k < SLOTS; k++) {
        const idx = start + k;
        const has = idx < hand.length;
        const sel = this.sel.indexOf(idx) >= 0;
        this['s' + k] = !has ? 'tile tile-dim' : sel ? 'tile tile-sel' : 'tile';
        this['s' + k + 't'] = has ? CARD_NAME[hand[idx].t] : '';
        this['s' + k + 'c'] = !has ? 'tiletext-dim' : 'tiletext';
      }
      this.pagerOn = hand.length > SLOTS;
    },

    selectSlot(k) {
      const g = this.game;
      if (!g || !this.myTurn || g.pending) return;
      const idx = this.page * SLOTS + k;
      const hand = g.players[0].hand;
      if (idx >= hand.length) return;
      this.sel = [idx];
      this.renderHand();
    },

    pick0() {
      this.selectSlot(0);
    },
    pick1() {
      this.selectSlot(1);
    },
    pick2() {
      this.selectSlot(2);
    },
    pick3() {
      this.selectSlot(3);
    },
    pick4() {
      this.selectSlot(4);
    },
    pick5() {
      this.selectSlot(5);
    },
    pick6() {
      this.selectSlot(6);
    },
    pick7() {
      this.selectSlot(7);
    },
    pick8() {
      this.selectSlot(8);
    },
    pick9() {
      this.selectSlot(9);
    },
    pick10() {
      this.selectSlot(10);
    },
    pick11() {
      this.selectSlot(11);
    },

    pagePrev() {
      if (this.page > 0) this.page--;
      else this.page = Math.max(0, Math.ceil(this.game.players[0].hand.length / SLOTS) - 1);
      this.renderHand();
    },

    pageNext() {
      const total = Math.max(1, Math.ceil((this.game ? this.game.players[0].hand.length : 1) / SLOTS));
      this.page = (this.page + 1) % total;
      this.renderHand();
    },

    /* ---------------- 出牌 ---------------- */

    doPlay() {
      const g = this.game;
      if (!g || !this.myTurn || g.pending) return;
      if (!this.sel.length) {
        this.hint('先点一张牌');
        return;
      }
      const idx = this.sel[0];
      const card = g.players[0].hand[idx];
      if (!card) return;
      if (card.t === 'sha' || card.t === 'juedou' || card.t === 'chai' || card.t === 'shun') {
        this.pickCardIdx = idx;
        this.pickText = '「' + CARD_NAME[card.t] + '」选目标';
        this.buildTargets();
        this.pickTarget = true;
        return;
      }
      this.commitPlay(idx, -1);
    },

    commitPlay(idx, target) {
      const g = this.game;
      const r = playCard(g, 0, idx, target);
      if (!r.ok) {
        this.hint(r.msg);
        return;
      }
      this.sel = [];
      this.page = 0;
      this.pickTarget = false;
      this.renderAll();
      this.afterTurn();
    },

    endPlay() {
      const g = this.game;
      if (!g || !this.myTurn || g.pending) return;
      this.sel = [];
      endTurn(g);
      this.renderAll();
      this.afterTurn();
    },

    /* ---------------- 目标选择 ---------------- */

    buildTargets() {
      const g = this.game;
      const alive = aliveList(g).filter((x) => x !== 0);
      const ids = [-1, -1, -1, -1, -1, -1, -1, -1];
      for (let k = 0; k < 8; k++) {
        if (k < alive.length) {
          const id = alive[k];
          ids[k] = id;
          this['t' + k] = 'chip';
          this['t' + k + 't'] = (id + 1) + '号 HP' + g.players[id].hp;
          this['t' + k + 'c'] = 'chiptext';
        } else {
          ids[k] = -1;
          this['t' + k] = 'chip chip-empty';
          this['t' + k + 't'] = '';
          this['t' + k + 'c'] = 'chiptext-dim';
        }
      }
      this.tIds = ids;
    },

    tapTarget(k) {
      const id = this.tIds[k];
      if (id == null || id < 0) return;
      // 直接出牌（少一步确认）
      this.commitPlay(this.pickCardIdx, id);
    },

    tgt0() {
      this.tapTarget(0);
    },
    tgt1() {
      this.tapTarget(1);
    },
    tgt2() {
      this.tapTarget(2);
    },
    tgt3() {
      this.tapTarget(3);
    },
    tgt4() {
      this.tapTarget(4);
    },
    tgt5() {
      this.tapTarget(5);
    },
    tgt6() {
      this.tapTarget(6);
    },
    tgt7() {
      this.tapTarget(7);
    },

    cancelTarget() {
      this.pickTarget = false;
      this.pickCardIdx = -1;
    },

    /* ---------------- 响应 ---------------- */

    afterTurn() {
      const g = this.game;
      if (!g) return;
      if (g.pending) {
        this.showResp();
        return;
      }
      if (g.winner) {
        this.finish();
        return;
      }
      if (g.current === 0) {
        this.renderAll();
        return;
      }
      this.scheduleAi();
    },

    showResp() {
      const g = this.game;
      const pend = g.pending;
      if (!pend) {
        this.resp = false;
        return;
      }
      this.resp = true;
      if (pend.type === 'shan') {
        this.respText = '有人对你出杀！';
        this.respYesText = '出闪';
        this.respNoText = '掉血';
      } else if (pend.type === 'tao') {
        this.respText = '你濒死了！';
        this.respYesText = '吃桃';
        this.respNoText = '不救';
      } else {
        this.respText = '决斗中！出杀吗？';
        this.respYesText = '出杀';
        this.respNoText = '认输';
      }
      this.renderAll();
    },

    respYes() {
      respond(this.game, true);
      this.resp = false;
      this.renderAll();
      this.afterTurn();
    },

    respNo() {
      respond(this.game, false);
      this.resp = false;
      this.renderAll();
      this.afterTurn();
    },

    /* ---------------- AI ---------------- */

    scheduleAi() {
      this.clearAi();
      this.aiTimer = setTimeout(() => {
        this.aiTimer = null;
        const g = this.game;
        if (!g || g.winner) return;
        if (g.pending) {
          this.showResp();
          return;
        }
        if (g.current === 0) {
          this.renderAll();
          return;
        }
        aiTakeTurn(g, g.current);
        this.renderAll();
        if (g.winner) {
          this.finish();
          return;
        }
        if (g.pending) {
          this.showResp();
          return;
        }
        if (g.current !== 0) this.scheduleAi();
      }, 620);
    },

    aiStep() {
      this.clearAi();
      this.scheduleAi();
    },

    clearAi() {
      if (this.aiTimer) {
        clearTimeout(this.aiTimer);
        this.aiTimer = null;
      }
    },

    finish() {
      const g = this.game;
      this.over = true;
      if (g.winner === 'fan') this.overText = '反贼阵营获胜！';
      else if (g.winner === 'nei') this.overText = '内奸获胜！';
      else this.overText = '主公 / 忠臣阵营获胜！';
      this.resp = false;
      this.renderAll();
    },

    onBack() {
      this.clearAi();
      if (this.stage === 'play') {
        this.stage = 'menu';
        this.over = false;
        return;
      }
      router.back();
    },

    goRules() {
      router.push({ uri: '/pages/rules' });
    },

    hint(msg) {
      prompt.showToast({ message: msg, duration: 1200 });
    }
  };
</script>