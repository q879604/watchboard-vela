<template>
  <div class="page">
    <div class="header">
      <div class="back" onclick="onBack">
        <text class="back-text">&lt;</text>
      </div>
      <text class="header-title">骗子酒馆</text>
    </div>

    <!-- 选人数 -->
    <div class="screen" if="{{ stage === 'menu' }}">
      <text class="step">2 ~ 4 人 · 你坐 1 号位</text>
      <div class="countbox" style="width: {{ listW }}px;">
        <div class="cbtn" onclick="minus">
          <text class="ctext">－</text>
        </div>
        <text class="cnum">{{ playerCount }} 人</text>
        <div class="cbtn" onclick="plus">
          <text class="ctext">＋</text>
        </div>
      </div>
      <div class="list" style="width: {{ listW }}px;">
        <div class="card" onclick="startGame">
          <text class="card-text">开始游戏</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="goRules">
          <text class="card-text">玩法说明</text>
          <text class="card-arrow">&gt;</text>
        </div>
      </div>
      <text class="hint">盖牌声称目标点数 · 被人喊中假牌就掉命</text>
    </div>

    <!-- 对局 -->
    <div class="screen" if="{{ stage === 'play' }}">
      <text class="topline">{{ topLine }}</text>
      <text class="midline">{{ midLine }}</text>
      <text class="log">{{ logLine }}</text>

      <div class="hand" style="left: {{ hx }}px; top: {{ hy }}px; width: {{ hw }}px; height: {{ hh }}px;">
        <div
          class="tile {{ $item.selCls }}"
          style="left: {{ $item.x }}px; top: {{ $item.y }}px; width: {{ cw }}px; height: {{ ch }}px;"
          for="{{ handTiles }}"
          tid="i"
        >
          <text class="tiletext {{ $item.cls }} {{ $item.selTextCls }}">{{ $item.text }}</text>
        </div>

        <div class="hit" style="left: {{ c0x }}px; top: {{ c0y }}px; width: {{ cw }}px; height: {{ ch }}px;" onclick="pick0"></div>
        <div class="hit" style="left: {{ c1x }}px; top: {{ c1y }}px; width: {{ cw }}px; height: {{ ch }}px;" onclick="pick1"></div>
        <div class="hit" style="left: {{ c2x }}px; top: {{ c2y }}px; width: {{ cw }}px; height: {{ ch }}px;" onclick="pick2"></div>
        <div class="hit" style="left: {{ c3x }}px; top: {{ c3y }}px; width: {{ cw }}px; height: {{ ch }}px;" onclick="pick3"></div>
        <div class="hit" style="left: {{ c4x }}px; top: {{ c4y }}px; width: {{ cw }}px; height: {{ ch }}px;" onclick="pick4"></div>
        <div class="hit" style="left: {{ c5x }}px; top: {{ c5y }}px; width: {{ cw }}px; height: {{ ch }}px;" onclick="pick5"></div>
        <div class="hit" style="left: {{ c6x }}px; top: {{ c6y }}px; width: {{ cw }}px; height: {{ ch }}px;" onclick="pick6"></div>
        <div class="hit" style="left: {{ c7x }}px; top: {{ c7y }}px; width: {{ cw }}px; height: {{ ch }}px;" onclick="pick7"></div>
        <div class="hit" style="left: {{ c8x }}px; top: {{ c8y }}px; width: {{ cw }}px; height: {{ ch }}px;" onclick="pick8"></div>
        <div class="hit" style="left: {{ c9x }}px; top: {{ c9y }}px; width: {{ cw }}px; height: {{ ch }}px;" onclick="pick9"></div>
        <div class="hit" style="left: {{ c10x }}px; top: {{ c10y }}px; width: {{ cw }}px; height: {{ ch }}px;" onclick="pick10"></div>
        <div class="hit" style="left: {{ c11x }}px; top: {{ c11y }}px; width: {{ cw }}px; height: {{ ch }}px;" onclick="pick11"></div>
      </div>

      <div class="ops" style="top: {{ opsY }}px;">
        <div class="btn btn-main" onclick="doPlay" if="{{ myTurn }}">
          <text class="bt bt-main">出牌</text>
        </div>
        <div class="btn" onclick="doCall" if="{{ canCall }}">
          <text class="bt">喊骗子！</text>
        </div>
        <div class="btn btn-main" onclick="aiStep" if="{{ myTurn === false }}">
          <text class="bt bt-main">下一步</text>
        </div>
      </div>

      <div class="overlay" if="{{ over }}">
        <text class="overtext">{{ overText }}</text>
        <div class="ops2">
          <div class="btn" onclick="startGame">
            <text class="bt">再来一局</text>
          </div>
          <div class="btn" onclick="onBack">
            <text class="bt">返回</text>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  @import "../../common/theme.css";

  .screen {
    width: 100%;
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
  }

  .step {
    font-size: 17px;
    font-weight: bold;
    color: #ffffff;
    margin-top: 8px;
    margin-bottom: 10px;
  }

  .topline {
    width: 100%;
    font-size: 16px;
    font-weight: bold;
    color: #ffffff;
    text-align: center;
    margin-top: 6px;
  }

  .midline {
    width: 100%;
    font-size: 15px;
    color: #eaffea;
    text-align: center;
    margin-top: 4px;
  }

  .log {
    width: 100%;
    font-size: 14px;
    color: #d8f5d8;
    text-align: center;
    margin-top: 3px;
  }

  .countbox {
    height: 60px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(255, 255, 255, 0.94);
    border-radius: 14px;
    padding-left: 10px;
    padding-right: 10px;
    margin-bottom: 12px;
  }

  .cbtn {
    width: 56px;
    height: 44px;
    border-radius: 12px;
    background-color: #17331d;
    justify-content: center;
    align-items: center;
  }

  .ctext {
    font-size: 24px;
    font-weight: bold;
    color: #ffffff;
  }

  .cnum {
    font-size: 26px;
    font-weight: bold;
    color: #17331d;
  }

  .hand {
    position: absolute;
  }

  .tile {
    position: absolute;
    border-radius: 7px;
    background-color: #ffffff;
    justify-content: center;
    align-items: center;
  }

  .tile-sel {
    background-color: #17331d;
  }

  .tiletext {
    font-size: 18px;
    font-weight: bold;
    color: #17331d;
  }

  .tiletext-red {
    color: #d64545;
  }

  .tiletext-sel {
    color: #ffffff;
  }

  .hit {
    position: absolute;
    background-color: rgba(0, 0, 0, 0.001);
  }

  .ops {
    position: absolute;
    left: 0;
    width: 100%;
    height: 46px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  .ops2 {
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }
</style>

<script>
  import router from '@system.router';
  import device from '@system.device';
  import prompt from '@system.prompt';
  import {
    VALUE_CHARS,
    createGame,
    aliveList,
    nextAlive,
    playBatch,
    call,
    passFull,
    allHandsEmpty,
    aiAction
  } from '../../common/liar';

  const COLS = 6;
  const ROWS = 2;
  const GAP = 4;
  const OPS_H = 46;

  export default {
    private: {
      stage: 'menu',
      playerCount: 3,
      listW: 320,

      game: null,
      sel: [],
      page: 0,
      handTiles: [],
      topLine: '',
      midLine: '',
      logLine: '',
      myTurn: false,
      canCall: false,
      over: false,
      overText: '',

      hx: 8,
      hy: 300,
      hw: 320,
      hh: 142,
      cw: 50,
      ch: 67,
      opsY: 430,

      c0x: 0, c0y: 0, c1x: 0, c1y: 0, c2x: 0, c2y: 0, c3x: 0, c3y: 0,
      c4x: 0, c4y: 0, c5x: 0, c5y: 0, c6x: 0, c6y: 0, c7x: 0, c7y: 0,
      c8x: 0, c8y: 0, c9x: 0, c9y: 0, c10x: 0, c10y: 0, c11x: 0, c11y: 0,

      aiTimer: null
    },

    onInit() {
      device.getInfo({
        success: (ret) => {
          this.applyLayout((ret && ret.screenWidth) || 336, (ret && ret.screenHeight) || 480);
        },
        fail: () => {
          this.applyLayout(336, 480);
        }
      });
    },

    onHide() {
      this.clearAi();
    },

    onDestroy() {
      this.clearAi();
    },

    onBackPress() {
      return this.stage === 'play';
    },

    applyLayout(w, h) {
      const cw = Math.floor((w - 16 - (COLS - 1) * GAP) / COLS);
      const ch = Math.floor(cw * 1.34);
      const hw = COLS * cw + (COLS - 1) * GAP;
      const hx = Math.floor((w - hw) / 2);
      const hh = ROWS * ch + (ROWS - 1) * GAP;
      const opsY = h - OPS_H - 10;
      const hy = opsY - hh - 12;

      this.cw = cw;
      this.ch = ch;
      this.hw = hw;
      this.hx = hx;
      this.hy = hy;
      this.hh = hh;
      this.opsY = opsY;
      this.listW = w - 24;

      const xs = [];
      const ys = [];
      for (let c = 0; c < COLS; c++) xs.push(hx + c * (cw + GAP));
      for (let r = 0; r < ROWS; r++) ys.push(hy + r * (ch + GAP));
      for (let i = 0; i < COLS * ROWS; i++) {
        this['c' + i + 'x'] = xs[i % COLS];
        this['c' + i + 'y'] = ys[Math.floor(i / COLS)];
      }
      if (this.game) this.renderHand();
    },

    minus() {
      if (this.playerCount > 2) this.playerCount--;
    },

    plus() {
      if (this.playerCount < 4) this.playerCount++;
    },

    startGame() {
      this.clearAi();
      this.game = createGame(this.playerCount);
      this.sel = [];
      this.page = 0;
      this.over = false;
      this.stage = 'play';
      this.renderAll();
      this.chain();
    },

    renderAll() {
      const g = this.game;
      if (!g) return;
      const p = g.players[0];
      const others = [];
      for (const i of aliveList(g)) {
        if (i === 0) continue;
        others.push((i + 1) + '号♥' + g.players[i].hp);
      }
      this.topLine =
        '第 ' + g.round + ' 轮 · 目标 ' + VALUE_CHARS[g.target] + ' · 你 ♥' + p.hp +
        (others.length ? ' · ' + others.join(' ') : '');
      this.midLine = g.over
        ? this.overText
        : (g.lastPlay
            ? (g.lastPlay.from + 1) + '号 盖了 ' + g.lastPlay.cards.length + ' 张（声称 ' + VALUE_CHARS[g.target] + '）'
            : '由 ' + (g.cur + 1) + '号 开始盖牌') + ' · 轮到 ' + (g.cur + 1) + '号';
      this.logLine = g.log[0] || '';
      this.myTurn = g.cur === 0 && !g.over && g.players[0].alive;
      this.canCall = this.myTurn && !!g.lastPlay && g.lastPlay.from !== 0 && aliveList(g).length > 1;
      this.renderHand();
    },

    renderHand() {
      const g = this.game;
      if (!g) {
        this.handTiles = [];
        return;
      }
      const hand = g.players[0].hand;
      const per = COLS * ROWS;
      const start = this.page * per;
      const tiles = [];
      for (let k = 0; k < per; k++) {
        const idx = start + k;
        if (idx >= hand.length) break;
        const c = hand[idx];
        const isSel = this.sel.indexOf(idx) >= 0;
        tiles.push({
          i: idx + 1,
          x: (k % COLS) * (this.cw + GAP),
          y: Math.floor(k / COLS) * (this.ch + GAP),
          text: VALUE_CHARS[c.v],
          cls: c.suit === 1 || c.suit === 3 ? 'tiletext-red' : '',
          selCls: isSel ? 'tile-sel' : '',
          selTextCls: isSel ? 'tiletext-sel' : ''
        });
      }
      this.handTiles = tiles;
    },

    toggleSlot(k) {
      const g = this.game;
      if (!g || !this.myTurn) {
        this.hint('还没轮到你');
        return;
      }
      const hand = g.players[0].hand;
      const idx = this.page * (COLS * ROWS) + k;
      if (idx >= hand.length) return;
      const pos = this.sel.indexOf(idx);
      if (pos >= 0) this.sel.splice(pos, 1);
      else if (this.sel.length < 3) this.sel.push(idx);
      else this.hint('最多盖 3 张');
      this.renderHand();
    },

    pick0() {
      this.toggleSlot(0);
    },
    pick1() {
      this.toggleSlot(1);
    },
    pick2() {
      this.toggleSlot(2);
    },
    pick3() {
      this.toggleSlot(3);
    },
    pick4() {
      this.toggleSlot(4);
    },
    pick5() {
      this.toggleSlot(5);
    },
    pick6() {
      this.toggleSlot(6);
    },
    pick7() {
      this.toggleSlot(7);
    },
    pick8() {
      this.toggleSlot(8);
    },
    pick9() {
      this.toggleSlot(9);
    },
    pick10() {
      this.toggleSlot(10);
    },
    pick11() {
      this.toggleSlot(11);
    },

    doPlay() {
      const g = this.game;
      if (!g || !this.myTurn) return;
      if (!this.sel.length) {
        this.hint('先选 1~3 张盖牌');
        return;
      }
      const r = playBatch(g, 0, this.sel);
      if (!r.ok) {
        this.hint(r.msg);
        return;
      }
      this.sel = [];
      this.page = 0;
      this.renderAll();
      this.chain();
    },

    doCall() {
      const g = this.game;
      if (!this.canCall) return;
      const r = call(g, 0);
      if (!r.ok) {
        this.hint(r.msg);
        return;
      }
      this.sel = [];
      this.renderAll();
      if (g.over) {
        this.finish();
        return;
      }
      this.chain();
    },

    chain() {
      this.clearAi();
      this.aiTimer = setTimeout(() => {
        this.aiTimer = null;
        const g = this.game;
        if (!g || g.over) return;
        if (g.cur === 0) {
          this.renderAll();
          return;
        }
        const al = aliveList(g);
        if (g.playedCount >= al.length) {
          passFull(g);
          this.renderAll();
          if (g.over) {
            this.finish();
            return;
          }
          this.chain();
          return;
        }
        const a = aiAction(g, g.cur);
        if (a.type === 'pass') {
          if (allHandsEmpty(g)) {
            passFull(g);
            this.renderAll();
            if (!g.over) this.chain();
            return;
          }
          g.cur = nextAlive(g, g.cur);
          this.renderAll();
          this.chain();
          return;
        }
        if (a.type === 'call') {
          call(g, g.cur);
          this.renderAll();
          if (g.over) {
            this.finish();
            return;
          }
          this.chain();
          return;
        }
        const r = playBatch(g, g.cur, a.idx);
        if (!r.ok) {
          this.hint('AI 出牌异常');
          return;
        }
        this.renderAll();
        this.chain();
      }, 620);
    },

    aiStep() {
      this.clearAi();
      this.chain();
    },

    clearAi() {
      if (this.aiTimer) {
        clearTimeout(this.aiTimer);
        this.aiTimer = null;
      }
    },

    finish() {
      const g = this.game;
      this.over = true;
      this.overText = g.winner >= 0 ? (g.winner + 1) + '号 获胜！' : '平局';
      this.renderAll();
    },

    onBack() {
      this.clearAi();
      if (this.stage === 'play') {
        this.stage = 'menu';
        this.over = false;
        return;
      }
      router.back();
    },

    goRules() {
      router.push({ uri: '/pages/rules' });
    },

    hint(msg) {
      prompt.showToast({ message: msg, duration: 1200 });
    }
  };
</script>