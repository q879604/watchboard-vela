<template>
  <div class="page">
    <div class="header">
      <div class="back" onclick="onBack">
        <text class="back-text">&lt;</text>
      </div>
      <text class="header-title">骗子酒馆</text>
    </div>

    <!-- 选人数 -->
    <div class="screen" if="{{ stage === 'menu' }}">
      <text class="step">2 ~ 4 人 · 你坐 1 号位</text>
      <div class="countbox" style="width: {{ listW }}px;">
        <div class="cbtn" onclick="minus">
          <text class="ctext">－</text>
        </div>
        <text class="cnum">{{ playerCount }}</text>
        <div class="cbtn" onclick="plus">
          <text class="ctext">＋</text>
        </div>
      </div>
      <div class="list" style="width: {{ listW }}px;">
        <div class="card" onclick="startGame">
          <text class="card-text">开始游戏</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="goRules">
          <text class="card-text">玩法说明</text>
          <text class="card-arrow">&gt;</text>
        </div>
      </div>
      <text class="hint">盖牌声称目标点数 · 被人喊中假牌就掉命</text>
    </div>

    <!-- 对局 -->
    <div class="screen" if="{{ stage === 'play' }}">
      <text class="topline">{{ topLine }}</text>
      <text class="midline">{{ midLine }}</text>
      <text class="log">{{ logLine }}</text>

      <div class="hand" style="left: {{ hx }}px; top: {{ hy }}px; width: {{ hw }}px; height: {{ hh }}px;" @touchstart="tapHand">
        <div
          class="tile {{ $item.selCls }}"
          style="left: {{ $item.x }}px; top: {{ $item.y }}px; width: {{ cw }}px; height: {{ ch }}px;"
          for="{{ handTiles }}"
          tid="i"
        >
          <text class="tiletext {{ $item.textCls }} {{ $item.selTextCls }}">{{ $item.text }}</text>
        </div>
      </div>

      <div class="ops" style="top: {{ opsY }}px;">
        <div class="btn btn-main" onclick="doPlay" if="{{ myTurn }}">
          <text class="bt bt-main">出牌</text>
        </div>
        <div class="btn" onclick="doCall" if="{{ myTurn && canCall }}">
          <text class="bt">喊骗子！</text>
        </div>
        <div class="btn btn-main" onclick="aiStep" if="{{ myTurn === false }}">
          <text class="bt bt-main">下一步</text>
        </div>
      </div>

      <!-- 结算 -->
      <div class="overlay" if="{{ over }}">
        <text class="overtext">{{ overText }}</text>
        <div class="ops2">
          <div class="btn" onclick="startGame">
            <text class="bt">再来一局</text>
          </div>
          <div class="btn" onclick="onBack">
            <text class="bt">返回</text>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  @import "../../common/theme.css";

  .screen {
    width: 100%;
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
  }

  .step {
    font-size: 17px;
    font-weight: bold;
    color: #ffffff;
    margin-top: 8px;
    margin-bottom: 10px;
  }

  .topline {
    width: 100%;
    font-size: 16px;
    font-weight: bold;
    color: #ffffff;
    text-align: center;
    margin-top: 4px;
  }

  .midline {
    width: 100%;
    font-size: 14px;
    color: #eaffea;
    text-align: center;
    margin-top: 2px;
  }

  .log {
    width: 100%;
    font-size: 13px;
    color: #d8f5d8;
    text-align: center;
    margin-top: 2px;
  }

  .countbox {
    height: 58px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(255, 255, 255, 0.94);
    border-radius: 14px;
    padding-left: 10px;
    padding-right: 10px;
    margin-bottom: 12px;
  }

  .cbtn {
    width: 52px;
    height: 40px;
    border-radius: 12px;
    background-color: #17331d;
    justify-content: center;
    align-items: center;
  }

  .ctext {
    font-size: 22px;
    font-weight: bold;
    color: #ffffff;
  }

  .cnum {
    font-size: 28px;
    font-weight: bold;
    color: #17331d;
  }

  .hand {
    position: absolute;
  }

  .tile {
    position: absolute;
    border-radius: 6px;
    background-color: #ffffff;
    justify-content: center;
    align-items: center;
  }

  .tile-sel {
    background-color: #17331d;
  }

  .tiletext {
    font-size: 15px;
    font-weight: bold;
    color: #17331d;
  }

  .tiletext-red {
    color: #d64545;
  }

  .tiletext-sel {
    color: #ffffff;
  }

  .ops {
    position: absolute;
    left: 0;
    width: 100%;
    height: 34px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  .ops2 {
    flex-direction: row;
    align-items: center;
    justify-content: center;
  }

  .btn {
    width: 84px;
    height: 34px;
    border-radius: 17px;
    background-color: rgba(255, 255, 255, 0.92);
    justify-content: center;
    align-items: center;
    margin-left: 4px;
    margin-right: 4px;
  }

  .btn-main {
    background-color: #17331d;
  }

  .bt {
    font-size: 16px;
    font-weight: bold;
    color: #17331d;
  }

  .bt-main {
    color: #ffffff;
  }

  .overlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.74);
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .overtext {
    font-size: 24px;
    font-weight: bold;
    color: #ffffff;
    margin-bottom: 16px;
  }
</style>

<script>
  import router from '@system.router';
  import device from '@system.device';
  import prompt from '@system.prompt';
  import {
    VALUE_CHARS,
    createGame,
    aliveList,
    nextAlive,
    playBatch,
    call,
    passFull,
    allHandsEmpty,
    aiAction
  } from '../../common/liar';

  const HEADER_H = 46;
  const COLS = 5;
  const TILE_GAP = 3;

  export default {
    private: {
      stage: 'menu',
      playerCount: 3,
      listW: 320,

      game: null,
      sel: [],
      page: 0,
      handTiles: [],
      topLine: '',
      midLine: '',
      logLine: '',
      myTurn: false,
      canCall: false,
      over: false,
      overText: '',

      hx: 8,
      hy: 300,
      hw: 320,
      hh: 126,
      cw: 60,
      ch: 40,
      opsY: 438,

      aiTimer: null
    },

    onInit() {
      device.getInfo({
        success: (ret) => {
          const w = (ret && ret.screenWidth) || 336;
          const h = (ret && ret.screenHeight) || 480;
          this.applyLayout(w, h);
        },
        fail: () => {
          this.applyLayout(336, 480);
        }
      });
    },

    onHide() {
      this.clearAi();
    },

    onDestroy() {
      this.clearAi();
    },

    onBackPress() {
      return this.stage === 'play';
    },

    applyLayout(w, h) {
      const cw = Math.floor((w - 12 - (COLS - 1) * TILE_GAP) / COLS);
      const ch = Math.max(32, Math.floor(cw * 0.66));
      const hw = COLS * cw + (COLS - 1) * TILE_GAP;
      this.cw = cw;
      this.ch = ch;
      this.hw = hw;
      this.hx = Math.floor((w - hw) / 2);
      this.hy = h - 132;
      this.hh = 2 * ch + TILE_GAP;
      this.opsY = this.hy + this.hh + 8;
      this.listW = w - 24;
      if (this.game) this.renderHand();
    },

    minus() {
      if (this.playerCount > 2) this.playerCount--;
    },

    plus() {
      if (this.playerCount < 4) this.playerCount++;
    },

    startGame() {
      this.clearAi();
      this.game = createGame(this.playerCount);
      this.sel = [];
      this.page = 0;
      this.over = false;
      this.stage = 'play';
      this.renderAll();
      this.chain();
    },

    /* ---------------- 渲染 ---------------- */

    renderAll() {
      const s = this.game;
      if (!s) return;
      const p = s.players[0];
      const hpLine = '你 ♥' + p.hp + ' · ';
      const others = [];
      for (const i of aliveList(s)) {
        if (i === 0) continue;
        others.push((i + 1) + '号♥' + s.players[i].hp);
      }
      this.topLine =
        '第 ' + s.round + ' 轮 · 目标点数 ' + VALUE_CHARS[s.target] + ' · ' +
        hpLine + others.join(' ');
      this.midLine =
        s.over ? this.overText :
        (s.lastPlay
          ? (s.lastPlay.from + 1) + '号 盖了 ' + s.lastPlay.cards.length + ' 张（声称是 ' + VALUE_CHARS[s.target] + '）'
          : '由 ' + (s.cur + 1) + '号 开始盖牌') + ' · 轮到 ' + (s.cur + 1) + '号';
      this.logLine = s.log[0] || '';
      this.myTurn = s.cur === 0 && !s.over && s.players[0].alive;
      this.canCall = this.myTurn && !!s.lastPlay && s.lastPlay.from !== 0 && aliveList(s).length > 1;
      this.renderHand();
    },

    renderHand() {
      const s = this.game;
      if (!s) {
        this.handTiles = [];
        return;
      }
      const hand = s.players[0].hand;
      const per = COLS * 2;
      const tiles = [];
      const start = this.page * per;
      for (let k = 0; k < per; k++) {
        const idx = start + k;
        if (idx >= hand.length) break;
        const c = hand[idx];
        const col = k % COLS;
        const row = Math.floor(k / COLS);
        const isSel = this.sel.indexOf(idx) >= 0;
        tiles.push({
          i: idx + 1,
          x: col * (this.cw + TILE_GAP),
          y: row * (this.ch + TILE_GAP),
          text: VALUE_CHARS[c.v],
          cls: c.suit === 1 || c.suit === 3 ? 'tiletext-red' : '',
          selCls: isSel ? 'tile-sel' : '',
          selTextCls: isSel ? 'tiletext-sel' : ''
        });
      }
      this.handTiles = tiles;
    },

    tapHand(evt) {
      if (!this.myTurn) return;
      const pt = this.touchPoint(evt);
      if (!pt) return;
      const stepX = this.cw + TILE_GAP;
      const stepY = this.ch + TILE_GAP;
      let col = Math.floor((pt.x - this.hx) / stepX);
      let row = Math.floor((pt.y - this.hy) / stepY);
      if (!this.inGrid(col, row)) {
        const c2 = Math.floor(pt.x / stepX);
        const r2 = Math.floor(pt.y / stepY);
        if (this.inGrid(c2, r2)) {
          col = c2;
          row = r2;
        }
      }
      if (!this.inGrid(col, row)) return;
      const idx = this.page * COLS * 2 + row * COLS + col;
      if (idx >= this.game.players[0].hand.length) return;
      const pos = this.sel.indexOf(idx);
      if (pos >= 0) this.sel.splice(pos, 1);
      else if (this.sel.length < 3) this.sel.push(idx);
      this.renderHand();
    },

    inGrid(col, row) {
      return col >= 0 && col < COLS && row >= 0 && row < 2;
    },

    /* ---------------- 操作 ---------------- */

    doPlay() {
      const s = this.game;
      if (!this.myTurn) return;
      if (!this.sel.length) {
        this.hint('先选 1~3 张盖牌');
        return;
      }
      if (this.sel.length > 3) {
        this.hint('最多盖 3 张');
        return;
      }
      const r = playBatch(s, 0, this.sel);
      if (!r.ok) {
        this.hint(r.msg);
        return;
      }
      this.sel = [];
      this.page = 0;
      this.renderAll();
      this.chain();
    },

    doCall() {
      const s = this.game;
      if (!this.canCall) return;
      const r = call(s, 0);
      if (!r.ok) {
        this.hint(r.msg);
        return;
      }
      this.sel = [];
      this.renderAll();
      if (s.over) {
        this.finish();
        return;
      }
      this.chain();
    },

    /* ---------------- AI 链 ---------------- */

    chain() {
      this.clearAi();
      this.aiTimer = setTimeout(() => {
        this.aiTimer = null;
        const s = this.game;
        if (!s || s.over) return;
        if (s.cur === 0) {
          this.renderAll();
          return;
        }
        const al = aliveList(s);
        if (s.playedCount >= al.length) {
          passFull(s);
          this.renderAll();
          if (s.over) {
            this.finish();
            return;
          }
          this.chain();
          return;
        }
        const a = aiAction(s, s.cur);
        if (a.type === 'pass') {
          if (allHandsEmpty(s)) {
            passFull(s);
            this.renderAll();
            if (!s.over) this.chain();
            return;
          }
          s.cur = nextAlive(s, s.cur);
          this.renderAll();
          this.chain();
          return;
        }
        if (a.type === 'call') {
          call(s, s.cur);
          this.renderAll();
          if (s.over) {
            this.finish();
            return;
          }
          this.chain();
          return;
        }
        const r = playBatch(s, s.cur, a.idx);
        if (!r.ok) {
          this.hint('AI 出牌异常');
          return;
        }
        this.renderAll();
        this.chain();
      }, 700);
    },

    aiStep() {
      this.clearAi();
      this.chain();
    },

    clearAi() {
      if (this.aiTimer) {
        clearTimeout(this.aiTimer);
        this.aiTimer = null;
      }
    },

    finish() {
      const s = this.game;
      this.over = true;
      this.overText = s.winner >= 0 ? (s.winner + 1) + '号 获胜！' : '平局';
      this.renderAll();
    },

    onBack() {
      this.clearAi();
      if (this.stage === 'play') {
        this.stage = 'menu';
        this.over = false;
        return;
      }
      router.back();
    },

    goRules() {
      router.push({ uri: '/pages/rules' });
    },

    touchPoint(evt) {
      const list = evt && (evt.changedTouches || evt.touches);
      const t = list && list[0];
      if (!t) return null;
      const x = t.clientX != null ? t.clientX : t.pageX != null ? t.pageX : t.screenX;
      const y = t.clientY != null ? t.clientY : t.pageY != null ? t.pageY : t.screenY;
      if (x == null || y == null) return null;
      return { x: x, y: y };
    },

    hint(msg) {
      prompt.showToast({ message: msg, duration: 1200 });
    }
  };
</script>