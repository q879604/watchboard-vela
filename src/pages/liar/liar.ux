<template>
  <div class="page">
    <div class="header">
      <div class="back" onclick="onBack">
        <text class="back-text">&lt;</text>
      </div>
      <text class="header-title">骗子酒馆</text>
    </div>

    <div class="screen" if="{{ stage === 'menu' }}">
      <div class="grow"></div>
      <text class="info">2 ~ 4 人 · 你坐 1 号位</text>
      <div class="countbox" style="width: {{ listW }}px;">
        <div class="cbtn" onclick="minus">
          <text class="ctext">－</text>
        </div>
        <text class="cnum">{{ playerCount }} 人</text>
        <div class="cbtn" onclick="plus">
          <text class="ctext">＋</text>
        </div>
      </div>
      <div class="list" style="width: {{ listW }}px;">
        <div class="card" onclick="startGame">
          <text class="card-text">开始游戏</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="goRules">
          <text class="card-text">玩法说明</text>
          <text class="card-arrow">&gt;</text>
        </div>
      </div>
      <div class="grow"></div>
      <text class="hint">盖牌声称目标点数 · 被喊中假牌就掉命</text>
    </div>

    <div class="screen" if="{{ stage === 'play' }}">
      <text class="info">{{ topLine }}</text>
      <text class="sub">{{ midLine }}</text>
      <text class="sub">{{ logLine }}</text>

      <div class="grow"></div>

      <div class="hand">
        <div class="hrow">
          <div class="{{ s0 }}" onclick="pick0">
            <text class="{{ s0c }}">{{ s0t }}</text>
          </div>
          <div class="{{ s1 }}" onclick="pick1">
            <text class="{{ s1c }}">{{ s1t }}</text>
          </div>
          <div class="{{ s2 }}" onclick="pick2">
            <text class="{{ s2c }}">{{ s2t }}</text>
          </div>
          <div class="{{ s3 }}" onclick="pick3">
            <text class="{{ s3c }}">{{ s3t }}</text>
          </div>
          <div class="{{ s4 }}" onclick="pick4">
            <text class="{{ s4c }}">{{ s4t }}</text>
          </div>
          <div class="{{ s5 }}" onclick="pick5">
            <text class="{{ s5c }}">{{ s5t }}</text>
          </div>
        </div>
        <div class="hrow">
          <div class="{{ s6 }}" onclick="pick6">
            <text class="{{ s6c }}">{{ s6t }}</text>
          </div>
          <div class="{{ s7 }}" onclick="pick7">
            <text class="{{ s7c }}">{{ s7t }}</text>
          </div>
          <div class="{{ s8 }}" onclick="pick8">
            <text class="{{ s8c }}">{{ s8t }}</text>
          </div>
          <div class="{{ s9 }}" onclick="pick9">
            <text class="{{ s9c }}">{{ s9t }}</text>
          </div>
          <div class="{{ s10 }}" onclick="pick10">
            <text class="{{ s10c }}">{{ s10t }}</text>
          </div>
          <div class="{{ s11 }}" onclick="pick11">
            <text class="{{ s11c }}">{{ s11t }}</text>
          </div>
        </div>
      </div>

      <div class="ops">
        <div class="btn btn-main" onclick="doPlay" if="{{ myTurn }}">
          <text class="bt bt-main">盖牌</text>
        </div>
        <div class="btn" onclick="doCall" if="{{ canCall }}">
          <text class="bt">喊骗子</text>
        </div>
        <div class="btn btn-main" onclick="aiStep" if="{{ myTurn === false }}">
          <text class="bt bt-main">下一步</text>
        </div>
      </div>
    </div>

    <div class="overlay" if="{{ over }}">
      <text class="overtext">{{ overText }}</text>
      <div class="ops">
        <div class="btn btn-main" onclick="startGame">
          <text class="bt bt-main">再来一局</text>
        </div>
        <div class="btn" onclick="onBack">
          <text class="bt">返回</text>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  @import "../../common/theme.css";
</style>

<script>
  import router from '@system.router';
  import device from '@system.device';
  import prompt from '@system.prompt';
  import {
    VALUE_CHARS,
    createGame,
    aliveList,
    nextAlive,
    playBatch,
    call,
    passFull,
    allHandsEmpty,
    aiAction
  } from '../../common/liar';

  const SLOTS = 12;

  export default {
    private: {
      stage: 'menu',
      playerCount: 3,
      listW: 320,

      game: null,
      sel: [],
      page: 0,
      topLine: '',
      midLine: '',
      logLine: '',
      myTurn: false,
      canCall: false,
      over: false,
      overText: '',

      s0: 'tile tile-dim', s0t: '', s0c: 'tiletext-dim',
      s1: 'tile tile-dim', s1t: '', s1c: 'tiletext-dim',
      s2: 'tile tile-dim', s2t: '', s2c: 'tiletext-dim',
      s3: 'tile tile-dim', s3t: '', s3c: 'tiletext-dim',
      s4: 'tile tile-dim', s4t: '', s4c: 'tiletext-dim',
      s5: 'tile tile-dim', s5t: '', s5c: 'tiletext-dim',
      s6: 'tile tile-dim', s6t: '', s6c: 'tiletext-dim',
      s7: 'tile tile-dim', s7t: '', s7c: 'tiletext-dim',
      s8: 'tile tile-dim', s8t: '', s8c: 'tiletext-dim',
      s9: 'tile tile-dim', s9t: '', s9c: 'tiletext-dim',
      s10: 'tile tile-dim', s10t: '', s10c: 'tiletext-dim',
      s11: 'tile tile-dim', s11t: '', s11c: 'tiletext-dim',

      aiTimer: null
    },

    onInit() {
      device.getInfo({
        success: (ret) => {
          const w = ret && ret.screenWidth;
          if (typeof w === 'number' && w > 0) this.listW = w - 24;
        },
        fail: () => {
          this.listW = 320;
        }
      });
    },

    onHide() {
      this.clearAi();
    },

    onDestroy() {
      this.clearAi();
    },

    onBackPress() {
      return this.stage === 'play';
    },

    minus() {
      if (this.playerCount > 2) this.playerCount--;
    },

    plus() {
      if (this.playerCount < 4) this.playerCount++;
    },

    startGame() {
      this.clearAi();
      this.game = createGame(this.playerCount);
      this.sel = [];
      this.page = 0;
      this.over = false;
      this.stage = 'play';
      this.renderAll();
      this.chain();
    },

    renderAll() {
      const g = this.game;
      if (!g) return;
      const p = g.players[0];
      const others = [];
      for (const i of aliveList(g)) {
        if (i === 0) continue;
        others.push((i + 1) + '号 ♥' + g.players[i].hp);
      }
      this.topLine =
        '第 ' + g.round + ' 轮 · 目标 ' + VALUE_CHARS[g.target] + ' · 你 ♥' + p.hp +
        (others.length ? ' · ' + others.join(' ') : '');
      this.midLine = g.over
        ? this.overText
        : (g.lastPlay
            ? (g.lastPlay.from + 1) + '号 盖了 ' + g.lastPlay.cards.length + ' 张'
            : '由 ' + (g.cur + 1) + '号 开始') + ' · 轮到 ' + (g.cur + 1) + '号';
      this.logLine = g.log[0] || '';
      this.myTurn = g.cur === 0 && !g.over && g.players[0].alive;
      this.canCall = this.myTurn && !!g.lastPlay && g.lastPlay.from !== 0 && aliveList(g).length > 1;
      this.renderHand();
    },

    renderHand() {
      const g = this.game;
      if (!g) return;
      const hand = g.players[0].hand;
      const start = this.page * SLOTS;
      for (let k = 0; k < SLOTS; k++) {
        const idx = start + k;
        const has = idx < hand.length;
        const sel = this.sel.indexOf(idx) >= 0;
        this['s' + k] = !has ? 'tile tile-dim' : sel ? 'tile tile-sel' : 'tile';
        this['s' + k + 't'] = has ? VALUE_CHARS[hand[idx].v] : '';
        this['s' + k + 'c'] = !has
          ? 'tiletext-dim'
          : hand[idx].suit === 1 || hand[idx].suit === 3
            ? 'tiletext-red'
            : 'tiletext';
      }
      this.pagerOn = hand.length > SLOTS;
    },

    toggleSlot(k) {
      const g = this.game;
      if (!g || !this.myTurn) {
        this.hint('还没轮到你');
        return;
      }
      const hand = g.players[0].hand;
      const idx = this.page * SLOTS + k;
      if (idx >= hand.length) return;
      const pos = this.sel.indexOf(idx);
      if (pos >= 0) this.sel.splice(pos, 1);
      else if (this.sel.length < 3) this.sel.push(idx);
      else this.hint('最多盖 3 张');
      this.renderHand();
    },

    pick0() {
      this.toggleSlot(0);
    },
    pick1() {
      this.toggleSlot(1);
    },
    pick2() {
      this.toggleSlot(2);
    },
    pick3() {
      this.toggleSlot(3);
    },
    pick4() {
      this.toggleSlot(4);
    },
    pick5() {
      this.toggleSlot(5);
    },
    pick6() {
      this.toggleSlot(6);
    },
    pick7() {
      this.toggleSlot(7);
    },
    pick8() {
      this.toggleSlot(8);
    },
    pick9() {
      this.toggleSlot(9);
    },
    pick10() {
      this.toggleSlot(10);
    },
    pick11() {
      this.toggleSlot(11);
    },

    doPlay() {
      const g = this.game;
      if (!g || !this.myTurn) return;
      if (!this.sel.length) {
        this.hint('先选 1~3 张盖牌');
        return;
      }
      const r = playBatch(g, 0, this.sel);
      if (!r.ok) {
        this.hint(r.msg);
        return;
      }
      this.sel = [];
      this.page = 0;
      this.renderAll();
      this.chain();
    },

    doCall() {
      const g = this.game;
      if (!this.canCall) return;
      const r = call(g, 0);
      if (!r.ok) {
        this.hint(r.msg);
        return;
      }
      this.sel = [];
      this.renderAll();
      if (g.over) {
        this.finish();
        return;
      }
      this.chain();
    },

    chain() {
      this.clearAi();
      this.aiTimer = setTimeout(() => {
        this.aiTimer = null;
        const g = this.game;
        if (!g || g.over) return;
        if (g.cur === 0) {
          this.renderAll();
          return;
        }
        const al = aliveList(g);
        if (g.playedCount >= al.length) {
          passFull(g);
          this.renderAll();
          if (g.over) {
            this.finish();
            return;
          }
          this.chain();
          return;
        }
        const a = aiAction(g, g.cur);
        if (a.type === 'pass') {
          if (allHandsEmpty(g)) {
            passFull(g);
            this.renderAll();
            if (!g.over) this.chain();
            return;
          }
          g.cur = nextAlive(g, g.cur);
          this.renderAll();
          this.chain();
          return;
        }
        if (a.type === 'call') {
          call(g, g.cur);
          this.renderAll();
          if (g.over) {
            this.finish();
            return;
          }
          this.chain();
          return;
        }
        const r = playBatch(g, g.cur, a.idx);
        if (!r.ok) {
          this.hint('AI 出牌异常');
          return;
        }
        this.renderAll();
        this.chain();
      }, 620);
    },

    aiStep() {
      this.clearAi();
      this.chain();
    },

    clearAi() {
      if (this.aiTimer) {
        clearTimeout(this.aiTimer);
        this.aiTimer = null;
      }
    },

    finish() {
      const g = this.game;
      this.over = true;
      this.overText = g.winner >= 0 ? (g.winner + 1) + '号 获胜！' : '平局';
      this.renderAll();
    },

    onBack() {
      this.clearAi();
      if (this.stage === 'play') {
        this.stage = 'menu';
        this.over = false;
        return;
      }
      router.back();
    },

    goRules() {
      router.push({ uri: '/pages/rules' });
    },

    hint(msg) {
      prompt.showToast({ message: msg, duration: 1200 });
    }
  };
</script>