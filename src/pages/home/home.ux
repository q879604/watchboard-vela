<template>
  <div class="page">
    <div class="header">
      <text class="header-title">环上桌游</text>
    </div>

    <scroll class="body" scroll-y="true">
      <div class="list" style="width: {{ listW }}px;">
        <div class="card" onclick="openGomoku">
          <text class="card-text">五子棋</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="openMonopoly">
          <text class="card-text">大富翁</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="openWerewolf">
          <text class="card-text">狼人杀</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="openPoker">
          <text class="card-text">扑克牌类</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="openWhois">
          <text class="card-text">谁是卧底</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="openSgs">
          <text class="card-text">三国杀</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="openUno">
          <text class="card-text">UNO</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="openRules">
          <text class="card-text">规则</text>
          <text class="card-arrow">&gt;</text>
        </div>
        <div class="card" onclick="openAbout">
          <text class="card-text">关于</text>
          <text class="card-arrow">&gt;</text>
        </div>
      </div>
      <text class="hint">七大桌游已全部可玩 · 全部纯本地运行</text>
    </scroll>
  </div>
</template>

<style>
  @import "../../common/theme.css";

  .body {
    width: 100%;
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
  }
</style>

<script>
  import router from '@system.router';
  import device from '@system.device';

  export default {
    private: {
      listW: 320
    },

    onInit() {
      device.getInfo({
        success: (ret) => {
          const w = ret && ret.screenWidth;
          if (typeof w === 'number' && w > 0) this.listW = w - 24;
        },
        fail: () => {
          this.listW = 320;
        }
      });
    },

    openGomoku() {
      router.push({ uri: '/pages/gomoku' });
    },
    openMonopoly() {
      router.push({ uri: '/pages/monopoly' });
    },
    openWerewolf() {
      router.push({ uri: '/pages/werewolf' });
    },
    openPoker() {
      router.push({ uri: '/pages/poker' });
    },
    openWhois() {
      router.push({ uri: '/pages/whois' });
    },
    openSgs() {
      router.push({ uri: '/pages/sgs' });
    },
    openUno() {
      router.push({ uri: '/pages/uno' });
    },
    openRules() {
      router.push({ uri: '/pages/rules' });
    },
    openAbout() {
      router.push({ uri: '/pages/about' });
    }
  };
</script>